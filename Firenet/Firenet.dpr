{$R *.res}
var
  //FS: TFormatSettings;
  AtualizarSistema: String;
  Atualizador: String;
  LocalAtualizacoes: String;

procedure LerParametrosIni(var AtualizarSistema: String; var LocalAtualizacoes: String; var Atualizador: String);
var F: TIniFile;
begin
  F:=TIniFile.Create(ExtractFilePath(Application.ExeName)+'Parametros.ini');
  Atualizador      :=F.ReadString('ATUALIZACOES','Atualizador',Atualizador);
  AtualizarSistema :=F.ReadString('ATUALIZACOES','Atualizar',AtualizarSistema);
  LocalAtualizacoes:=F.ReadString('ATUALIZACOES','LocalAtualizacoes',LocalAtualizacoes);
  F.Free;
end;

begin
  Application.Initialize;
  Application.Title:='Firenet';
  //VirtualUI_AutoRun,

  {$REGION 'Arquivo de Parametros e Atualizacao do executável.'}
  if not FileExists(ExtractFilePath(Application.ExeName)+ParamFile) then
  raise Exception.CreateFmt('Arquivo "%s" não encontrado!'#13#13+'Contate seu suporte técnico.',[ParamFile]);

  LerParametrosIni(AtualizarSistema,LocalAtualizacoes,Atualizador);

  if AtualizarSistema='S' then
  begin
    ChecarNovosUpdates(Application.ExeName,LocalAtualizacoes+ExtractFileName(Application.ExeName),Atualizador);
  end;
  {$ENDREGION}

  Application.CreateForm(TDM, DM);
  try

    {$REGION 'Login no sistema.'}
    Application.CreateForm(TFormLogin, FormLogin);
    try
      FormLogin.ShowModal;
      if not FormLogin.LoginOK then
      Exit;
    finally
      FreeAndNil(FormLogin);
    end;
    {$ENDREGION}

    {$REGION 'Verificações'}
    ChecarArquivos;
    ChecarVersaoBase; //Verifica se o executável é compativel com a base de dados. Util quando a atualizacao automatica tá desabilitada.
    ChecarHash;
    ChecarValidade;
    ChecarLimiteUsuarios;
    SetDataUltimaUtilizacao;
    ChecarBaseSomenteLeitura;
    {$ENDREGION}

    {$REGION 'Cupom Fiscal - Frente de Caixa.'}
    if SameText(ParamStr(1),'CUPOM') then
    begin
      Application.CreateForm(TFormNfceCaixa, FormNfceCaixa);
      try
        FormNfceCaixa.ShowModal;
      finally
        FreeAndNil(FormNfceCaixa);
      end;
      Exit;
    end;
    {$ENDREGION}

    Application.CreateForm(TFormMain, FormMain);
    FormMain.ConfigurarModulos(FormMain); //desabilita os modulos que o cliente não deve ter acesso.
    FormMain.DesabilitarControles(FormMain);
    FormMain.EsconderBotoes; //esconde os botoes conforme parametros.ini.
    FormMain.StatusBar1.Panels[0].Text:='Usuario: '+DM.UsuarioLogin;

    Application.Run;
  finally
    FreeAndNil(DM);
  end;
end.
