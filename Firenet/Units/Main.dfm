    Transaction = TRMetas
    SQL.Strings = (
      'select first(1)'
      'MET_DTFIM,'
      'MET_DTINICIO,'
      'MET_METAATINGIDA,'
      'MET_METAVALOR,'
      'MET_VENDEDOR'
      'from METAS'
      'where '
