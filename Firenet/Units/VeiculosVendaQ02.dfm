  object FDQuery1: TFDQuery
    Connection = DM.FDConnection1
    Transaction = FDTransaction1
    SQL.Strings = (
      'select '
      'VEV_VENDEDOR,'
      'VEV_ANOFAB,'
      'VEV_ANOMOD,'
      'VEV_PLACA,'
      'VEV_DTVENDA,'
      'VEV_VALORVENDIDO,'
      'VEL_DESCRICAO,'
      'CLI_NOME,'
      'VEN_NOME,'
      'VEV_VALORVENDIDO - (VEV_VALORCOMPRA+VEV_DESPESAS) as LUCRO'
      'from VEICULOSVENDA'
      'left join VEICULOS on VEV_VEICULO=VEL_CODIGO'
      'left join CLIENTES on VEV_CLIENTE=CLI_CODIGO'
      'left join VENDEDORES on VEV_VENDEDOR=VEN_CODIGO'
      'where VEV_DTVENDA between :datainicial and :datafinal and'
      'VEV_STATUS='#39'V'#39
      'order by VEN_NOME, VEV_DTVENDA desc'
      '')
    Left = 248
    Top = 280
    ParamData = <
      item
        Name = 'DATAINICIAL'
        DataType = ftDate
        ParamType = ptInput
      end
      item
        Name = 'DATAFINAL'
        DataType = ftDate
        ParamType = ptInput
      end>
