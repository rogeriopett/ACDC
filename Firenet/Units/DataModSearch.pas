var
  DMS: TDMS;

implementation
uses DataMod;

{$R *.dfm}

procedure TDMS.DataModuleCreate(Sender: TObject);
begin
  QYProdutos.SQL.Clear;
  QYProdutos.SQL.Add(
    'select PRO_ALIQISS, PRO_CEST, PRO_CLASSFISCAL, PRO_CODIGO, PRO_CODIGOBARRAS, PRO_CODIGOFAB, PRO_COMPOSTO, PRO_ESTOQUEATUAL, '+
    'PRO_LOCALIZACAO, PRO_NBS, PRO_NOME, PRO_PALAVRASCHAVE, PRO_PRECO1, PRO_PRECO2, PRO_PRECO3, PRO_PRECO4, PRO_PRECO5, PRO_PRECO6, PRO_PRECOCUSTO, '+
    'PRO_PRECOVENDA, PRO_PRODUTOREAL, PRO_TIPOISS, PRO_TIPOITEM, PRO_UNIDADE, GRU_DESCRICAO, ISS_DESCRICAO, MAR_DESCRICAO, NBS_DESCRICAO from PRODUTOS '+
    'left join GRUPOS on PRO_GRUPO=GRU_CODIGO '+
    'left join ISS on PRO_TIPOISS=ISS_CODIGO '+
    'left join MARCAS on PRO_MARCA=MAR_CODIGO '+
    'left join NBS on PRO_NBS=NBS_CODIGO '+
    'where PRO_CODIGO=:codigo'
  );
  if DM.TBParametrosPAR_PRODUTOSCODIGOFAB.Value='S' then
  begin
    QYProdutos.SQL.Clear;
    QYProdutos.SQL.Add(
      'select PRO_ALIQISS, PRO_CEST, PRO_CLASSFISCAL, PRO_CODIGO, PRO_CODIGOBARRAS, PRO_CODIGOFAB, PRO_COMPOSTO, PRO_ESTOQUEATUAL, '+
      'PRO_LOCALIZACAO, PRO_NBS, PRO_NOME, PRO_PALAVRASCHAVE, PRO_PRECO1, PRO_PRECO2, PRO_PRECO3, PRO_PRECO4, PRO_PRECO5, PRO_PRECO6, PRO_PRECOCUSTO, '+
      'PRO_PRECOVENDA, PRO_PRODUTOREAL, PRO_TIPOISS, PRO_TIPOITEM, PRO_UNIDADE, GRU_DESCRICAO, ISS_DESCRICAO, MAR_DESCRICAO, NBS_DESCRICAO from PRODUTOS '+
      'left join GRUPOS on PRO_GRUPO=GRU_CODIGO '+
      'left join ISS on PRO_TIPOISS=ISS_CODIGO '+
      'left join MARCAS on PRO_MARCA=MAR_CODIGO '+
      'left join NBS on PRO_NBS=NBS_CODIGO '+
      'where PRO_CODIGO=:codigo or PRO_CODIGOFAB like ''%'' || :codigo || ''%'' '
    );
  end;
end;

end.
