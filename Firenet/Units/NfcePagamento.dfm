  object UPNfce: TFDUpdateSQL
    Connection = DM.FDConnection1
    InsertSQL.Strings = (
      'INSERT INTO NFCE'
      '(NFC_ACREPORC, NFC_ACREVALOR, NFC_ALIQICMSCREDSN, '
      '  NFC_BAIRRO, NFC_BASECOFINS, NFC_BASECOFINSST, '
      '  NFC_BASEICMS, NFC_BASEICMSST, NFC_BASEIPI, '
      '  NFC_BASEPIS, NFC_BASEPISST, NFC_CEP, NFC_CFOP, '
      '  NFC_CHAVEACESSO, NFC_CIDADE, NFC_CIDADECODIGO, '
      '  NFC_CLIENTE, NFC_CNPJ, NFC_CODIGO, NFC_CODIGONFCE, '
      '  NFC_CODIGONUMERICO, NFC_COMISSAO, NFC_COMISSAOPOR, '
      '  NFC_COMPLEMENTO, NFC_CONDICAO, NFC_CONTATO, '
      '  NFC_CONTINGENCIA, NFC_CPF, NFC_CUSTOTOTAL, '
      '  NFC_DESCPORC, NFC_DESCVALOR, NFC_DTATUALIZACAO, '
      '  NFC_DTCADASTRO, NFC_DTEMISSAO, NFC_ENDERECO, '
      '  NFC_ESTADO, NFC_ESTADOCODIGO, NFC_FINALIDADE, '
      '  NFC_FONE1, NFC_FORMAPAGTO, NFC_HRATUALIZACAO, '
      '  NFC_HRCADASTRO, NFC_IE, NFC_INFOADICFISCO, '
      '  NFC_LUCROPORC, NFC_LUCROVALOR, NFC_MODELO, '
      '  NFC_MOTIVOCANCELAMENTO, NFC_MOTIVOINUTILIZACAO, '
      '  NFC_MOVIMENTAESTOQUE, NFC_MOVIMENTAFINANCEIRO, '
      '  NFC_NOME, NFC_NUMERO, NFC_OBSERVACOES, NFC_PESOBRUTO, '
      '  NFC_PESOLIQ, NFC_PROTOCOLO, NFC_PROTOCOLOCANC, '
      '  NFC_PROTOCOLOCANCDH, NFC_PROTOCOLODH, NFC_PROTOCOLOINUT, '
      '  NFC_PROTOCOLOINUTDH, NFC_QRCODE, NFC_SEQUENCIAITEM, '
      '  NFC_SERIE, NFC_STATUS, NFC_TABELAPRECO, NFC_TIPOATENDIMENTO, '
      '  NFC_TIPOCONSUMIDOR, NFC_TIPOEMISSAO, NFC_TIPOOPERACAO, '
      '  NFC_TOTALCOFINS, NFC_TOTALCOFINSST, NFC_TOTALCOMISSAO, '
      '  NFC_TOTALFCP, NFC_TOTALFCPST, NFC_TOTALICMS, '
      '  NFC_TOTALICMSCREDSN, NFC_TOTALICMSST, NFC_TOTALICMSUFDEST, '
      '  NFC_TOTALICMSUFREMET, NFC_TOTALIPI, NFC_TOTALPIS, '
      '  NFC_TOTALPISST, NFC_TOTALPRODUTOS, NFC_TOTALTRIBUTOS, '
      
        '  NFC_TOTALTRIBUTOSEST, NFC_TOTALTRIBUTOSFED, NFC_TOTALTRIBUTOSI' +
        'MP, '
      '  NFC_TOTALTRIBUTOSMUN, NFC_USUARIO, NFC_VALORRECEBIDO, '
      '  NFC_VALORTOTAL, NFC_VALORTROCO, NFC_VENDA, '
      '  NFC_VENDEDOR)'
      
        'VALUES (:NEW_NFC_ACREPORC, :NEW_NFC_ACREVALOR, :NEW_NFC_ALIQICMS' +
        'CREDSN, '
      '  :NEW_NFC_BAIRRO, :NEW_NFC_BASECOFINS, :NEW_NFC_BASECOFINSST, '
      '  :NEW_NFC_BASEICMS, :NEW_NFC_BASEICMSST, :NEW_NFC_BASEIPI, '
      
        '  :NEW_NFC_BASEPIS, :NEW_NFC_BASEPISST, :NEW_NFC_CEP, :NEW_NFC_C' +
        'FOP, '
      '  :NEW_NFC_CHAVEACESSO, :NEW_NFC_CIDADE, :NEW_NFC_CIDADECODIGO, '
      
        '  :NEW_NFC_CLIENTE, :NEW_NFC_CNPJ, gen_id(GEN_NFCE,1), :NEW_NFC_' +
        'CODIGONFCE, '
      
        '  :NEW_NFC_CODIGONUMERICO, :NEW_NFC_COMISSAO, :NEW_NFC_COMISSAOP' +
        'OR, '
      '  :NEW_NFC_COMPLEMENTO, :NEW_NFC_CONDICAO, :NEW_NFC_CONTATO, '
      '  :NEW_NFC_CONTINGENCIA, :NEW_NFC_CPF, :NEW_NFC_CUSTOTOTAL, '
      
        '  :NEW_NFC_DESCPORC, :NEW_NFC_DESCVALOR, :NEW_NFC_DTATUALIZACAO,' +
        ' '
      '  :NEW_NFC_DTCADASTRO, :NEW_NFC_DTEMISSAO, :NEW_NFC_ENDERECO, '
      '  :NEW_NFC_ESTADO, :NEW_NFC_ESTADOCODIGO, :NEW_NFC_FINALIDADE, '
      '  :NEW_NFC_FONE1, :NEW_NFC_FORMAPAGTO, :NEW_NFC_HRATUALIZACAO, '
      '  :NEW_NFC_HRCADASTRO, :NEW_NFC_IE, :NEW_NFC_INFOADICFISCO, '
      '  :NEW_NFC_LUCROPORC, :NEW_NFC_LUCROVALOR, :NEW_NFC_MODELO, '
      '  :NEW_NFC_MOTIVOCANCELAMENTO, :NEW_NFC_MOTIVOINUTILIZACAO, '
      '  :NEW_NFC_MOVIMENTAESTOQUE, :NEW_NFC_MOVIMENTAFINANCEIRO, '
      
        '  :NEW_NFC_NOME, :NEW_NFC_NUMERO, :NEW_NFC_OBSERVACOES, :NEW_NFC' +
        '_PESOBRUTO, '
      '  :NEW_NFC_PESOLIQ, :NEW_NFC_PROTOCOLO, :NEW_NFC_PROTOCOLOCANC, '
      
        '  :NEW_NFC_PROTOCOLOCANCDH, :NEW_NFC_PROTOCOLODH, :NEW_NFC_PROTO' +
        'COLOINUT, '
      
        '  :NEW_NFC_PROTOCOLOINUTDH, :NEW_NFC_QRCODE, :NEW_NFC_SEQUENCIAI' +
        'TEM, '
      
        '  :NEW_NFC_SERIE, :NEW_NFC_STATUS, :NEW_NFC_TABELAPRECO, :NEW_NF' +
        'C_TIPOATENDIMENTO, '
      
        '  :NEW_NFC_TIPOCONSUMIDOR, :NEW_NFC_TIPOEMISSAO, :NEW_NFC_TIPOOP' +
        'ERACAO, '
      
        '  :NEW_NFC_TOTALCOFINS, :NEW_NFC_TOTALCOFINSST, :NEW_NFC_TOTALCO' +
        'MISSAO, '
      '  :NEW_NFC_TOTALFCP, :NEW_NFC_TOTALFCPST, :NEW_NFC_TOTALICMS, '
      
        '  :NEW_NFC_TOTALICMSCREDSN, :NEW_NFC_TOTALICMSST, :NEW_NFC_TOTAL' +
        'ICMSUFDEST, '
      
        '  :NEW_NFC_TOTALICMSUFREMET, :NEW_NFC_TOTALIPI, :NEW_NFC_TOTALPI' +
        'S, '
      
        '  :NEW_NFC_TOTALPISST, :NEW_NFC_TOTALPRODUTOS, :NEW_NFC_TOTALTRI' +
        'BUTOS, '
      
        '  :NEW_NFC_TOTALTRIBUTOSEST, :NEW_NFC_TOTALTRIBUTOSFED, :NEW_NFC' +
        '_TOTALTRIBUTOSIMP, '
      
        '  :NEW_NFC_TOTALTRIBUTOSMUN, :NEW_NFC_USUARIO, :NEW_NFC_VALORREC' +
        'EBIDO, '
      '  :NEW_NFC_VALORTOTAL, :NEW_NFC_VALORTROCO, :NEW_NFC_VENDA, '
      '  :NEW_NFC_VENDEDOR)'
      
        'RETURNING NFC_ACREPORC, NFC_ACREVALOR, NFC_ALIQICMSCREDSN, NFC_B' +
        'AIRRO, NFC_BASECOFINS, NFC_BASECOFINSST, NFC_BASEICMS, NFC_BASEI' +
        'CMSST, NFC_BASEIPI, NFC_BASEPIS, NFC_BASEPISST, NFC_CEP, NFC_CFO' +
        'P, NFC_CHAVEACESSO, NFC_CIDADE, NFC_CIDADECODIGO, NFC_CLIENTE, N' +
        'FC_CNPJ, NFC_CODIGO, NFC_CODIGONFCE, NFC_CODIGONUMERICO, NFC_COM' +
        'ISSAO, NFC_COMISSAOPOR, NFC_COMPLEMENTO, NFC_CONDICAO, NFC_CONTA' +
        'TO, NFC_CONTINGENCIA, NFC_CPF, NFC_CUSTOTOTAL, NFC_DESCPORC, NFC' +
        '_DESCVALOR, NFC_DTATUALIZACAO, NFC_DTCADASTRO, NFC_DTEMISSAO, NF' +
        'C_ENDERECO, NFC_ESTADO, NFC_ESTADOCODIGO, NFC_FINALIDADE, NFC_FO' +
        'NE1, NFC_FORMAPAGTO, NFC_HRATUALIZACAO, NFC_HRCADASTRO, NFC_IE, ' +
        'NFC_INFOADICFISCO, NFC_LUCROPORC, NFC_LUCROVALOR, NFC_MODELO, NF' +
        'C_MOTIVOCANCELAMENTO, NFC_MOTIVOINUTILIZACAO, NFC_MOVIMENTAESTOQ' +
        'UE, NFC_MOVIMENTAFINANCEIRO, NFC_NOME, NFC_NUMERO, NFC_OBSERVACO' +
        'ES, NFC_PESOBRUTO, NFC_PESOLIQ, NFC_PROTOCOLO, NFC_PROTOCOLOCANC' +
        ', NFC_PROTOCOLOCANCDH, NFC_PROTOCOLODH, NFC_PROTOCOLOINUT, NFC_P' +
        'ROTOCOLOINUTDH, NFC_QRCODE, NFC_SEQUENCIAITEM, NFC_SERIE, NFC_ST' +
        'ATUS, NFC_TABELAPRECO, NFC_TIPOATENDIMENTO, NFC_TIPOCONSUMIDOR, ' +
        'NFC_TIPOEMISSAO, NFC_TIPOOPERACAO, NFC_TOTALCOFINS, NFC_TOTALCOF' +
        'INSST, NFC_TOTALCOMISSAO, NFC_TOTALFCP, NFC_TOTALFCPST, NFC_TOTA' +
        'LICMS, NFC_TOTALICMSCREDSN, NFC_TOTALICMSST, NFC_TOTALICMSUFDEST' +
        ', NFC_TOTALICMSUFREMET, NFC_TOTALIPI, NFC_TOTALPIS, NFC_TOTALPIS' +
        'ST, NFC_TOTALPRODUTOS, NFC_TOTALTRIBUTOS, NFC_TOTALTRIBUTOSEST, ' +
        'NFC_TOTALTRIBUTOSFED, NFC_TOTALTRIBUTOSIMP, NFC_TOTALTRIBUTOSMUN' +
        ', NFC_USUARIO, NFC_VALORRECEBIDO, NFC_VALORTOTAL, NFC_VALORTROCO' +
        ', NFC_VENDA, NFC_VENDEDOR')
    ModifySQL.Strings = (
      'UPDATE NFCE'
      
        'SET NFC_ACREPORC = :NEW_NFC_ACREPORC, NFC_ACREVALOR = :NEW_NFC_A' +
        'CREVALOR, '
      
        '  NFC_ALIQICMSCREDSN = :NEW_NFC_ALIQICMSCREDSN, NFC_BAIRRO = :NE' +
        'W_NFC_BAIRRO, '
      
        '  NFC_BASECOFINS = :NEW_NFC_BASECOFINS, NFC_BASECOFINSST = :NEW_' +
        'NFC_BASECOFINSST, '
      
        '  NFC_BASEICMS = :NEW_NFC_BASEICMS, NFC_BASEICMSST = :NEW_NFC_BA' +
        'SEICMSST, '
      
        '  NFC_BASEIPI = :NEW_NFC_BASEIPI, NFC_BASEPIS = :NEW_NFC_BASEPIS' +
        ', '
