  object UPNfcePagamentos: TFDUpdateSQL
    Connection = DM.FDConnection1
    InsertSQL.Strings = (
      'INSERT INTO NFCEPAGAMENTOS'
      '(NCP_CODIGO, NCP_CONDICAO, NCP_NFCE, NCP_VALOR)'
      
        'VALUES (gen_id(GEN_NFCEPAGAMENTOS,1), :NEW_NCP_CONDICAO, :NEW_NC' +
        'P_NFCE, :NEW_NCP_VALOR)'
      'RETURNING NCP_CODIGO, NCP_CONDICAO, NCP_NFCE, NCP_VALOR')
    ModifySQL.Strings = (
      'UPDATE NFCEPAGAMENTOS'
      
        'SET NCP_CODIGO = :NEW_NCP_CODIGO, NCP_CONDICAO = :NEW_NCP_CONDIC' +
        'AO, '
      '  NCP_NFCE = :NEW_NCP_NFCE, NCP_VALOR = :NEW_NCP_VALOR'
      'WHERE NCP_CODIGO = :OLD_NCP_CODIGO'
      'RETURNING NCP_CODIGO, NCP_CONDICAO, NCP_NFCE, NCP_VALOR')
    DeleteSQL.Strings = (
      'DELETE FROM NFCEPAGAMENTOS'
      'WHERE NCP_CODIGO = :OLD_NCP_CODIGO')
    FetchRowSQL.Strings = (
      'SELECT NCP_CODIGO, NCP_CONDICAO, NCP_NFCE, NCP_VALOR'
      'FROM NFCEPAGAMENTOS'
      'WHERE NCP_CODIGO = :OLD_NCP_CODIGO')
    Left = 400
    Top = 304
  end
