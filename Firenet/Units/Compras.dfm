  object UPCompras: TFDUpdateSQL
    Connection = DM.FDConnection1
    InsertSQL.Strings = (
      'INSERT INTO COMPRAS'
      '(COM_ALIQICMSCREDSN, COM_BAIRRO, COM_BAIXADATA, '
      '  COM_BAIXAPOR, COM_BASECOFINS, COM_BASECOFINSST, '
      '  COM_BASEICMS, COM_BASEICMSST, COM_BASEIPI, '
      '  COM_BASEISS, COM_BASEPIS, COM_BASEPISST, '
      '  COM_CALCULARTOTAIS, COM_CEP, COM_CFOP, COM_CFOPDESC, '
      '  COM_CHAVEACESSO, COM_CIDADE, COM_CIDADECODIGO, '
      '  COM_CNPJ, COM_CODIGO, COM_COMPLEMENTO, COM_CONDICAO, '
      '  COM_CONDICAOMEMO, COM_CONTATO, COM_CPF, COM_DESCPORC, '
      '  COM_DESCVALOR, COM_DIAPREFERENCIAL, COM_DTATUALIZACAO, '
      '  COM_DTCADASTRO, COM_DTENTRADA, COM_DTPRESTSERVICO, '
      '  COM_ENDERECO, COM_ENTRADASAIDA, COM_ESPECIE, '
      '  COM_ESTADO, COM_ESTADOCODIGO, COM_FONE1, '
      '  COM_FORMAPAGTO, COM_FORNECEDOR, COM_FRETE, '
      '  COM_HRATUALIZACAO, COM_HRCADASTRO, COM_IE, '
      '  COM_LACRES, COM_MARCA, COM_MODELO, COM_MOVIMENTAESTOQUE, '
      '  COM_MOVIMENTAFINANCEIRO, COM_NOME, COM_NOTADATA, '
      '  COM_NOTANUMERO, COM_NUMERO, COM_OBSERVACOES, '
      '  COM_PESOBRUTO, COM_PESOLIQ, COM_REBOQUEPLACA, '
      '  COM_REBOQUEPLACAUF, COM_REBOQUERNTC, COM_RG, '
      '  COM_SERIE, COM_STATUS, COM_TOTALCOFINS, COM_TOTALCOFINSST, '
      '  COM_TOTALFCP, COM_TOTALICMS, COM_TOTALICMSCREDSN, '
      '  COM_TOTALICMSST, COM_TOTALICMSUFDEST, COM_TOTALICMSUFREMET, '
      '  COM_TOTALIPI, COM_TOTALISS, COM_TOTALISSDEDUCAO, '
      '  COM_TOTALISSDESCCOND, COM_TOTALISSDESCINCOND, '
      '  COM_TOTALISSOUTROS, COM_TOTALISSRETENCAO, COM_TOTALITENS, '
      '  COM_TOTALPIS, COM_TOTALPISST, COM_TOTALPRODUTOS, '
      '  COM_TOTALSERVICOS, COM_TOTALTRIBUTOS, COM_TOTALTRIBUTOSEST, '
      
        '  COM_TOTALTRIBUTOSFED, COM_TOTALTRIBUTOSIMP, COM_TOTALTRIBUTOSM' +
        'UN, '
      '  COM_TRANSPCIDADE, COM_TRANSPCNPJ, COM_TRANSPCPF, '
      '  COM_TRANSPENDERECO, COM_TRANSPESTADO, COM_TRANSPFONE, '
      '  COM_TRANSPIE, COM_TRANSPNOME, COM_TRANSPORTADORA, '
      '  COM_USUARIO, COM_VALORDESPACES, COM_VALORFRETE, '
      '  COM_VALORSEGURO, COM_VALORTOTAL, COM_VEICULOPLACA, '
      '  COM_VEICULOPLACAUF, COM_VEICULORNTC, COM_VOLUMES, '
      '  COM_VOLUMESNUM)'
      
        'VALUES (:NEW_COM_ALIQICMSCREDSN, :NEW_COM_BAIRRO, :NEW_COM_BAIXA' +
        'DATA, '
      
        '  :NEW_COM_BAIXAPOR, :NEW_COM_BASECOFINS, :NEW_COM_BASECOFINSST,' +
        ' '
      '  :NEW_COM_BASEICMS, :NEW_COM_BASEICMSST, :NEW_COM_BASEIPI, '
      '  :NEW_COM_BASEISS, :NEW_COM_BASEPIS, :NEW_COM_BASEPISST, '
      
        '  :NEW_COM_CALCULARTOTAIS, :NEW_COM_CEP, :NEW_COM_CFOP, :NEW_COM' +
        '_CFOPDESC, '
      '  :NEW_COM_CHAVEACESSO, :NEW_COM_CIDADE, :NEW_COM_CIDADECODIGO, '
      
        '  :NEW_COM_CNPJ, gen_id(GEN_COMPRAS,1), :NEW_COM_COMPLEMENTO, :N' +
        'EW_COM_CONDICAO, '
      
        '  :NEW_COM_CONDICAOMEMO, :NEW_COM_CONTATO, :NEW_COM_CPF, :NEW_CO' +
        'M_DESCPORC, '
      
        '  :NEW_COM_DESCVALOR, :NEW_COM_DIAPREFERENCIAL, :NEW_COM_DTATUAL' +
        'IZACAO, '
      
        '  :NEW_COM_DTCADASTRO, :NEW_COM_DTENTRADA, :NEW_COM_DTPRESTSERVI' +
        'CO, '
      '  :NEW_COM_ENDERECO, :NEW_COM_ENTRADASAIDA, :NEW_COM_ESPECIE, '
      '  :NEW_COM_ESTADO, :NEW_COM_ESTADOCODIGO, :NEW_COM_FONE1, '
      '  :NEW_COM_FORMAPAGTO, :NEW_COM_FORNECEDOR, :NEW_COM_FRETE, '
      '  :NEW_COM_HRATUALIZACAO, :NEW_COM_HRCADASTRO, :NEW_COM_IE, '
      
        '  :NEW_COM_LACRES, :NEW_COM_MARCA, :NEW_COM_MODELO, :NEW_COM_MOV' +
        'IMENTAESTOQUE, '
      
        '  :NEW_COM_MOVIMENTAFINANCEIRO, :NEW_COM_NOME, :NEW_COM_NOTADATA' +
        ', '
      '  :NEW_COM_NOTANUMERO, :NEW_COM_NUMERO, :NEW_COM_OBSERVACOES, '
      '  :NEW_COM_PESOBRUTO, :NEW_COM_PESOLIQ, :NEW_COM_REBOQUEPLACA, '
      '  :NEW_COM_REBOQUEPLACAUF, :NEW_COM_REBOQUERNTC, :NEW_COM_RG, '
      
        '  :NEW_COM_SERIE, :NEW_COM_STATUS, :NEW_COM_TOTALCOFINS, :NEW_CO' +
        'M_TOTALCOFINSST, '
      
        '  :NEW_COM_TOTALFCP, :NEW_COM_TOTALICMS, :NEW_COM_TOTALICMSCREDS' +
        'N, '
      
        '  :NEW_COM_TOTALICMSST, :NEW_COM_TOTALICMSUFDEST, :NEW_COM_TOTAL' +
        'ICMSUFREMET, '
      
        '  :NEW_COM_TOTALIPI, :NEW_COM_TOTALISS, :NEW_COM_TOTALISSDEDUCAO' +
        ', '
      '  :NEW_COM_TOTALISSDESCCOND, :NEW_COM_TOTALISSDESCINCOND, '
      
        '  :NEW_COM_TOTALISSOUTROS, :NEW_COM_TOTALISSRETENCAO, :NEW_COM_T' +
        'OTALITENS, '
      
        '  :NEW_COM_TOTALPIS, :NEW_COM_TOTALPISST, :NEW_COM_TOTALPRODUTOS' +
        ', '
      
        '  :NEW_COM_TOTALSERVICOS, :NEW_COM_TOTALTRIBUTOS, :NEW_COM_TOTAL' +
        'TRIBUTOSEST, '
      
        '  :NEW_COM_TOTALTRIBUTOSFED, :NEW_COM_TOTALTRIBUTOSIMP, :NEW_COM' +
        '_TOTALTRIBUTOSMUN, '
      
        '  :NEW_COM_TRANSPCIDADE, :NEW_COM_TRANSPCNPJ, :NEW_COM_TRANSPCPF' +
        ', '
      
        '  :NEW_COM_TRANSPENDERECO, :NEW_COM_TRANSPESTADO, :NEW_COM_TRANS' +
        'PFONE, '
      
        '  :NEW_COM_TRANSPIE, :NEW_COM_TRANSPNOME, :NEW_COM_TRANSPORTADOR' +
        'A, '
      
        '  :NEW_COM_USUARIO, :NEW_COM_VALORDESPACES, :NEW_COM_VALORFRETE,' +
        ' '
      
        '  :NEW_COM_VALORSEGURO, :NEW_COM_VALORTOTAL, :NEW_COM_VEICULOPLA' +
        'CA, '
      
        '  :NEW_COM_VEICULOPLACAUF, :NEW_COM_VEICULORNTC, :NEW_COM_VOLUME' +
        'S, '
      '  :NEW_COM_VOLUMESNUM)'
      
        'RETURNING COM_ALIQICMSCREDSN, COM_BAIRRO, COM_BAIXADATA, COM_BAI' +
        'XAPOR, COM_BASECOFINS, COM_BASECOFINSST, COM_BASEICMS, COM_BASEI' +
        'CMSST, COM_BASEIPI, COM_BASEISS, COM_BASEPIS, COM_BASEPISST, COM' +
        '_CALCULARTOTAIS, COM_CEP, COM_CFOP, COM_CFOPDESC, COM_CHAVEACESS' +
        'O, COM_CIDADE, COM_CIDADECODIGO, COM_CNPJ, COM_CODIGO, COM_COMPL' +
        'EMENTO, COM_CONDICAO, COM_CONDICAOMEMO, COM_CONTATO, COM_CPF, CO' +
        'M_DESCPORC, COM_DESCVALOR, COM_DIAPREFERENCIAL, COM_DTATUALIZACA' +
        'O, COM_DTCADASTRO, COM_DTENTRADA, COM_DTPRESTSERVICO, COM_ENDERE' +
        'CO, COM_ENTRADASAIDA, COM_ESPECIE, COM_ESTADO, COM_ESTADOCODIGO,' +
        ' COM_FONE1, COM_FORMAPAGTO, COM_FORNECEDOR, COM_FRETE, COM_HRATU' +
        'ALIZACAO, COM_HRCADASTRO, COM_IE, COM_LACRES, COM_MARCA, COM_MOD' +
        'ELO, COM_MOVIMENTAESTOQUE, COM_MOVIMENTAFINANCEIRO, COM_NOME, CO' +
        'M_NOTADATA, COM_NOTANUMERO, COM_NUMERO, COM_OBSERVACOES, COM_PES' +
        'OBRUTO, COM_PESOLIQ, COM_REBOQUEPLACA, COM_REBOQUEPLACAUF, COM_R' +
        'EBOQUERNTC, COM_RG, COM_SERIE, COM_STATUS, COM_TOTALCOFINS, COM_' +
        'TOTALCOFINSST, COM_TOTALFCP, COM_TOTALICMS, COM_TOTALICMSCREDSN,' +
        ' COM_TOTALICMSST, COM_TOTALICMSUFDEST, COM_TOTALICMSUFREMET, COM' +
        '_TOTALIPI, COM_TOTALISS, COM_TOTALISSDEDUCAO, COM_TOTALISSDESCCO' +
        'ND, COM_TOTALISSDESCINCOND, COM_TOTALISSOUTROS, COM_TOTALISSRETE' +
        'NCAO, COM_TOTALITENS, COM_TOTALPIS, COM_TOTALPISST, COM_TOTALPRO' +
        'DUTOS, COM_TOTALSERVICOS, COM_TOTALTRIBUTOS, COM_TOTALTRIBUTOSES' +
        'T, COM_TOTALTRIBUTOSFED, COM_TOTALTRIBUTOSIMP, COM_TOTALTRIBUTOS' +
        'MUN, COM_TRANSPCIDADE, COM_TRANSPCNPJ, COM_TRANSPCPF, COM_TRANSP' +
        'ENDERECO, COM_TRANSPESTADO, COM_TRANSPFONE, COM_TRANSPIE, COM_TR' +
        'ANSPNOME, COM_TRANSPORTADORA, COM_USUARIO, COM_VALORDESPACES, CO' +
        'M_VALORFRETE, COM_VALORSEGURO, COM_VALORTOTAL, COM_VEICULOPLACA,' +
        ' COM_VEICULOPLACAUF, COM_VEICULORNTC, COM_VOLUMES, COM_VOLUMESNU' +
        'M')
    ModifySQL.Strings = (
      'UPDATE COMPRAS'
      
        'SET COM_ALIQICMSCREDSN = :NEW_COM_ALIQICMSCREDSN, COM_BAIRRO = :' +
        'NEW_COM_BAIRRO, '
      
        '  COM_BAIXADATA = :NEW_COM_BAIXADATA, COM_BAIXAPOR = :NEW_COM_BA' +
        'IXAPOR, '
      
        '  COM_BASECOFINS = :NEW_COM_BASECOFINS, COM_BASECOFINSST = :NEW_' +
        'COM_BASECOFINSST, '
      
        '  COM_BASEICMS = :NEW_COM_BASEICMS, COM_BASEICMSST = :NEW_COM_BA' +
        'SEICMSST, '
      
        '  COM_BASEIPI = :NEW_COM_BASEIPI, COM_BASEISS = :NEW_COM_BASEISS' +
        ', '
      
        '  COM_BASEPIS = :NEW_COM_BASEPIS, COM_BASEPISST = :NEW_COM_BASEP' +
        'ISST, '
      
        '  COM_CALCULARTOTAIS = :NEW_COM_CALCULARTOTAIS, COM_CEP = :NEW_C' +
        'OM_CEP, '
      '  COM_CFOP = :NEW_COM_CFOP, COM_CFOPDESC = :NEW_COM_CFOPDESC, '
      
