  object QY01: TFDQuery
    Connection = DM.FDConnection1
    Transaction = TR01
    SQL.Strings = (
      'select '
      'CUP_CCF,'
      'CUP_CLIENTE,'
      'CUP_CODIGO,'
      'CUP_COO,'
      'CUP_DESCVALOR,'
      'CUP_DTEMISSAO,'
      'CUP_ECF,'
      'CUP_STATUS,'
      'CUP_VALORTOTAL,'
      'CUP_VENDEDOR,'
      'CLI_NOME,'
      'VEN_NOME'
      'from CUPOM'
      'left join CLIENTES on CUP_CLIENTE=CLI_CODIGO'
      'left join VENDEDORES on CUP_VENDEDOR=VEN_CODIGO'
      'order by VEN_NOME, CUP_CODIGO desc'
      '')
    Left = 48
    Top = 160
  end
