  object QYAceDES: TFDQuery
    Connection = DM.FDConnection1
    Transaction = TRAceDES
    SQL.Strings = (
      'update ACESSOS set ACE_ACESSO=:acesso'
      
        'where ACE_USUARIO=:usuario and ACE_TELA=:tela and ACE_COMPONENTE' +
        '=:componente'
      '')
