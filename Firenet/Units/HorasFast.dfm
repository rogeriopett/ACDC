    ScriptText.Strings = (
      'var'
      '  D1, D2, C1, C2: Extended;'
      '    '
      'procedure Page1OnBeforePrint(Sender: TfrxComponent);'
      'begin'
      '  CarregarLogoSVGFast(Picture1);'
      '  D1:=0;'
      '  D2:=0;'
      '  C1:=0;'
      '  C2:=0;      '
      'end;'
      ''
      'procedure MasterData1OnBeforePrint(Sender: TfrxComponent);'
      'begin'
      '  if <frxDBDataset2."HOR_TRANSACAO"> = '#39'C'#39' then'
      '  begin                      '
      '    C1:=C1 + <frxDBDataset2."HOR_QUANTIDADE">;  '
      '    C2:=C2 + <frxDBDataset2."HOR_QUANTIDADE">;'
      '  end else'
      '  begin'
      '    D1:=D1 + <frxDBDataset2."HOR_QUANTIDADE">;  '
      '    D2:=D2 + <frxDBDataset2."HOR_QUANTIDADE">;'
      '  end;            '
      'end;'
      ''
      'procedure GroupFooter1OnBeforePrint(Sender: TfrxComponent);'
      'begin'
      '  Set('#39'D1'#39', '#39#39#39#39' + FloatToStr(D1) + '#39#39#39#39');'
      '  Set('#39'C1'#39', '#39#39#39#39' + FloatToStr(C1) + '#39#39#39#39');      '
      'end;'
      ''
      'procedure GroupFooter1OnAfterPrint(Sender: TfrxComponent);'
      'begin'
      '  C1:=0;'
      '  D1:=0;                '
      'end;'
      ''
      'procedure ReportSummary1OnBeforePrint(Sender: TfrxComponent);'
      'begin'
      '  Set('#39'D2'#39', '#39#39#39#39' + FloatToStr(D2) + '#39#39#39#39');'
      '  Set('#39'C2'#39', '#39#39#39#39' + FloatToStr(C2) + '#39#39#39#39');      '
      'end;'
      ''
      'procedure ReportSummary1OnAfterPrint(Sender: TfrxComponent);'
      'begin'
      '  C2:=0;'
      '  D2:=0;                '
      'end;'
      ''
      'begin'
      ''
      'end.')
