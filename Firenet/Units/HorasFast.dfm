  object QY01: TFDQuery
    Connection = DM.FDConnection1
    Transaction = TR01
    SQL.Strings = (
      'select '
      'VEN_CODIGO, '
      'VEN_NOME, '
      'VEN_SALDOHORAS'
      'from VENDEDORES'
      'order by VEN_NOME'
      '')
    Left = 48
    Top = 160
  end
  object TR01: TFDTransaction
    Options.Isolation = xiReadCommitted
    Connection = DM.FDConnection1
    Left = 48
    Top = 208
  end
  object QY02: TFDQuery
    Connection = DM.FDConnection1
    Transaction = TR02
    SQL.Strings = (
      'select'
      'HOR_CODIGO,'
      'HOR_DESCRICAO,'
      'HOR_DTCADASTRO,'
      'HOR_QUANTIDADE,'
      'HOR_SALDOANTERIOR,'
      'HOR_SALDOPOSTERIOR,'
      'HOR_TRANSACAO,'
      'HOR_VENDEDOR,'
      'VEN_NOME,'
      'VEN_SALDOHORAS'
      'from HORAS'
      'left join VENDEDORES on HOR_VENDEDOR=VEN_CODIGO'
      'where HOR_DTCADASTRO between :datainicial and :datafinal'
      'order by VEN_NOME, HOR_CODIGO desc'
      '')
    Left = 120
    Top = 160
    ParamData = <
      item
        Name = 'DATAINICIAL'
        ParamType = ptInput
      end
      item
        Name = 'DATAFINAL'
        ParamType = ptInput
      end>
  end
  object TR02: TFDTransaction
    Options.Isolation = xiReadCommitted
    Connection = DM.FDConnection1
    Left = 120
