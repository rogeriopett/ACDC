  object TR01: TFDTransaction
    Options.Isolation = xiReadCommitted
    Connection = DM.FDConnection1
    Left = 48
    Top = 208
  end
  object QY01: TFDQuery
    Connection = DM.FDConnection1
    Transaction = TR01
    SQL.Strings = (
      'select '
      'RCB_CODIGO,'
      'RCB_CCNPJCPF,'
      
        'coalesce(RCB_CENDERECO,'#39#39')||'#39' '#39'||coalesce(RCB_CNUMERO,'#39#39') as CEN' +
        'DERECONUM,'
      
        'coalesce(RCB_SENDERECO,'#39#39')||'#39' '#39'||coalesce(RCB_SNUMERO,'#39#39') as SEN' +
        'DERECONUM,'
      
        'coalesce(RCB_CBAIRRO,'#39#39')||'#39' - '#39'||coalesce(RCB_CCIDADE,'#39#39')||'#39' - C' +
        'EP: '#39'||coalesce(RCB_CCEP,'#39#39') as CBAICIDCEP,'
      'RCB_CFONE1,'
      'RCB_CNOME,'
      'RCB_DATA,'
      'RCB_PROVENIENTE,'
      'RCB_SBAIRRO,'
      'RCB_SCEP,'
      'RCB_SCIDADE,'
      'RCB_SCNPJCPF,'
      'RCB_SNOME,'
      'RCB_VALOR,'
      'RCB_VALOREXTENSO'
      'from RECIBOS'
      'where RCB_CODIGO=:codigo'
      '')
    Left = 48
    Top = 160
    ParamData = <
      item
        Name = 'CODIGO'
        ParamType = ptInput
      end>
  end
  object TR02: TFDTransaction
