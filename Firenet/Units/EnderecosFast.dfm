  object QY03: TFDQuery
    Connection = DM.FDConnection1
    Transaction = TR03
    SQL.Strings = (
      'select '
      'CID_CODIGO,'
      'CID_DIMOB,'
      'CID_ESTADO,'
      'CID_NOME,'
      'ESD_NOME,'
      'ESD_SIGLA'
      'from CIDADES'
      'left join ESTADOS on CID_ESTADO=ESD_CODIGO'
      'order by ESD_NOME, CID_NOME'
      '')
    Left = 192
    Top = 160
  end
  object TR03: TFDTransaction
    Options.Isolation = xiReadCommitted
    Connection = DM.FDConnection1
    Left = 192
    Top = 208
  end
  object QY04: TFDQuery
    Connection = DM.FDConnection1
    Transaction = TR04
    SQL.Strings = (
      'select '
      'BAI_CIDADE,'
      'BAI_CODIGO,'
      'BAI_NOME,'
      'CID_NOME '
      'from BAIRROS '
      'left join CIDADES on BAI_CIDADE=CID_CODIGO'
      'where BAI_CIDADE=:cidade '
      'order by CID_NOME, BAI_NOME'
      '')
    Left = 264
    Top = 160
    ParamData = <
      item
        Name = 'CIDADE'
        ParamType = ptInput
      end>
