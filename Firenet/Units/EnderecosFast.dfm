  object QY05: TFDQuery
    Connection = DM.FDConnection1
    Transaction = TR05
    SQL.Strings = (
      'select '
      'RUA_BAIRRO,'
      'RUA_CEP,'
      'RUA_CODIGO,'
      'RUA_NOME,'
      'BAI_NOME'
      'from RUAS '
      'left join BAIRROS on RUA_BAIRRO=BAI_CODIGO'
      'where RUA_CIDADE=:cidade '
      'order by RUA_BAIRRO, RUA_NOME'
      '')
