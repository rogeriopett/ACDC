  object QY02: TFDQuery
    Connection = DM.FDConnection1
    Transaction = TR02
    SQL.Strings = (
      'select * from ESTADOS '
      'left join PAISES on ESD_PAIS=PAI_CODIGO'
      'order by PAI_NOME, ESD_NOME'
      '')
    Left = 120
    Top = 160
  end
