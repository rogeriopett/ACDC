    Transaction = TRCompras
    SQL.Strings = (
      'select '
      'VED_CODIGO, '
      'VED_CONDICAO,'
      'VED_DTEMISSAO,'
      'VED_NFE,'
      'VED_NOTA,'
      'VED_TRANSPORTADORA,'
