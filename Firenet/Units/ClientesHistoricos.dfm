      'left join CONDICOES on VED_CONDICAO=CPG_CODIGO'
      'left join FORNECEDORES on VED_TRANSPORTADORA=FOR_CODIGO'
      'where VED_CLIENTE=:codigo and VED_STATUS='#39'F'#39
      'order by VED_DTEMISSAO desc'
