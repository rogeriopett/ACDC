  object QYMedicoes: TFDQuery
    Connection = DM.FDConnection1
    Transaction = TRMedicoes
    SQL.Strings = (
      'select '
      'MED_BATIMENTOS,'
      'MED_CLIENTE,'
      'MED_CODIGO,'
      'MED_DTCADASTRO,'
      'MED_GLICEMIA,'
      'MED_HRCADASTRO,'
      'MED_PERIODO,'
      'MED_PESO,'
      'MED_PRESSAO,'
      'MED_SATURACAO,'
      'MED_TEMPERATURA,'
      'MED_USUARIO,'
      'CLI_NOME'
      'from MEDICOES'
      'left join CLIENTES on MED_CLIENTE=CLI_CODIGO'
      'where MED_CLIENTE=:cliente'
      'order by MED_CODIGO desc'
      '')
    Left = 484
    Top = 368
    ParamData = <
      item
        Name = 'CLIENTE'
        DataType = ftInteger
        ParamType = ptInput
