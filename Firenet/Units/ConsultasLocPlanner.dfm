  object TBConsultas: TFDQuery
    Connection = DM.FDConnection1
    Transaction = TRConsultas
    SQL.Strings = (
      'select '
      'COS_CODIGO,'
      'COS_FIM,'
      'COS_INICIO,'
      'COS_MEDICO,'
      'COS_STATUS,'
      'CLI_FONE1,'
      'CLI_NOME,'
      'VEN_COR'
      'from CONSULTAS'
      'left join CLIENTES on COS_CLIENTE=CLI_CODIGO'
      'left join VENDEDORES on COS_MEDICO=VEN_CODIGO'
      
        'where COS_INICIO between :datainicial and :datafinal and COS_MED' +
        'ICO in (:vendedores)'
      'order by COS_DATAINICIO, COS_HORAINICIO'
      '')
    Left = 512
    Top = 288
    ParamData = <
      item
        Name = 'DATAINICIAL'
        DataType = ftTimeStamp
        ParamType = ptInput
      end
      item
        Name = 'DATAFINAL'
        DataType = ftTimeStamp
        ParamType = ptInput
      end
      item
        Name = 'VENDEDORES'
        DataType = ftInteger
        ParamType = ptInput
      end>
