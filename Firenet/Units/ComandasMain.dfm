  object QYVendedores: TIBQuery
    Database = DM.IBDatabase1
    Transaction = TRVendedores
    SQL.Strings = (
      'select VEN_CODIGO, VEN_NOME, VEN_COMISSAO from VENDEDORES'
      'where VEN_CODIGO=:codigo')
