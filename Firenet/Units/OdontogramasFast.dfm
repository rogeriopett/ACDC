  object QY01: TFDQuery
    Connection = DM.FDConnection1
    Transaction = TR01
    SQL.Strings = (
      'select O.*, CLI_NOME from ODONTOGRAMAS O'
      'left join CLIENTES on ODO_CLIENTE=CLI_CODIGO'
      'where ODO_CLIENTE=:cliente'
      'order by ODO_DATA desc')
    Left = 48
    Top = 160
    ParamData = <
      item
        Name = 'CLIENTE'
        DataType = ftInteger
        ParamType = ptInput
      end>
  end
