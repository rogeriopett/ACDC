  object QYEmails: TFDQuery
    Connection = DM.FDConnection1
    Transaction = TREmails
    SQL.Strings = (
      'select first(200) '
      'EMA_ANEXO, '
      'EMA_ANEXO2, '
      'EMA_ANEXO3, '
      'EMA_ASSINATURA, '
      'EMA_ASSUNTO, '
      'EMA_CLIENTE, '
      'EMA_CODIGO, '
      'EMA_CONFIRMACAO, '
      'EMA_DESTINATARIOS, '
      'EMA_DTATUALIZACAO,'
      'EMA_DTCADASTRO, '
      'EMA_DTULTENVIO, '
      'EMA_EMAILCONTA, '
      'EMA_ENVIADO, '
      'EMA_HTML,'
      'EMA_MENSAGEM, '
      'EMA_USUARIO, '
      'EMA_VENDEDOR, '
      'ASS_DESCRICAO, '
      'CLI_NOME,'
      'EMC_ASSINATURA, '
      'EMC_CONFIRMACAO, '
      'EMC_EMAIL, '
      'EMC_LOGIN, '
      'EMC_NOME, '
      'EMC_POP, '
      'EMC_POPPORTA, '
      'EMC_REPLYTO, '
      'EMC_SENHA, '
      'EMC_SMTP,'
      'EMC_SMTPPORTA, '
      'EMC_SSL, '
      'VEN_NOME from EMAILS'
      'left join EMAILSCONTAS on EMA_EMAILCONTA=EMC_CODIGO'
      'left join ASSUNTOS on EMA_ASSUNTO=ASS_CODIGO'
      'left join CLIENTES on EMA_CLIENTE=CLI_CODIGO'
      'left join VENDEDORES on EMA_VENDEDOR=VEN_CODIGO'
      'order by EMA_DTULTENVIO desc, EMA_CODIGO desc'
      '')
    Left = 488
    Top = 341
