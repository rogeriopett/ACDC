    Left = 8
    Top = 288
    Width = 554
    Height = 60
    AutoSize = False
    Caption = 
      'A chave da API '#233' criada no console do provedor (cobran'#231'a por uso' +
      '). Assinaturas de chat (ChatGPT Plus, Claude Pro etc.) n'#227'o d'#227'o a' +
      'cesso '#224' API. A configura'#231#227'o fica gravada no banco (chave criptog' +
      'rafada) e vale para todas as esta'#231#245'es.'
