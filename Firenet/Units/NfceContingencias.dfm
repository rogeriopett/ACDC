  object TBNfceErros: TFDQuery
    Connection = DM.FDConnection1
    Transaction = TRNfceContingentes
    SQL.Strings = (
      'select'
      'extract(YEAR from NFC_DTCADASTRO) as ANO,'
      'NFC_CHAVEACESSO,'
      'NFC_CLIENTE,'
      'NFC_CODIGO,'
