  object TBNfceLogs: TFDQuery
    Connection = DM.FDConnection1
    Transaction = TRNfceLogs
    SQL.Strings = (
      'select'
      'NCL_DATA,'
      'NCL_DESCRICAO,'
      'NCL_HORA,'
      'NCL_NFCE,'
      'NCL_NOME'
      
        'from NFCELOGS where NCL_NOME<>'#39'Envio NFCe'#39' and NCL_DATA between ' +
        ':datainicial and :datafinal'
      'order by NCL_CODIGO desc')
    Left = 144
    Top = 240
    ParamData = <
      item
        Name = 'DATAINICIAL'
        ParamType = ptInput
      end
      item
        Name = 'DATAFINAL'
        DataType = ftDate
        ParamType = ptInput
      end>
