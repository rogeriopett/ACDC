  object TR04: TFDTransaction
    Options.Isolation = xiReadCommitted
    Connection = DM.FDConnection1
    Left = 264
    Top = 208
  end
  object QY04: TFDQuery
    Connection = DM.FDConnection1
    Transaction = TR04
    SQL.Strings = (
      'select '
      'ATE_AULA,'
      'iif(ATE_AULA='#39'S'#39',1,0) as ATE_AULA_N,'
      'ATE_CODIGO,'
      'ATE_CLIENTE,'
      'ATE_CURSO,'
      'ATE_DTCADASTRO,'
      'ATE_TESTEESCRITO,'
      'iif(ATE_TESTEESCRITO='#39'S'#39',1,0) as ATE_TESTEESCRITO_N,'
      'ATE_TESTEORAL,'
      'iif(ATE_TESTEORAL='#39'S'#39',1,0) as ATE_TESTEORAL_N,'
      'ATE_VENDEDOR,'
      'CLI_NOME,'
      'CUR_DESCRICAO,'
      'VEN_NOME,'
      
        'iif( (select count(*) from MATRICULAS where MAT_CLIENTE=ATE_CLIE' +
        'NTE and (MAT_DTCADASTRO between :datainicial and :datafinal))>0,' +
        '1,0) as MATRICULADO_N,'
      
        'iif( (select count(*) from MATRICULAS where MAT_CLIENTE=ATE_CLIE' +
        'NTE and (MAT_DTCADASTRO between :datainicial and :datafinal))>0,' +
        #39'S'#39','#39'N'#39') as MATRICULADO_S'
      'from ATENDIMENTOS'
      'left join CLIENTES on ATE_CLIENTE=CLI_CODIGO'
      'left join VENDEDORES on ATE_VENDEDOR=VEN_CODIGO'
      'left join CURSOS on ATE_CURSO=CUR_CODIGO'
      'where ATE_DTCADASTRO between :datainicial and :datafinal'
      'order by VEN_NOME, CLI_NOME'
      '')
    Left = 264
    Top = 160
    ParamData = <
      item
        Name = 'DATAINICIAL'
        DataType = ftDate
        ParamType = ptInput
      end
      item
        Name = 'DATAFINAL'
        DataType = ftDate
        ParamType = ptInput
      end>
  end
  object TR01: TFDTransaction
    Options.Isolation = xiReadCommitted
    Connection = DM.FDConnection1
    Left = 48
    Top = 208
  end
  object QY01: TFDQuery
    Connection = DM.FDConnection1
    Transaction = TR01
    SQL.Strings = (
      'select '
      'ATE_CLIENTE, '
      'ATE_AULA,'
      'ATE_AULADATA,'
      'ATE_AULAHORA,'
      'CLI_NOME,'
      'CLI_FONE1,'
      'CUR_DESCRICAO'
      'from ATENDIMENTOS'
      'left join CLIENTES on ATE_CLIENTE=CLI_CODIGO'
      'left join CURSOS on ATE_CURSO=CUR_CODIGO'
      
        'where ATE_AULA='#39'S'#39' and ATE_AULADATA between :datainicial and :da' +
        'tafinal '
      'order by ATE_AULADATA, ATE_AULAHORA, CLI_NOME')
    Left = 48
    Top = 160
    ParamData = <
      item
        Name = 'DATAINICIAL'
        DataType = ftDate
        ParamType = ptInput
      end
      item
        Name = 'DATAFINAL'
        DataType = ftDate
        ParamType = ptInput
      end>
  end
  object QY02: TFDQuery
    Connection = DM.FDConnection1
    Transaction = TR02
    SQL.Strings = (
      'select '
      'ATE_CLIENTE, '
      'ATE_TESTEESCRITO,'
      'ATE_TESTEESCRITODATA,'
      'ATE_TESTEESCRITOHORA,'
      'CLI_NOME,'
      'CLI_FONE1,'
      'CUR_DESCRICAO'
      'from ATENDIMENTOS'
