        DataField = 'SEI_ORIGEM'
        DataSource = DM.DSServicosItens
        Items.Strings = (
          '0 - NACIONAL'
          '1 - ESTRANGEIRA - IMPORTACAO DIRETA'
          '2 - ESTRANGEIRA - ADQUIRIDA NO MERCADO INTERNO'
          
            '3 - NACIONAL - MERCADORIA OU BEM COM CONTEUDO DE IMPORTACAO SUPE' +
            'RIOR A 40% E INFERIOR OU IGUAL A 70%'
          '4 - NACIONAL - EM CONFORMIDADE COM PROCESSOS PRODUTIVOS BASICOS'
          
            '5 - NACIONAL - MERCADORIA OU BEM COM CONTEUDO DE IMPORTACAO INFE' +
            'RIOR OU IGUAL A 40%'
          
            '6 - ESTRANGEIRA - IMPORTACAO DIRETA SEM SIMILAR NACIONAL CONSTAN' +
            'TE EM LISTA DA CAMEX E GAS NATURAL'
          
            '7 - ESTRANGEIRA - ADQUIRIDA NO MERCADO INTERNO SEM SIMILAR NACIO' +
            'NAL CONSTANTE EM LISTA DA CAMEX E GAS NATURAL'
          
            '8 - NACIONAL - MERCADORIA OU BEM COM CONTEUDO DE IMPORTACAO SUPE' +
            'RIOR A 70%')
        TabOrder = 0
      end
