    Connection = DM.FDConnection1
    Transaction = TR03
    SQL.Strings = (
      'select '
      'TEV_CODIGO, '
      'TEV_CLIENTE, '
      'TEV_DATA, '
      'TEV_DATABAIXA,'
      'TEV_DATAPROX,'
      'TEV_DESCRICAO, '
      'TEV_STATUS,'
      'TEV_VENDEDOR, '
      'TEV_VIA,'
      'CLI_FONE1,'
      'CLI_NOME, '
      'VEN_NOME '
      'from TELEVENDAS'
      'left join CLIENTES on TEV_CLIENTE=CLI_CODIGO'
      'left join VENDEDORES on TEV_VENDEDOR=VEN_CODIGO'
      'order by VEN_NOME, CLI_NOME'
