  object QY04: TFDQuery
    Connection = DM.FDConnection1
    Transaction = TR04
    SQL.Strings = (
      'select '
      'TEV_CODIGO, '
      'TEV_CLIENTE, '
      'TEV_DATA, '
      'TEV_DATAPROX, '
      'TEV_STATUS, '
      'TEV_TEMPERATURA, '
