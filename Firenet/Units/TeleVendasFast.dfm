  object frxDBDataset6: TfrxDBDataset
    UserName = 'frxDBDataset6'
    CloseDataSource = False
    FieldAliases.Strings = (
      'VEN_CODIGO=VEN_CODIGO'
      'VEN_NOME=VEN_NOME'
      'ABERTOS=ABERTOS'
      'BAIXADOS=BAIXADOS'
      'QTDECLIENTES=QTDECLIENTES')
    DataSet = QY06
    BCDToCurrency = False
    DataSetOptions = []
    Left = 408
    Top = 112
  end
  object QY06: TFDQuery
    Connection = DM.FDConnection1
    Transaction = TR06
    SQL.Strings = (
      'select'
      'V.VEN_CODIGO,'
      'V.VEN_NOME,'
      ''
      '(select count(TEV_CODIGO) as ABERTOS from TELEVENDAS'
      
        'where TEV_STATUS='#39'A'#39' and (TEV_DATA between :datainicial and :dat' +
        'afinal) and TEV_VENDEDOR=V.VEN_CODIGO) as ABERTOS,'
      ''
      '(select count(TEV_CODIGO) as BAIXADOS from TELEVENDAS'
      
        'where TEV_STATUS='#39'B'#39' and TEV_DATA between :datainicial and :data' +
        'final and TEV_VENDEDOR=V.VEN_CODIGO) as BAIXADOS,'
      ''
      '(select count(CLI_CODIGO) as CLIENTES from CLIENTES'
      'where CLI_DTCADASTRO between :datainicial and :datafinal'
      'and CLI_TELEVENDA=V.VEN_CODIGO) as QTDECLIENTES'
      ''
      'from VENDEDORES V'
      'order by V.VEN_NOME'
      '')
    Left = 408
    Top = 160
    ParamData = <
      item
        Name = 'DATAINICIAL'
        ParamType = ptInput
      end
      item
        Name = 'DATAFINAL'
        ParamType = ptInput
      end>
  end
  object TR06: TFDTransaction
    Options.Isolation = xiReadCommitted
    Connection = DM.FDConnection1
    Left = 408
    Top = 208
  end
  object QY01: TFDQuery
    Connection = DM.FDConnection1
    Transaction = TR01
    SQL.Strings = (
      'select '
      'CLI_CODIGO, '
      'CLI_FONE1, '
      'CLI_FONE2, '
      'CLI_FONE3,'
      'CLI_NOME, '
      'CLI_TELEVENDA, '
      'VEN_NOME '
      'from CLIENTES'
      'left join VENDEDORES on CLI_TELEVENDA=VEN_CODIGO'
      'where CLI_CODIGO not in '
      ''
      '(select distinct(TEV_CLIENTE) from TELEVENDAS where'
      
        'TEV_DATAPROX between :datainicial and :datafinal and TEV_STATUS=' +
        ':status)'
      ''
      'order by VEN_NOME, CLI_NOME'
      '')
    Left = 48
    Top = 160
    ParamData = <
      item
        Name = 'DATAINICIAL'
        ParamType = ptInput
      end
      item
        Name = 'DATAFINAL'
        ParamType = ptInput
      end
      item
        Name = 'STATUS'
        ParamType = ptInput
      end>
  end
  object TR01: TFDTransaction
    Options.Isolation = xiReadCommitted
    Connection = DM.FDConnection1
    Left = 48
    Top = 208
  end
  object QY02: TFDQuery
    Connection = DM.FDConnection1
    Transaction = TR02
    SQL.Strings = (
      'select CLI_NOME, '
      'CLI_CODIGO, '
      'CLI_FONE1, '
      'CLI_FONE2, '
      'CLI_FONE3, '
      'CLI_TELEVENDA,'
      'VEN_NOME from CLIENTES'
      'left join VENDEDORES on CLI_TELEVENDA=VEN_CODIGO'
      
        'where not exists (select TEV_CLIENTE from TELEVENDAS where TEV_C' +
        'LIENTE=CLI_CODIGO)'
      'order by VEN_NOME, CLI_NOME'
      '')
    Left = 120
    Top = 160
  end
  object TR02: TFDTransaction
    Options.Isolation = xiReadCommitted
    Connection = DM.FDConnection1
    Left = 120
    Top = 208
  end
