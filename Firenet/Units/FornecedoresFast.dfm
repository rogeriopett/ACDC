  object QY01: TFDQuery
    Connection = DM.FDConnection1
    Transaction = TR01
    SQL.Strings = (
      'select'
      'FOR_CNPJ,'
      'FOR_CODIGO,'
      'FOR_DTCADASTRO,'
      'FOR_EMAIL,'
      'FOR_FONE1,'
      'FOR_FONE2,'
      'FOR_FONE3,'
      'FOR_NOME,'
      'FOR_STATUS'
      'from FORNECEDORES '
      'order by FOR_NOME'
      '')
    Left = 48
    Top = 160
  end
  object TR01: TFDTransaction
    Options.Isolation = xiReadCommitted
    Connection = DM.FDConnection1
    Left = 48
    Top = 208
  end
  object QY02: TFDQuery
    Connection = DM.FDConnection1
    Transaction = TR02
    SQL.Strings = (
      'select'
      'FOR_ATIVIDADE, '
      'FOR_CODIGO, '
      'FOR_DTATUALIZACAO, '
      'FOR_DTCADASTRO, '
      'FOR_FONE1, '
      'FOR_FONE2, '
      'FOR_FONE3, '
      'FOR_NOME,'
      'FOR_STATUS,'
      'ATI_DESCRICAO '
      'from FORNECEDORES '
      'left join ATIVIDADES on FOR_ATIVIDADE=ATI_CODIGO'
      'order by ATI_DESCRICAO, FOR_NOME'
      '')
    Left = 120
    Top = 160
  end
  object TR02: TFDTransaction
    Options.Isolation = xiReadCommitted
    Connection = DM.FDConnection1
    Left = 120
    Top = 208
  end
