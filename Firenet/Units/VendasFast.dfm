  object QY36: TFDQuery
    Connection = DM.FDConnection1
    Transaction = TR36
    SQL.Strings = (
      'select '
      'VED_CODIGO,'
      'VED_CLIENTE,'
      'VED_DTEMISSAO,'
      'VED_DTENTREGA,'
      'VED_NFE,'
      'VED_PRODUCAO,'
      'VED_STATUS,'
      'VED_VALORTOTAL,'
      'VED_VENDEDOR,'
      'CLI_NOME,'
      'PRD_STATUS'
      'from VENDAS'
      'left join CLIENTES on VED_CLIENTE=CLI_CODIGO'
      'left join PRODUCAO on VED_PRODUCAO=PRD_CODIGO '
      'where VED_STATUS='#39'F'#39
      'order by CLI_NOME, VED_DTENTREGA, VED_CODIGO desc'
      '')
    Left = 624
    Top = 384
  end
  object TR36: TFDTransaction
    Options.Isolation = xiReadCommitted
    Connection = DM.FDConnection1
    Left = 624
    Top = 432
  end
  object QY36a: TFDQuery
    MasterSource = DS36
    MasterFields = 'VED_CODIGO'
    Connection = DM.FDConnection1
    Transaction = TR36a
    SQL.Strings = (
      'select '
      'VEI_CODIGO,'
      'VEI_COMPLEMENTO,'
      'VEI_DESCRICAO||'
      
        'iif(coalesce(VEI_COMPLEMENTO,'#39#39')<>'#39#39','#39' - '#39'||VEI_COMPLEMENTO,'#39#39') ' +
        'as VEI_DESCRICAO,'
      'VEI_DTENTREGA,'
      'VEI_PRODUTO,'
      'VEI_QUANTIDADE,'
      'VEI_UNIDADE,'
      'VEI_VALORUNIT,'
      'VEI_VALORTOTAL'
      'from VENDASITENS'
      'where VEI_VENDA=:VED_CODIGO'
      'order by VEI_DESCRICAO'
      '')
    Left = 656
    Top = 384
    ParamData = <
      item
        Name = 'VED_CODIGO'
        DataType = ftInteger
        ParamType = ptInput
      end>
  end
  object TR36a: TFDTransaction
    Options.Isolation = xiReadCommitted
    Connection = DM.FDConnection1
    Left = 656
    Top = 432
  end
