  object QY35: TFDQuery
    Connection = DM.FDConnection1
    Transaction = TR35
    SQL.Strings = (
      'select '
      
        'VEI_CLASSFISCAL||'#39'-'#39'||coalesce(VEI_EXCECAO,0) as VEI_CLASSFISCAL' +
        ','
      'VEI_DESCRICAO, '
      'coalesce(VEI_EXCECAO,0) as VEI_EXCECAO, '
      'VEI_PRECOCUSTO,'
      'VEI_PRODUTO, '
      'VEI_QUANTIDADE, '
      'VEI_VALORTOTAL, '
      'VEI_VALORUNIT,'
      'VED_CODIGO, '
      'VED_DTEMISSAO, '
      'VED_NFE, '
      'VED_STATUS, '
      'VED_VALORTOTAL, '
      'CLF_DESCRICAO'
      'from VENDASITENS'
      'left join VENDAS on VEI_VENDA=VED_CODIGO'
      
        'left join CLASSFISCAL on VEI_CLASSFISCAL=CLF_CODIGO and coalesce' +
        '(VEI_EXCECAO,0)=CLF_EXCECAO'
      'where VED_DTEMISSAO between :datainicial and :datafinal'
      'order by 1, VED_DTEMISSAO'
      '')
    Left = 592
    Top = 384
    ParamData = <
      item
        Name = 'DATAINICIAL'
        ParamType = ptInput
      end
      item
        Name = 'DATAFINAL'
        ParamType = ptInput
      end>
  end
