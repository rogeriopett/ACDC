  object QY25a: TFDQuery
    MasterSource = DS25
    MasterFields = 'VED_VENDEDOR'
    Connection = DM.FDConnection1
    Transaction = TR25a
    SQL.Strings = (
      'select'
      'D3.VED_CLIENTE,'
      'D3.VED_NOME,'
      'D3.VED_VENDEDOR,'
      'D3.TOTALVENDA,'
      'D3.TOTALVENDAGERAL,'
      'D3.PERCENTUAL,'
      'D3.PERCENTUALACUMULADO,'
      'case'
      '  when D3.PERCENTUALACUMULADO <= 80 then '#39'A'#39
      '  when D3.PERCENTUALACUMULADO <= 95 then '#39'B'#39
      '  else '#39'C'#39
      'end as CLASSE'
      'from ('
      '    select'
      '    D2.VED_CLIENTE,'
      '    D2.VED_NOME,'
      '    D2.VED_VENDEDOR,'
      '    D2.TOTALVENDA,'
      '    D2.TOTALVENDAGERAL,'
      '    D2.PERCENTUAL,'
      
        '    sum(D2.PERCENTUAL) over (order by D2.PERCENTUAL desc) as PER' +
        'CENTUALACUMULADO'
      '    from ('
      '        select'
      '        D1.VED_CLIENTE,'
      '        D1.VED_NOME,'
      '        D1.VED_VENDEDOR,'
      '        D1.TOTALVENDA,'
      '        sum(D1.TOTALVENDA) over() as TOTALVENDAGERAL,'
      
        '        cast(D1.TOTALVENDA as numeric (15,4)) / cast(sum(D1.TOTA' +
        'LVENDA) over() as numeric (15,4)) * 100 as PERCENTUAL'
      '        from ('
      '            select'
      '            VED_CLIENTE,'
      '            VED_NOME,'
      '            VED_VENDEDOR,'
      '            sum(VED_VALORTOTAL) as TOTALVENDA'
      '            from VENDAS'
      
        '            where VED_DTEMISSAO between :datainicial and :datafi' +
        'nal and VED_STATUS='#39'F'#39' and VED_VENDEDOR=:VED_VENDEDOR'
      '            group by VED_VENDEDOR, VED_CLIENTE, VED_NOME'
      '            order by VED_VENDEDOR, 4 desc) D1) D2) D3'
      '')
    Left = 112
    Top = 384
