      '  when REE_STATUS='#39'B'#39' then '#39'BAIXADO'#39
      '  when REE_STATUS='#39'C'#39' then '#39'CANCELADO'#39
      '  else '#39'---'#39
      'end as STATUS'
      'from RECEBER'
