  object QY27: TFDQuery
    Connection = DM.FDConnection1
    Transaction = TR27
    SQL.Strings = (
      'select'
      'CLI_CODIGO, '
      'CLI_NOME,'
      'VED_VENDEDOR,'
      'VEN_NOME,'
      'sum(VED_VALORTOTAL) as TOTAL,'
      
        'sum(decode(extract(MONTH from VED_DTEMISSAO),1,VED_VALORTOTAL,0)' +
        ') as JANEIRO,'
      
        'sum(decode(extract(MONTH from VED_DTEMISSAO),2,VED_VALORTOTAL,0)' +
        ') as FEVEREIRO,'
      
        'sum(decode(extract(MONTH from VED_DTEMISSAO),3,VED_VALORTOTAL,0)' +
        ') as MARCO,'
      
        'sum(decode(extract(MONTH from VED_DTEMISSAO),4,VED_VALORTOTAL,0)' +
        ') as ABRIL,'
      
        'sum(decode(extract(MONTH from VED_DTEMISSAO),5,VED_VALORTOTAL,0)' +
        ') as MAIO,'
      
        'sum(decode(extract(MONTH from VED_DTEMISSAO),6,VED_VALORTOTAL,0)' +
        ') as JUNHO,'
      
        'sum(decode(extract(MONTH from VED_DTEMISSAO),7,VED_VALORTOTAL,0)' +
        ') as JULHO,'
      
        'sum(decode(extract(MONTH from VED_DTEMISSAO),8,VED_VALORTOTAL,0)' +
        ') as AGOSTO,'
      
        'sum(decode(extract(MONTH from VED_DTEMISSAO),9,VED_VALORTOTAL,0)' +
        ') as SETEMBRO,'
      
        'sum(decode(extract(MONTH from VED_DTEMISSAO),10,VED_VALORTOTAL,0' +
        ')) as OUTUBRO,'
      
        'sum(decode(extract(MONTH from VED_DTEMISSAO),11,VED_VALORTOTAL,0' +
        ')) as NOVEMBRO,'
      
        'sum(decode(extract(MONTH from VED_DTEMISSAO),12,VED_VALORTOTAL,0' +
        ')) as DEZEMBRO'
      'from CLIENTES'
      'left join VENDAS on CLI_CODIGO=VED_CLIENTE'
      'left join VENDEDORES on VED_VENDEDOR=VEN_CODIGO'
      'where VED_DTEMISSAO between :datainicial and :datafinal'
      'group by VED_VENDEDOR, VEN_NOME, CLI_CODIGO, CLI_NOME'
      'order by VEN_NOME, TOTAL desc, CLI_NOME'
      '')
    Left = 176
    Top = 384
    ParamData = <
      item
        Name = 'DATAINICIAL'
        ParamType = ptInput
      end
      item
        Name = 'DATAFINAL'
        ParamType = ptInput
      end>
  end
  object TR27: TFDTransaction
    Options.Isolation = xiReadCommitted
    Connection = DM.FDConnection1
    Left = 176
    Top = 432
  end
  object QY28: TFDQuery
    Connection = DM.FDConnection1
    Transaction = TR28
    SQL.Strings = (
      'select'
      '    C.VEI_PRODUTO,'
      '    C.QTDE,'
      '    C.VALORTOTAL,'
      '    C.VALORCOMISSAO,'
      '    C.VALORUNIT,'
      '    C.PRECOCUSTO,'
      '    C.PRO_NOME,'
      '    C.CUSTOTOTAL,'
      '    C.MARGEM,'
      
        '    iif(C.CUSTOTOTAL > 0, cast((C.MARGEM * 100) / C.CUSTOTOTAL a' +
        's numeric(15,2)), 0) as MARGEMPORC'
      'from ('
      '    select'
      '        B.VEI_PRODUTO,'
      '        B.QTDE,'
      '        B.VALORTOTAL,'
      '        B.VALORCOMISSAO,'
      '        B.VALORUNIT,'
      '        B.PRECOCUSTO,'
      '        B.PRO_NOME,'
      '        B.CUSTOTOTAL,'
      
        '        cast(B.VALORTOTAL - B.CUSTOTOTAL as numeric(15,2)) as MA' +
        'RGEM'
      '    from ('
      '        select'
      '            A.VEI_PRODUTO,'
      '            A.QTDE,'
      '            A.VALORTOTAL,'
      '            A.VALORCOMISSAO,'
      '            A.VALORUNIT,'
      '            A.PRECOCUSTO,'
      '            A.PRO_NOME,'
      
        '            cast(A.QTDE as numeric(15,4)) * cast(a.PRECOCUSTO as' +
        ' numeric(15,2)) as CUSTOTOTAL'
      '        from ('
      '            select '
      '            VEI_PRODUTO,'
      '            sum(cast(VEI_QUANTIDADE as numeric(15,4))) as QTDE,'
      
        '            sum(cast(VEI_VALORTOTAL as numeric(15,2))) as VALORT' +
        'OTAL,'
      
        '            sum(cast(VEI_VALORCOMISSAO as numeric(15,2))) as VAL' +
        'ORCOMISSAO,'
      
        '            avg(cast(VEI_VALORUNIT as numeric(15,2))) as VALORUN' +
        'IT,'
      
        '            avg(cast(VEI_PRECOCUSTO as numeric(15,2))) as PRECOC' +
        'USTO,'
      '            PRO_NOME'
      '            from VENDASITENS'
      '            left join VENDAS on VEI_VENDA=VED_CODIGO'
      '            left join PRODUTOS on VEI_PRODUTO=PRO_CODIGO'
      
        '            where VED_DTEMISSAO between :datainicial and :datafi' +
        'nal'
      '            group by VEI_PRODUTO, PRO_NOME'
      '            order by VEI_PRODUTO) A) B) C'
      '')
    Left = 208
    Top = 384
    ParamData = <
      item
        Name = 'DATAINICIAL'
        ParamType = ptInput
      end
      item
        Name = 'DATAFINAL'
        ParamType = ptInput
      end>
  end
  object TR28: TFDTransaction
    Options.Isolation = xiReadCommitted
    Connection = DM.FDConnection1
    Left = 208
    Top = 432
  end
