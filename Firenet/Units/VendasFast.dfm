  object QY23: TFDQuery
    Connection = DM.FDConnection1
    Transaction = TR23
    SQL.Strings = (
      'with DADOS as ('
      '    select'
      '    atual.VED_CLIENTE,'
      '    atual.VED_VENDEDOR,'
      '    cli.CLI_NOME,'
      '    ven.VEN_NOME,'
      
        '    avg(datediff(day, anterior.VED_DTEMISSAO, atual.VED_DTEMISSA' +
        'O)) as INTERVALOMEDIO,'
      '    count(atual.VED_CODIGO) as QTDEVEZES,'
      '    max(atual.VED_DTEMISSAO) as MAISRECENTE'
      '    from ('
      '        select'
      '        VED_CODIGO,'
      '        (select first(1) V2.VED_CODIGO from VENDAS V2'
      
        '           where V2.VED_CLIENTE = V1.VED_CLIENTE and V2.VED_DTEM' +
        'ISSAO < V1.VED_DTEMISSAO'
      
        '           order by V2.VED_DTEMISSAO desc) as VED_CODIGO_ANTERIO' +
        'R'
      
        '        from VENDAS V1 where VED_DTEMISSAO between :datainicial ' +
        'and :datafinal and VED_STATUS='#39'F'#39') A'
      
        '    join VENDAS anterior on anterior.VED_CODIGO = A.VED_CODIGO_A' +
        'NTERIOR'
      '    join VENDAS atual on atual.VED_CODIGO = A.VED_CODIGO'
      '    left join CLIENTES cli on atual.VED_CLIENTE=cli.CLI_CODIGO'
      
        '    left join VENDEDORES ven on atual.VED_VENDEDOR=ven.VEN_CODIG' +
        'O'
      
        '    group by atual.VED_VENDEDOR, ven.VEN_NOME, atual.VED_CLIENTE' +
        ', cli.CLI_NOME'
      ')'
      'select'
      
        '    VED_VENDEDOR, VEN_NOME, VED_CLIENTE, CLI_NOME, INTERVALOMEDI' +
        'O, QTDEVEZES, MAISRECENTE,'
      '    MAISRECENTE + INTERVALOMEDIO as PROXIMAVENDA,'
      '    case'
      
        '        when MAISRECENTE + INTERVALOMEDIO < current_date then '#39'S' +
        'IM'#39
      '        else '#39'NAO'#39
      '    end as ATRASADO,'
      '    current_date - (MAISRECENTE + INTERVALOMEDIO) as DIASATRASO'
      'from DADOS'
      'where QTDEVEZES >= :quantidade_minima'
      'order by VEN_NOME, CLI_NOME'
      '')
    Left = 784
    Top = 160
    ParamData = <
      item
        Name = 'DATAINICIAL'
        ParamType = ptInput
      end
      item
        Name = 'DATAFINAL'
        ParamType = ptInput
      end
      item
        Name = 'QUANTIDADE_MINIMA'
        ParamType = ptInput
      end>
  end
  object TR23: TFDTransaction
    Options.Isolation = xiReadCommitted
    Connection = DM.FDConnection1
    Left = 784
    Top = 208
  end
  object QY24: TFDQuery
    Connection = DM.FDConnection1
    Transaction = TR24
    SQL.Strings = (
      'select'
      'D3.VEI_PRODUTO,'
      'D3.QTDEVENDIDA,'
      'D3.VALORTOTALITEM,'
      'D3.TOTALGERAL,'
      'D3.PERCENTUAL,'
      'D3.PERCENTUALACUMULADO,'
      'D3.TOTALCUSTO,'
      'D3.PRECOVENDAMEDIO,'
      
        'D3.PRO_NOME, D3.PRO_FAMILIA, D3.PRO_GRUPO, D3.PRO_PRECOCUSTO, D3' +
        '.PRO_PRECOVENDA, D3.PRO_UNIDADE, '
      'case'
      '  when D3.PERCENTUALACUMULADO <= 80 then '#39'A'#39
      '  when D3.PERCENTUALACUMULADO <= 95 then '#39'B'#39
      '  else '#39'C'#39
      'end as CLASSE'
      'from ('
      '    select'
      '    D2.VEI_PRODUTO,'
      '    D2.QTDEVENDIDA,'
      '    D2.VALORTOTALITEM,'
      '    D2.TOTALGERAL,'
      '    D2.PERCENTUAL,'
      
        '    D2.PRO_NOME, D2.PRO_FAMILIA, D2.PRO_GRUPO, D2.PRO_PRECOCUSTO' +
        ', D2.PRO_PRECOVENDA, D2.PRO_UNIDADE, '
      '    D2.TOTALCUSTO,'
      '    D2.PRECOVENDAMEDIO,'
      
        '    sum(D2.PERCENTUAL) over (order by D2.PERCENTUAL desc) as PER' +
        'CENTUALACUMULADO'
      '    from ('
      '        select'
      '        D1.VEI_PRODUTO,'
      '        D1.QTDEVENDIDA,'
      '        D1.VALORTOTALITEM,'
      
        '        D1.PRO_NOME, D1.PRO_FAMILIA, D1.PRO_GRUPO, D1.PRO_PRECOC' +
        'USTO, D1.PRO_PRECOVENDA, D1.PRO_UNIDADE, '
      
        '        cast(D1.VALORTOTALITEM as numeric(15,4)) / cast(D1.QTDEV' +
        'ENDIDA as numeric(15,4)) as PRECOVENDAMEDIO,'
      
        '        cast(D1.QTDEVENDIDA as numeric(15,4)) * cast(D1.PRO_PREC' +
        'OCUSTO as numeric(15,4)) as TOTALCUSTO,'
      '        sum(D1.VALORTOTALITEM) over() as TOTALGERAL,'
      
        '        cast(D1.VALORTOTALITEM as numeric (15,4)) / cast(sum(D1.' +
        'VALORTOTALITEM) over() as numeric (15,4)) * 100 as PERCENTUAL'
      '        from ('
      '            select'
      '            VEI_PRODUTO,'
      '            sum(VEI_QUANTIDADE) as QTDEVENDIDA,'
      '            sum(VEI_VALORTOTAL) as VALORTOTALITEM,'
      
        '            PRO_NOME, PRO_FAMILIA, PRO_GRUPO, PRO_PRECOCUSTO, PR' +
        'O_PRECOVENDA, PRO_UNIDADE'
      '            from VENDASITENS'
      '            left join VENDAS on VEI_VENDA=VED_CODIGO'
      '            left join PRODUTOS on VEI_PRODUTO=PRO_CODIGO'
      
        '            where VED_DTEMISSAO between :datainicial and :datafi' +
        'nal'
      
        '            group by VEI_PRODUTO, PRO_NOME, PRO_FAMILIA, PRO_GRU' +
        'PO, PRO_PRECOCUSTO, PRO_PRECOVENDA, PRO_UNIDADE'
      '            order by 2 desc) D1) D2) D3'
      '')
    Left = 48
    Top = 384
    ParamData = <
      item
        Name = 'DATAINICIAL'
        DataType = ftDate
        ParamType = ptInput
      end
      item
        Name = 'DATAFINAL'
        DataType = ftDate
        ParamType = ptInput
      end>
  end
  object TR24: TFDTransaction
    Options.Isolation = xiReadCommitted
    Connection = DM.FDConnection1
    Left = 48
    Top = 432
  end
