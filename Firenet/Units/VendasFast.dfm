  object QY03: TFDQuery
    Connection = DM.FDConnection1
    Transaction = TR03
    SQL.Strings = (
      'select '
      'VED_DTEMISSAO, '
      'VED_VENDEDOR, '
      'VEN_NOME,'
      'coalesce(sum(VED_TOTALITENS),0) as TOTALITENS, '
      'coalesce(sum(VED_VALORTOTAL),0) as TOTAL, '
      'count(VED_VENDEDOR) as QTDE'
      'from VENDAS'
      'left join VENDEDORES on VED_VENDEDOR=VEN_CODIGO'
      'group by VED_VENDEDOR, VED_DTEMISSAO, VEN_NOME'
      'order by VED_VENDEDOR, VED_DTEMISSAO'
      '')
    Left = 144
    Top = 160
  end
