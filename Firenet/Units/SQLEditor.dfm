    Transaction = TRSqls
    SQL.Strings = (
      'select '
      'SQL_CODIGO,'
      'SQL_FORM,'
      'SQL_QUERY,'
      'SQL_USUARIO,'
      'cast(SQL_QUERY as VARCHAR(2000)) as SQL_PREVIEW,'
      'USU_LOGIN'
      'from SQLS'
      'left join USUARIOS on SQL_USUARIO=USU_CODIGO '
