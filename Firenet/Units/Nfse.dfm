  object UPNfseItens: TFDUpdateSQL
    Connection = DM.FDConnection1
    InsertSQL.Strings = (
      'INSERT INTO NFSEITENS'
      '(NSI_ALIQCBS, NSI_ALIQCBSCREDPRES, NSI_ALIQCBSDIF, '
      '  NSI_ALIQCBSEFE, NSI_ALIQCBSRED, NSI_ALIQIBSCREDPRES, '
      '  NSI_ALIQIBSMUN, NSI_ALIQIBSMUNDIF, NSI_ALIQIBSMUNEFE, '
      '  NSI_ALIQIBSMUNRED, NSI_ALIQIBSUF, NSI_ALIQIBSUFDIF, '
      '  NSI_ALIQIBSUFEFE, NSI_ALIQIBSUFRED, NSI_ALIQIS, '
      '  NSI_ALIQISESP, NSI_ALIQUOTA, NSI_BASEIBSCBS, '
      '  NSI_BASEIS, NSI_BASEISS, NSI_CBSCREDITOPRES, '
      '  NSI_CIDADE, NSI_CIDADECODIGO, NSI_CLASSTRIBIBSCBS, '
      '  NSI_CLASSTRIBIS, NSI_CODIGO, NSI_CSTIBSCBS, '
      '  NSI_CSTIS, NSI_DESCRICAO, NSI_IBSCREDITOPRES, '
      '  NSI_NBS, NSI_NFSE, NSI_PAIS, NSI_PRESTADONOPAIS, '
      '  NSI_PRODUTO, NSI_QUANTIDADE, NSI_SERVICO, '
      '  NSI_VALORCBS, NSI_VALORCBSCREDPRES, NSI_VALORCBSCREDPRESSUS, '
      '  NSI_VALORCBSDEV, NSI_VALORCBSDIF, NSI_VALORDEDUCOES, '
      '  NSI_VALORDESCCOND, NSI_VALORDESCINCOND, NSI_VALORIBS, '
      '  NSI_VALORIBSCREDPRES, NSI_VALORIBSCREDPRESSUS, '
      '  NSI_VALORIBSMUN, NSI_VALORIBSMUNDEV, NSI_VALORIBSMUNDIF, '
      '  NSI_VALORIBSUF, NSI_VALORIBSUFDEV, NSI_VALORIBSUFDIF, '
      '  NSI_VALORIS, NSI_VALORISS, NSI_VALORTOTAL, '
      
        '  NSI_VALORTRIBUTOS, NSI_VALORTRIBUTOSEST, NSI_VALORTRIBUTOSFED,' +
        ' '
      '  NSI_VALORTRIBUTOSIMP, NSI_VALORTRIBUTOSMUN, NSI_VALORUNIT)'
      
        'VALUES (:NEW_NSI_ALIQCBS, :NEW_NSI_ALIQCBSCREDPRES, :NEW_NSI_ALI' +
        'QCBSDIF, '
      
        '  :NEW_NSI_ALIQCBSEFE, :NEW_NSI_ALIQCBSRED, :NEW_NSI_ALIQIBSCRED' +
        'PRES, '
      
        '  :NEW_NSI_ALIQIBSMUN, :NEW_NSI_ALIQIBSMUNDIF, :NEW_NSI_ALIQIBSM' +
        'UNEFE, '
      
        '  :NEW_NSI_ALIQIBSMUNRED, :NEW_NSI_ALIQIBSUF, :NEW_NSI_ALIQIBSUF' +
        'DIF, '
      
        '  :NEW_NSI_ALIQIBSUFEFE, :NEW_NSI_ALIQIBSUFRED, :NEW_NSI_ALIQIS,' +
        ' '
      '  :NEW_NSI_ALIQISESP, :NEW_NSI_ALIQUOTA, :NEW_NSI_BASEIBSCBS, '
      '  :NEW_NSI_BASEIS, :NEW_NSI_BASEISS, :NEW_NSI_CBSCREDITOPRES, '
      
        '  :NEW_NSI_CIDADE, :NEW_NSI_CIDADECODIGO, :NEW_NSI_CLASSTRIBIBSC' +
        'BS, '
      
        '  :NEW_NSI_CLASSTRIBIS, gen_id(GEN_NFSEITENS,1), :NEW_NSI_CSTIBS' +
        'CBS, '
      '  :NEW_NSI_CSTIS, :NEW_NSI_DESCRICAO, :NEW_NSI_IBSCREDITOPRES, '
      
        '  :NEW_NSI_NBS, :NEW_NSI_NFSE, :NEW_NSI_PAIS, :NEW_NSI_PRESTADON' +
        'OPAIS, '
      '  :NEW_NSI_PRODUTO, :NEW_NSI_QUANTIDADE, :NEW_NSI_SERVICO, '
      
        '  :NEW_NSI_VALORCBS, :NEW_NSI_VALORCBSCREDPRES, :NEW_NSI_VALORCB' +
        'SCREDPRESSUS, '
      
        '  :NEW_NSI_VALORCBSDEV, :NEW_NSI_VALORCBSDIF, :NEW_NSI_VALORDEDU' +
        'COES, '
      
        '  :NEW_NSI_VALORDESCCOND, :NEW_NSI_VALORDESCINCOND, :NEW_NSI_VAL' +
        'ORIBS, '
      '  :NEW_NSI_VALORIBSCREDPRES, :NEW_NSI_VALORIBSCREDPRESSUS, '
      
        '  :NEW_NSI_VALORIBSMUN, :NEW_NSI_VALORIBSMUNDEV, :NEW_NSI_VALORI' +
        'BSMUNDIF, '
      
        '  :NEW_NSI_VALORIBSUF, :NEW_NSI_VALORIBSUFDEV, :NEW_NSI_VALORIBS' +
        'UFDIF, '
      '  :NEW_NSI_VALORIS, :NEW_NSI_VALORISS, :NEW_NSI_VALORTOTAL, '
      
        '  :NEW_NSI_VALORTRIBUTOS, :NEW_NSI_VALORTRIBUTOSEST, :NEW_NSI_VA' +
        'LORTRIBUTOSFED, '
      
        '  :NEW_NSI_VALORTRIBUTOSIMP, :NEW_NSI_VALORTRIBUTOSMUN, :NEW_NSI' +
        '_VALORUNIT)'
      
        'RETURNING NSI_ALIQCBS, NSI_ALIQCBSCREDPRES, NSI_ALIQCBSDIF, NSI_' +
        'ALIQCBSEFE, NSI_ALIQCBSRED, NSI_ALIQIBSCREDPRES, NSI_ALIQIBSMUN,' +
        ' NSI_ALIQIBSMUNDIF, NSI_ALIQIBSMUNEFE, NSI_ALIQIBSMUNRED, NSI_AL' +
        'IQIBSUF, NSI_ALIQIBSUFDIF, NSI_ALIQIBSUFEFE, NSI_ALIQIBSUFRED, N' +
        'SI_ALIQIS, NSI_ALIQISESP, NSI_ALIQUOTA, NSI_BASEIBSCBS, NSI_BASE' +
        'IS, NSI_BASEISS, NSI_CBSCREDITOPRES, NSI_CIDADE, NSI_CIDADECODIG' +
        'O, NSI_CLASSTRIBIBSCBS, NSI_CLASSTRIBIS, NSI_CODIGO, NSI_CSTIBSC' +
        'BS, NSI_CSTIS, NSI_DESCRICAO, NSI_IBSCREDITOPRES, NSI_NBS, NSI_N' +
        'FSE, NSI_PAIS, NSI_PRESTADONOPAIS, NSI_PRODUTO, NSI_QUANTIDADE, ' +
        'NSI_SERVICO, NSI_VALORCBS, NSI_VALORCBSCREDPRES, NSI_VALORCBSCRE' +
        'DPRESSUS, NSI_VALORCBSDEV, NSI_VALORCBSDIF, NSI_VALORDEDUCOES, N' +
        'SI_VALORDESCCOND, NSI_VALORDESCINCOND, NSI_VALORIBS, NSI_VALORIB' +
        'SCREDPRES, NSI_VALORIBSCREDPRESSUS, NSI_VALORIBSMUN, NSI_VALORIB' +
        'SMUNDEV, NSI_VALORIBSMUNDIF, NSI_VALORIBSUF, NSI_VALORIBSUFDEV, ' +
        'NSI_VALORIBSUFDIF, NSI_VALORIS, NSI_VALORISS, NSI_VALORTOTAL, NS' +
        'I_VALORTRIBUTOS, NSI_VALORTRIBUTOSEST, NSI_VALORTRIBUTOSFED, NSI' +
        '_VALORTRIBUTOSIMP, NSI_VALORTRIBUTOSMUN, NSI_VALORUNIT')
    ModifySQL.Strings = (
      'UPDATE NFSEITENS'
      
        'SET NSI_ALIQCBS = :NEW_NSI_ALIQCBS, NSI_ALIQCBSCREDPRES = :NEW_N' +
