  object UPNfse: TFDUpdateSQL
    Connection = DM.FDConnection1
    InsertSQL.Strings = (
      'INSERT INTO NFSE'
      '(NFS_BAIXADATA, NFS_BAIXAPOR, NFS_BASEIBSCBS, '
      '  NFS_BASEIS, NFS_BASEISS, NFS_CANCELAMENTOCODIGO, '
      
        '  NFS_CANCELAMENTODATA, NFS_CANCELAMENTOHORA, NFS_CANCELAMENTOMO' +
        'TIVO, '
      '  NFS_CBSCREDPRES, NFS_CBSCREDPRESSUS, NFS_CBSDEVOLUCAO, '
      '  NFS_CBSDIFERIMENTO, NFS_CBSMONO, NFS_CBSMONORETENCAO, '
      '  NFS_CBSMONORETIDO, NFS_CBSVALOR, NFS_CHAVEACESSO, '
      '  NFS_CLIENTE, NFS_CODIGO, NFS_CONDICAO, NFS_CONDICAOMEMO, '
      '  NFS_CONSULTADA, NFS_CSTISS, NFS_DIAPREFERENCIAL, '
      '  NFS_DTATUALIZACAO, NFS_DTCADASTRO, NFS_DTEMISSAO, '
      '  NFS_FINALIDADE, NFS_FORMAPAGTO, NFS_GOVERNAMENTAL, '
      '  NFS_GOVERNAMENTALALIQRED, NFS_GOVERNAMENTALOP, '
      '  NFS_HRATUALIZACAO, NFS_HRCADASTRO, NFS_IBSCREDPRES, '
      '  NFS_IBSCREDPRESSUS, NFS_IBSMONO, NFS_IBSMONORETENCAO, '
      
        '  NFS_IBSMONORETIDO, NFS_IBSMUNDEVOLUCAO, NFS_IBSMUNDIFERIMENTO,' +
        ' '
      '  NFS_IBSMUNVALOR, NFS_IBSUFDEVOLUCAO, NFS_IBSUFDIFERIMENTO, '
      '  NFS_IBSUFVALOR, NFS_IBSVALOR, NFS_IDDPS, '
      '  NFS_INFOADICIONAIS, NFS_INTERMEDIARIOCPFCNPJ, '
      '  NFS_INTERMEDIARIOIM, NFS_INTERMEDIARIONOME, NFS_LINK, '
      '  NFS_LOTE, NFS_MOVIMENTAFINANCEIRO, NFS_NUMERONOTA, '
      '  NFS_OBRAART, NFS_OBRACODIGO, NFS_OBSERVACOES, '
      '  NFS_PROTOCOLO, NFS_PROTOCOLODH, NFS_RECIBO, '
      '  NFS_RECIBODH, NFS_RETENCAO, NFS_RETENCAORESP, '
      '  NFS_SERIE, NFS_SIMPLESNACIONAL, NFS_STATUS, '
      '  NFS_TOMBAIRRO, NFS_TOMCEP, NFS_TOMCIDADE, '
      '  NFS_TOMCIDADECODIGO, NFS_TOMCNPJ, NFS_TOMCOMPLEMENTO, '
      '  NFS_TOMCONTATO, NFS_TOMCPF, NFS_TOMEMAIL, '
      '  NFS_TOMENDERECO, NFS_TOMESTADO, NFS_TOMESTADOCODIGO, '
      '  NFS_TOMFONE1, NFS_TOMFONE2, NFS_TOMIE, NFS_TOMIM, '
      '  NFS_TOMNOME, NFS_TOMNUMERO, NFS_TOMPAIS, '
      '  NFS_TOMPAISCODIGO, NFS_TOMSITE, NFS_TOMTIPOPESSOA, '
      '  NFS_TOTALDEDUCOES, NFS_TOTALDESCCOND, NFS_TOTALDESCINCOND, '
      '  NFS_TOTALIS, NFS_TOTALISS, NFS_TOTALSERVICOS, '
      
        '  NFS_TOTALTRIBUTOS, NFS_TOTALTRIBUTOSEST, NFS_TOTALTRIBUTOSFED,' +
        ' '
      '  NFS_TOTALTRIBUTOSIMP, NFS_TOTALTRIBUTOSMUN, NFS_USUARIO, '
      '  NFS_VALORCOFINS, NFS_VALORCREDITO, NFS_VALORCSLL, '
      '  NFS_VALORINSS, NFS_VALORIR, NFS_VALORISSRETIDO, '
      '  NFS_VALORLIQUIDO, NFS_VALOROUTRASRET, NFS_VALORPIS, '
      '  NFS_VALORTOTALRTC, NFS_VENDA, NFS_VENDEDOR)'
      
        'VALUES (:NEW_NFS_BAIXADATA, :NEW_NFS_BAIXAPOR, :NEW_NFS_BASEIBSC' +
        'BS, '
      
        '  :NEW_NFS_BASEIS, :NEW_NFS_BASEISS, :NEW_NFS_CANCELAMENTOCODIGO' +
        ', '
      
        '  :NEW_NFS_CANCELAMENTODATA, :NEW_NFS_CANCELAMENTOHORA, :NEW_NFS' +
        '_CANCELAMENTOMOTIVO, '
      
        '  :NEW_NFS_CBSCREDPRES, :NEW_NFS_CBSCREDPRESSUS, :NEW_NFS_CBSDEV' +
        'OLUCAO, '
      
        '  :NEW_NFS_CBSDIFERIMENTO, :NEW_NFS_CBSMONO, :NEW_NFS_CBSMONORET' +
        'ENCAO, '
      
        '  :NEW_NFS_CBSMONORETIDO, :NEW_NFS_CBSVALOR, :NEW_NFS_CHAVEACESS' +
        'O, '
      
        '  :NEW_NFS_CLIENTE, gen_id(GEN_NFSE,1), :NEW_NFS_CONDICAO, :NEW_' +
        'NFS_CONDICAOMEMO, '
      
        '  :NEW_NFS_CONSULTADA, :NEW_NFS_CSTISS, :NEW_NFS_DIAPREFERENCIAL' +
        ', '
      
        '  :NEW_NFS_DTATUALIZACAO, :NEW_NFS_DTCADASTRO, :NEW_NFS_DTEMISSA' +
        'O, '
      
        '  :NEW_NFS_FINALIDADE, :NEW_NFS_FORMAPAGTO, :NEW_NFS_GOVERNAMENT' +
        'AL, '
      '  :NEW_NFS_GOVERNAMENTALALIQRED, :NEW_NFS_GOVERNAMENTALOP, '
      
        '  :NEW_NFS_HRATUALIZACAO, :NEW_NFS_HRCADASTRO, :NEW_NFS_IBSCREDP' +
        'RES, '
      
        '  :NEW_NFS_IBSCREDPRESSUS, :NEW_NFS_IBSMONO, :NEW_NFS_IBSMONORET' +
        'ENCAO, '
      
        '  :NEW_NFS_IBSMONORETIDO, :NEW_NFS_IBSMUNDEVOLUCAO, :NEW_NFS_IBS' +
        'MUNDIFERIMENTO, '
      
        '  :NEW_NFS_IBSMUNVALOR, :NEW_NFS_IBSUFDEVOLUCAO, :NEW_NFS_IBSUFD' +
        'IFERIMENTO, '
      '  :NEW_NFS_IBSUFVALOR, :NEW_NFS_IBSVALOR, :NEW_NFS_IDDPS, '
      '  :NEW_NFS_INFOADICIONAIS, :NEW_NFS_INTERMEDIARIOCPFCNPJ, '
      
