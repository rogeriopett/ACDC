    SQL.Strings = (
      'select * from CTE'
      'left join CONDICOES on CTE_CONDICAO=CPG_CODIGO'
      'left join ICMS on CTE_CSTICMS=ICM_CODIGO'
      'left join VENDEDORES on CTE_VENDEDOR=VEN_CODIGO'
      'where CTE_CODIGO=:codigo'
