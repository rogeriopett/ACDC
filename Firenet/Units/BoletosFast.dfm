  object TR01: TFDTransaction
    Options.Isolation = xiReadCommitted
    Connection = DM.FDConnection1
    Left = 48
    Top = 208
  end
  object QY01: TFDQuery
    Connection = DM.FDConnection1
    Transaction = TR01
    SQL.Strings = (
      'select '
      'BOL_CODIGO,'
      'BOL_CLIENTE,'
      'BOL_NOME,'
      'BOL_DTCADASTRO,'
      'BOL_DTVENCIMENTO,'
      'BOL_DTPAGAMENTO,'
      'BOL_VALORITENS,'
      'BOL_VALORTOTAL,'
      'BOL_VALORPAGO,'
      'BOL_CONTA,'
      'CON_NOME'
      'from BOLETOS'
      'left join CONTAS on BOL_CONTA=CON_CODIGO'
      'where BOL_DTPAGAMENTO between :datainicial and :datafinal'
      'order by BOL_NOME, BOL_DTVENCIMENTO'
      '')
    Left = 48
    Top = 160
    ParamData = <
      item
        Name = 'DATAINICIAL'
        DataType = ftDate
        ParamType = ptInput
      end
      item
        Name = 'DATAFINAL'
        DataType = ftDate
        ParamType = ptInput
      end>
  end
  object TR10: TFDTransaction
    Options.Isolation = xiReadCommitted
    Connection = DM.FDConnection1
    Left = 336
    Top = 208
  end
  object QY10: TFDQuery
    Connection = DM.FDConnection1
    Transaction = TR10
    SQL.Strings = (
      'select '
      'BOL_ACEITE,'
      'BOL_CARTEIRA,'
      'BOL_CARTEIRACOD,'
      
        'coalesce(BOL_CEP,'#39#39')||'#39' - '#39'||coalesce(BOL_CIDADE,'#39#39')||'#39' - '#39'||coa' +
        'lesce(BOL_ESTADO,'#39#39') as CEPCIDADEUF,'
      'BOL_CLIENTE,'
      'iif(BOL_TIPOPESSOA='#39'J'#39',BOL_CNPJ,BOL_CPF) as CNPJCPF,'
      'BOL_CODIGO,'
      'BOL_CODIGOBARRAS,'
      'BOL_DESCVALOR,'
      'BOL_DTCADASTRO,'
      'BOL_DTVENCIMENTO,'
      
        'coalesce(BOL_ENDERECO,'#39#39')||'#39', '#39'||coalesce(BOL_NUMERO,'#39#39')||'#39' - '#39'|' +
        '|coalesce(BOL_COMPLEMENTO,'#39#39')||'#39' - '#39'||coalesce(BOL_BAIRRO,'#39#39') as' +
        ' ENDERECOBAIRRO,'
      'BOL_ESPECIE,'
      'BOL_ESPECIEDOC,'
      'BOL_ESTADO,'
      'BOL_INSTRUCAO1,'
      'BOL_INSTRUCAO2,'
      'BOL_INSTRUCAO3,'
      'BOL_INSTRUCAO4,'
      'BOL_LINHADIGITAVEL,'
      'BOL_LOCALPAGTO,'
      'BOL_NOME,'
      'BOL_NOSSONUMERO,'
      'BOL_OBSERVACOES,'
      'BOL_QRCODEPIX,'
      '(BOL_VALORJUROS+BOL_VALORMULTA) as MULTAJUROS,'
      'BOL_VALORTOTAL,'
      'CON_AGENCIA,'
      'CON_BANCO,'
      'CON_CONTA,'
      'CON_CONTADIGITO,'
      'CON_CEDENTE,'
      'CON_CEDENTEDIGITO,'
      'CON_CEDENTEDOC,'
      'CON_CEDENTENOME,'
      
        'coalesce(CON_AGENCIA,'#39#39')||'#39'-'#39'||coalesce(CON_AGENCIADIGITO,'#39#39')||'#39 +
        ' / '#39'||coalesce(CON_CEDENTE,'#39#39')||'#39'-'#39'||coalesce(CON_CEDENTEDIGITO,' +
        #39#39') as AGENCIACEDENTE,'
      
        'coalesce(CON_AGENCIA,'#39#39')||'#39'-'#39'||coalesce(CON_AGENCIADIGITO,'#39#39')||'#39 +
        ' / '#39'||coalesce(CON_CONTA,'#39#39')||'#39'-'#39'||coalesce(CON_CONTADIGITO,'#39#39') ' +
        'as AGENCIACONTA,'
      'current_date as DATAATUAL'
      'from BOLETOS'
      'left join CONTAS on BOL_CONTA=CON_CODIGO'
      'where BOL_CODIGO=:codigo'
      '')
    Left = 336
    Top = 160
    ParamData = <
      item
        Name = 'CODIGO'
        DataType = ftInteger
        ParamType = ptInput
      end>
  end
