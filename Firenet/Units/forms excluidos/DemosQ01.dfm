  object IBQuery1: TIBQuery
    Database = DM.IBDatabase1
    Transaction = IBTransaction1
    SQL.Strings = (
      'select '
      'DEM_CLIENTE, '
      'DEM_AULADATA,'
      'DEM_AULAHORA,'
      'DEM_TESTEESCRITO,'
      'DEM_TESTEORAL,'
      'DEM_NIVELESCRITO,'
      'DEM_NIVELORAL,'
      'DEM_STATUS,'
      'CLI_NOME,'
      'CLI_FONE1'
      'from DEMOS'
      'left join CLIENTES on DEM_CLIENTE=CLI_CODIGO'
      'where DEM_AULADATA between :datainicial and :datafinal '
      'order by DEM_AULADATA, DEM_AULAHORA, CLI_NOME')
    Left = 192
    Top = 224
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'datainicial'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'datafinal'
        ParamType = ptUnknown
      end>
  end
  object IBTransaction1: TIBTransaction
    DefaultDatabase = DM.IBDatabase1
    Params.Strings = (
      'read_committed'
      'rec_version'
      'nowait')
    Left = 128
    Top = 224
  end
