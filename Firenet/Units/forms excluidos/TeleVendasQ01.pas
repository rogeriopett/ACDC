  Total:=0; //nao zera o subtotal.
end;

procedure TFormTeleVendasQ01.QRSubDetail1AfterPrint(Sender: TQRCustomBand;
  BandPrinted: Boolean);
begin
  Total:=Total+1;
  SubTotal:=SubTotal+1;
end;

procedure TFormTeleVendasQ01.QRBand2BeforePrint(Sender: TQRCustomBand;
