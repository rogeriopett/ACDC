  object IBTransaction1: TIBTransaction
    DefaultDatabase = DM.IBDatabase1
    Params.Strings = (
      'read_committed'
      'rec_version'
      'nowait')
    Left = 128
    Top = 224
  end
  object IBQuery1: TIBQuery
    Database = DM.IBDatabase1
    Transaction = IBTransaction1
    BufferChunks = 1000
    CachedUpdates = False
    ParamCheck = True
    SQL.Strings = (
      'select'
      'CLI_CODIGO, '
      'CLI_NOME,'
      'VED_VENDEDOR,'
      'VEN_NOME,'
      'sum(VED_VALORTOTAL) as TOTAL'
      'from CLIENTES'
      'left join VENDAS on CLI_CODIGO=VED_CLIENTE'
      'left join VENDEDORES on VED_VENDEDOR=VEN_CODIGO'
      'where VED_DTEMISSAO between :datainicial and :datafinal'
      'group by VED_VENDEDOR, VEN_NOME, CLI_CODIGO, CLI_NOME'
      'order by TOTAL desc')
    Left = 192
    Top = 224
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'datainicial'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'datafinal'
        ParamType = ptUnknown
      end>
  end
