  object IBQuery2: TIBQuery
    Database = DM.IBDatabase1
    Transaction = IBTransaction2
    BufferChunks = 1000
    CachedUpdates = False
    ParamCheck = True
    SQL.Strings = (
      'select'
      'VED_CLIENTE,'
      'extract(MONTH from VED_DTEMISSAO) as MES,'
      'sum(VED_VALORTOTAL) as TOTAL'
      'from VENDAS '
      
        'where VED_CLIENTE=:codcliente and VED_DTEMISSAO between :dataini' +
        'cial and :datafinal'
      'group by VED_CLIENTE, extract(MONTH from VED_DTEMISSAO)'
      'order by MES')
    Left = 192
    Top = 280
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'codcliente'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'datainicial'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'datafinal'
        ParamType = ptUnknown
      end>
    object IBQuery2VED_CLIENTE: TIntegerField
      FieldName = 'VED_CLIENTE'
      Origin = '"VENDAS"."VED_CLIENTE"'
      Required = True
    end
    object IBQuery2MES: TSmallintField
      FieldName = 'MES'
      ProviderFlags = []
    end
    object IBQuery2TOTAL: TFMTBCDField
      FieldName = 'TOTAL'
      ProviderFlags = []
      currency = True
      Precision = 18
    end
  end
