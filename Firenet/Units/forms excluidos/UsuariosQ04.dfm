  object IBQuery1: TIBQuery
    Database = DM.IBDatabase1
    Transaction = IBTransaction1
    SQL.Strings = (
      'select * from ACESSOS'
      'left join TELAS on ACE_TELA=TEL_NOMEFORM'
      'where ACE_USUARIO=:usuario and TEL_STATUS='#39'A'#39
      'order by TEL_DESCRICAO, ACE_DESCRICAO')
