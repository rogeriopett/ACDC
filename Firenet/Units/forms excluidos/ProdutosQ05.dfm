  object IBQuery1: TIBQuery
    Database = DM.IBDatabase1
    Transaction = IBTransaction1
    BufferChunks = 1000
    CachedUpdates = False
    ParamCheck = True
    SQL.Strings = (
      'select '
      'PRO_CODIGO,'
      'PRO_CODIGOFAB,'
      'PRO_ESTOQUEATUAL,'
      'PRO_ESTOQUEMAX,'
      'PRO_ESTOQUEMIN,'
      'PRO_FAMILIA,'
      'PRO_GRUPO,'
      'PRO_NOME,'
      'PRO_PRECOCUSTO,'
      'PRO_UNIDADE,'
      'GRU_DESCRICAO,'
      'FAM_DESCRICAO'
      'from PRODUTOS'
      'left join FAMILIAS on PRO_FAMILIA=FAM_CODIGO'
      'left join GRUPOS on PRO_GRUPO=GRU_CODIGO'
      'where PRO_STATUS='#39'A'#39
      'order by FAM_DESCRICAO, GRU_DESCRICAO, PRO_NOME')
    Left = 192
    Top = 280
