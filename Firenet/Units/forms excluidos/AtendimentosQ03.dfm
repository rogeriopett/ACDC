      'left join CLIENTES on ATE_CLIENTE=CLI_CODIGO'
      'left join CURSOS on ATE_CURSO=CUR_CODIGO'
      
        'where ATE_TESTEORAL='#39'S'#39' and ATE_TESTEORALDATA between :datainici' +
        'al and :datafinal '
