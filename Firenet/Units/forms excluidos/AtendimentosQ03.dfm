    SQL.Strings = (
      'select '
      'ATE_CLIENTE, '
      'ATE_TESTEORAL,'
      'ATE_TESTEORALDATA,'
      'ATE_TESTEORALHORA,'
      'CLI_NOME,'
      'CLI_FONE1,'
