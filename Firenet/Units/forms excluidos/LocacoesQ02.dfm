  object IBQuery1: TIBQuery
    Database = DM.IBDatabase1
    Transaction = IBTransaction1
    BufferChunks = 1000
    CachedUpdates = False
    ParamCheck = True
    SQL.Strings = (
      'select '
      'LOC_CODIGO,'
      'LOC_OBJETO,'
      'LOC_CLIENTE,'
      'OBJ_DESCRICAO,'
      'OBJ_SERIAL,'
      'LOC_DATA,'
      'LOC_DATAPREVISAO,'
      'LOC_DATADEVOLUCAO,'
      'LOC_TIPO,'
      'LOC_STATUS,'
      'CLI_NOME'
      'from LOCACOES'
      'left join CLIENTES on LOC_CLIENTE=CLI_CODIGO'
      'left join OBJETOS on LOC_OBJETO=OBJ_CODIGO'
      'order by CLI_NOME, LOC_DATA desc')
    Left = 184
    Top = 240
  end
