  object IBQuery1: TIBQuery
    Database = DM.IBDatabase1
    Transaction = IBTransaction1
    BufferChunks = 1000
    CachedUpdates = False
    ParamCheck = True
    SQL.Strings = (
      'select '
      'PRC_PRODUTO,'
      'PRC_PRODUTOCOMP,'
      'PRC_QUANTIDADE,'
      'PRO_NOME'
      'from PRODUTOSCOMP'
      'left join PRODUTOS on PRC_PRODUTOCOMP=PRO_CODIGO'
      'where PRC_PRODUTOCOMP=:codigo'
      'order by PRC_PRODUTOCOMP, PRO_NOME')
