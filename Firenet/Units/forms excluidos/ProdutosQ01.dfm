  object IBQuery1: TIBQuery
    Database = DM.IBDatabase1
    Transaction = IBTransaction1
    BufferChunks = 1000
    CachedUpdates = False
    ParamCheck = True
    SQL.Strings = (
      'select '
      'PRO_CODIGO,'
      'PRO_NOME,'
      'PRO_PRECOVENDA,'
      'PRO_ESTOQUEMIN,'
      'PRO_ESTOQUEMAX,'
      'PRO_ESTOQUEATUAL,'
      'PRO_FAMILIA,'
      'PRO_GRUPO,'
      'PRO_DTCADASTRO,'
      'PRO_FORNECEDOR,'
      'FAM_DESCRICAO,'
      'GRU_DESCRICAO,'
      'MAR_DESCRICAO from PRODUTOS'
      'left join FAMILIAS on PRO_FAMILIA=FAM_CODIGO'
      'left join GRUPOS on PRO_GRUPO=GRU_CODIGO'
      'left join MARCAS on PRO_MARCA=MAR_CODIGO'
      'order by FAM_DESCRICAO, GRU_DESCRICAO, PRO_NOME')
