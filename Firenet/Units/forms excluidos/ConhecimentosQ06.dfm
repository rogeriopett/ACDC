  object IBQuery1: TIBQuery
    Database = DM.IBDatabase1
    Transaction = IBTransaction1
    BufferChunks = 1000
    CachedUpdates = False
    ParamCheck = True
    SQL.Strings = (
      'select '
      'CTE_ALIQICMS,'
      'CTE_ALIQICMSST,'
      'CTE_CODIGO,'
      'CTE_DTEMISSAO,'
      'CTE_DESNOME,'
      'CTE_STATUS,'
      'CTE_CHAVEACESSO,'
      'case CTE_STATUS'
      '  when '#39'A'#39' then '#39'ABERTO'#39
      '  when '#39'F'#39' then '#39'FINALIZADO'#39
      '  when '#39'C'#39' then '#39'CANCELADO'#39'   '
      '  when '#39'I'#39' then '#39'INUTILIZADO'#39
      ' end'
      'as STATUS,'
      'CTE_REMNOME,'
      'CTE_TOTALICMS,'
      'CTE_TOTALICMSST,'
      'CTE_VALORTOTAL'
      'from CTE'
      
        'where CTE_STATUS='#39'F'#39' and CTE_DTEMISSAO between :datainicial and ' +
        ':datafinal'
      'order by CTE_STATUS, CTE_DTEMISSAO, CTE_CODIGO desc')
    Left = 192
    Top = 224
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'datainicial'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'datafinal'
        ParamType = ptUnknown
      end>
    object IBQuery1CTE_CODIGO: TIntegerField
      FieldName = 'CTE_CODIGO'
      Origin = '"CTE"."CTE_CODIGO"'
      ProviderFlags = [pfInUpdate, pfInWhere, pfInKey]
      Required = True
