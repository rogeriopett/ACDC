  object IBQuery1: TIBQuery
    Database = DM.IBDatabase1
    Transaction = IBTransaction1
    BufferChunks = 1000
    CachedUpdates = False
    ParamCheck = True
    SQL.Strings = (
      
        'select CLI_CODIGO, CLI_NOME, CLI_VENDEDOR, CLI_FONE1, CLI_FONE2,' +
        ' CLI_FONE3, CLI_CIDADE, CLI_ESTADO, CLI_STATUS, CLI_ATIVIDADE, V' +
        'EN_NOME, ATI_DESCRICAO from CLIENTES'
      'left join ATIVIDADES on CLI_ATIVIDADE=ATI_CODIGO'
      'left join VENDEDORES on CLI_VENDEDOR=VEN_CODIGO'
      'order by ATI_DESCRICAO, CLI_NOME')
