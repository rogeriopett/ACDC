  object IBQuery1: TIBQuery
    Database = DM.IBDatabase1
    Transaction = IBTransaction1
    BufferChunks = 1000
    CachedUpdates = False
    ParamCheck = True
    SQL.Strings = (
      'select '
      'BOL_CODIGO,'
      'BOL_CLIENTE,'
      'BOL_NOME,'
      'BOL_DTVENCIMENTO,'
      'BOL_DTPAGAMENTO,'
      'BOL_VALORITENS,'
      'BOL_VALORBOLETO,'
      'BOL_VALORTOTAL,'
      'BOL_VALORPAGO,'
      'BOL_CONTA,'
      'CON_NOME'
      'from BOLETOS'
      'left join CONTAS on BOL_CONTA=CON_CODIGO'
      
        'where BOL_STATUS='#39'A'#39' and BOL_DTPAGAMENTO between :datainicial an' +
        'd :datafinal'
      'order by BOL_NOME, BOL_DTVENCIMENTO')
    Left = 192
    Top = 224
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'datainicial'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'datafinal'
        ParamType = ptUnknown
      end>
    object IBQuery1BOL_CODIGO: TIntegerField
      FieldName = 'BOL_CODIGO'
      Origin = '"BOLETOS"."BOL_CODIGO"'
      ProviderFlags = [pfInUpdate, pfInWhere, pfInKey]
      Required = True
    end
