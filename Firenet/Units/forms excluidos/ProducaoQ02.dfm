    MasterSource = DataSource1
    MasterFields = 'PRD_CODIGO'
    Connection = DM.FDConnection1
    Transaction = FDTransaction2
    SQL.Strings = (
      'select '
      'PDI_PRODUTO,'
      'PDI_QUANTIDADE,'
      'PDI_ALMOXARIFADO,'
      'PRO_NOME'
      'from PRODUCAOITENS'
      'left join PRODUTOS on PDI_PRODUTO=PRO_CODIGO'
      'where PDI_PRODUCAO=:PRD_CODIGO'
      'order by PRO_NOME'
      '')
    Left = 240
