  object FDQuery1: TFDQuery
    Connection = DM.FDConnection1
    Transaction = FDTransaction1
    SQL.Strings = (
      'select '
      'PRD_CODIGO,'
      'PRD_CLIENTE,'
      'PRD_DTCADASTRO,'
      'PRD_DATABAIXA,'
      'PRD_DTPREVISAO,'
      'PRD_STATUS,'
      'CLI_NOME'
      'from PRODUCAO'
      'left join CLIENTES on PRD_CLIENTE=CLI_CODIGO'
      'order by PRD_CLIENTE'
      '')
    Left = 240
    Top = 304
  end
