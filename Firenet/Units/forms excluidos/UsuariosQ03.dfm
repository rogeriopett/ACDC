  object IBTransaction1: TIBTransaction
    DefaultDatabase = DM.IBDatabase1
    Params.Strings = (
      'read_committed'
      'rec_version'
      'nowait')
    Left = 168
    Top = 184
  end
  object IBQuery1: TIBQuery
    Database = DM.IBDatabase1
    Transaction = IBTransaction1
    SQL.Strings = (
      
        'select LOG_USUARIO, LOG_NOME, sum(LOG_TEMPO) as TotalTempo from ' +
        'LOGS where LOG_DATA between :datainicial and :datafinal'
      'group by LOG_USUARIO, LOG_NOME'
      'order by 3 desc')
    Left = 240
    Top = 184
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'datainicial'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'datafinal'
        ParamType = ptUnknown
      end>
    object IBQuery1TOTALTEMPO: TLargeintField
      FieldName = 'TOTALTEMPO'
    end
    object IBQuery1LOG_USUARIO: TIBStringField
      FieldName = 'LOG_USUARIO'
    end
    object IBQuery1LOG_NOME: TIBStringField
      FieldName = 'LOG_NOME'
      Size = 50
    end
  end
