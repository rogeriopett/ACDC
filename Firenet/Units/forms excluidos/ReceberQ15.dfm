  object IBQuery1: TIBQuery
    Database = DM.IBDatabase1
    Transaction = IBTransaction1
    BufferChunks = 1000
    CachedUpdates = False
    ParamCheck = True
    SQL.Strings = (
      'select '
      'REE_CLIENTE,'
      'REE_CODIGO,'
      'REE_DTEMISSAO,'
      'REE_DTVENCIMENTO,'
      'REE_NUMDOCTO,'
      'REE_STATUS,'
      'REE_TIPODOCTO,'
      'REE_VALOR,'
      'REE_VENDEDOR,'
      'CLI_NOME'
      'from RECEBER'
      'left join CLIENTES on REE_CLIENTE=CLI_CODIGO'
      'where REE_DTVENCIMENTO between :datainicial and :datafinal'
      'order by REE_TIPODOCTO, CLI_NOME')
    Left = 192
    Top = 224
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'datainicial'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'datafinal'
        ParamType = ptUnknown
      end>
    object IBQuery1REE_CLIENTE: TIntegerField
