  object IBQuery1: TIBQuery
    Database = DM.IBDatabase1
    Transaction = IBTransaction1
    BufferChunks = 1000
    CachedUpdates = False
    ParamCheck = True
    SQL.Strings = (
      'select '
      'PCS_CODIGO,'
      'PCS_ACAO,'
      'PCS_ADVOGADO,'
      'PCS_DESCRICAO,'
      'PCS_DTCADASTRO,'
      'PCS_FORO,'
      'PCS_LOCALFISICO,'
      'PCS_NUMEROANTIGO,'
      'PCS_NUMEROUNIFICADO,'
      'PCS_NUMEROUNIFICADOFED,'
      'PCS_STATUS,'
      'PCS_TOTALLANCAMENTOS,'
      'ACO_DESCRICAO,'
      'FRS_NOME,'
      'VEN_NOME from PROCESSOS'
      'left join ACOES on PCS_ACAO=ACO_CODIGO'
      'left join FOROS on PCS_FORO=FRS_CODIGO'
      'left join VENDEDORES on PCS_ADVOGADO=VEN_CODIGO'
      'where PCS_CODIGO=:codigo'
      'order by VEN_NOME, PCS_CODIGO')
    Left = 200
    Top = 536
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'codigo'
        ParamType = ptUnknown
      end>
