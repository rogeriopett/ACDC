  object IBQuery2: TIBQuery
    Database = DM.IBDatabase1
    Transaction = IBTransaction2
    BufferChunks = 1000
    CachedUpdates = False
    DataSource = DataSource1
    ParamCheck = True
    SQL.Strings = (
      'select '
      'PSP_CODIGO,'
      'PSP_ADVOGADO,'
      'PSP_CLIENTE,'
      'PSP_CONDICAO,'
      'PSP_PROCESSO,'
      'cli.CLI_NOME as PARTE,'
      'adv.CLI_NOME as ADVOGADO'
      'from PROCESSOSPARTES'
      'left join CLIENTES cli on PSP_CLIENTE=cli.CLI_CODIGO'
      'left join CLIENTES adv on PSP_ADVOGADO=adv.CLI_CODIGO'
      'where PSP_PROCESSO=:PCS_CODIGO'
      'order by cli.CLI_NOME'
      '')
    Left = 200
    Top = 592
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'PCS_CODIGO'
        ParamType = ptUnknown
      end>
