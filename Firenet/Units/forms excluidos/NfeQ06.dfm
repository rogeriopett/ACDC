  object IBQuery1: TIBQuery
    Database = DM.IBDatabase1
    Transaction = IBTransaction1
    BufferChunks = 1000
    CachedUpdates = False
    ParamCheck = True
    SQL.Strings = (
      'select'
      'T.ANTERIOR + 1 as DE,'
      'T.NFE_CODIGO - 1 as ATE'
      'from ('
      '  select'
      
        '    (select first 1 D.NFE_CODIGO from NFE D where D.NFE_CODIGO <' +
        ' F.NFE_CODIGO order by D.nfe_codigo desc) as ANTERIOR,'
      '    F.NFE_CODIGO'
      '  from NFE F'
      '  order by F.NFE_CODIGO) T'
      'where coalesce(T.ANTERIOR,0) <> T.NFE_CODIGO -1')
    Left = 192
    Top = 224
    object IBQuery1DE: TLargeintField
      FieldName = 'DE'
      ProviderFlags = []
      ReadOnly = True
    end
    object IBQuery1ATE: TLargeintField
      FieldName = 'ATE'
      ProviderFlags = []
      ReadOnly = True
    end
  end
