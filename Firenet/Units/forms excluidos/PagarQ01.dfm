  end
  object IBQuery1: TIBQuery
    Database = DM.IBDatabase1
    Transaction = IBTransaction1
    BufferChunks = 1000
    CachedUpdates = False
    ParamCheck = True
    SQL.Strings = (
      'select '
      'PAG_CODIGO,'
      'PAG_CONTA,'
      'PAG_DESCRICAO,'
      'PAG_DESPESA,'
      'PAG_DTEMISSAO,'
      'PAG_DTVENCIMENTO,'
      'PAG_FORNECEDOR,'
      'PAG_TIPODOCTO,'
      'PAG_NUMDOCTO,'
      'PAG_VALOR,'
      'FOR_NOME,'
      'DES_DESCRICAO'
      'from PAGAR'
      'left join DESPESAS on PAG_DESPESA=DES_CODIGO'
      'left join FORNECEDORES on PAG_FORNECEDOR=FOR_CODIGO'
      'where PAG_DTVENCIMENTO between :datainicial and :datafinal'
      'group by PAG_FORNECEDOR, '
      'PAG_CODIGO,'
      'PAG_CONTA,'
      'PAG_DESCRICAO,'
      'PAG_DESPESA,'
      'PAG_DTEMISSAO,'
      'PAG_DTVENCIMENTO,'
      'PAG_TIPODOCTO,'
      'PAG_NUMDOCTO,'
      'PAG_VALOR,'
      'FOR_NOME,'
      'DES_DESCRICAO'
      'order by PAG_FORNECEDOR, PAG_DTVENCIMENTO')
    Left = 192
    Top = 224
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'datainicial'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'datafinal'
        ParamType = ptUnknown
      end>
