procedure TFormGnreQ01.DetailBand1BeforePrint(Sender: TQRCustomBand; var PrintBand: Boolean);
var S: String;
begin
  S:=IBQuery1GNR_REPNUMERICA.Value;
  Insert(' ',S,12);
  Insert('  ',S,14);
  Insert(' ',S,27);
  Insert('  ',S,29);
  Insert(' ',S,42);
  Insert('  ',S,44);
  Insert(' ',S,57);
  QRLabel30.Caption:=S;
  QRLabel61.Caption:=S;
  QRLabel92.Caption:=S;

  QRAsBarCode1.Text:=IBQuery1GNR_CODIGOBARRAS.Value;
  QRAsBarCode2.Text:=IBQuery1GNR_CODIGOBARRAS.Value;
  QRAsBarCode3.Text:=IBQuery1GNR_CODIGOBARRAS.Value;

  if IBQuery1GNR_CHAVEACESSO.Value<>'' then
  begin
    QRLabel94.Caption:='CHAVE DA NFE: '+IBQuery1GNR_CHAVEACESSO.Value;
    QRLabel95.Caption:='CHAVE DA NFE: '+IBQuery1GNR_CHAVEACESSO.Value;
    QRLabel96.Caption:='CHAVE DA NFE: '+IBQuery1GNR_CHAVEACESSO.Value;
  end;

  QRLabel94.Caption:=QRLabel94.Caption+#13#10+IBQuery1GNR_INFOCOMPLEMENTAR.Value;
  QRLabel95.Caption:=QRLabel95.Caption+#13#10+IBQuery1GNR_INFOCOMPLEMENTAR.Value;
  QRLabel96.Caption:=QRLabel96.Caption+#13#10+IBQuery1GNR_INFOCOMPLEMENTAR.Value;

  QRLabel97.Caption:=Copy(IBQuery1GNR_RECEITA.Value,1,6);
  QRLabel98.Caption:=Copy(IBQuery1GNR_RECEITA.Value,1,6);
  QRLabel99.Caption:=Copy(IBQuery1GNR_RECEITA.Value,1,6);
end;

