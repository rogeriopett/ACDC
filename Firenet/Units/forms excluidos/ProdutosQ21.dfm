  object IBTransaction1: TIBTransaction
    DefaultDatabase = DM.IBDatabase1
    Params.Strings = (
      'read_committed'
      'rec_version'
      'nowait')
    Left = 128
    Top = 224
  end
  object IBQuery1: TIBQuery
    Database = DM.IBDatabase1
    Transaction = IBTransaction1
    BufferChunks = 1000
    CachedUpdates = False
    ParamCheck = True
    SQL.Strings = (
      'select '
      'A.PRO_CODIGO,'
      'A.PRO_NOME,'
      'A.PRO_PRODUTOREAL,'
      'B.PRO_NOME as PRO_NOMEREAL'
      'from PRODUTOS A'
      'left join PRODUTOS B on A.PRO_PRODUTOREAL=B.PRO_CODIGO'
      'where A.PRO_PRODUTOREAL<>0'
      'order by A.PRO_NOME')
    Left = 192
    Top = 224
  end
