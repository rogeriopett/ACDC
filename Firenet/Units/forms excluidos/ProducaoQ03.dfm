  object FDQuery1: TFDQuery
    Connection = DM.FDConnection1
    Transaction = FDTransaction1
    SQL.Strings = (
      'select '
      'PDI_ALMOXARIFADO,'
      'PDI_PRODUTO,'
      'PDI_QUANTIDADE,'
      'ALM_DESCRICAO,'
      'FAM_DESCRICAO,'
      'GRU_DESCRICAO,'
      'PRO_LOCALIZACAO,'
      'PRO_NOME'
      'from PRODUCAOITENS'
      'left join PRODUTOS on PDI_PRODUTO=PRO_CODIGO'
      'left join FAMILIAS on PRO_FAMILIA=FAM_CODIGO'
      'left join GRUPOS on PRO_GRUPO=GRU_CODIGO'
      'left join ALMOXARIFADOS on PDI_ALMOXARIFADO=ALM_CODIGO'
      'where PDI_PRODUCAO=:codigo'
      'order by PRO_NOME'
      '')
    Left = 176
    Top = 280
    ParamData = <
      item
        Name = 'CODIGO'
        DataType = ftInteger
        ParamType = ptInput
      end>
