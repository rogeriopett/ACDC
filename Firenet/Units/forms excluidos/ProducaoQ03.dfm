  object FDQuery2: TFDQuery
    MasterSource = DataSource1
    MasterFields = 'PDI_PRODUTO'
    Connection = DM.FDConnection1
    Transaction = FDTransaction2
    SQL.Strings = (
      'select '
      'PRO_LOCALIZACAO,'
      'PRO_NOME,'
      'PRO_UNIDADE,'
      'PRC_PRODUTO, '
      'PRC_PRODUTOCOMP, '
      'PRC_QUANTIDADE'
      'from PRODUTOSCOMP'
