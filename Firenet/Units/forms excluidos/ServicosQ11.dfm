  object IBQuery1: TIBQuery
    Database = DM.IBDatabase1
    Transaction = IBTransaction1
    BufferChunks = 1000
    CachedUpdates = False
    ParamCheck = True
    SQL.Strings = (
      'select '
      'SER_CODIGO, '
      'SER_CLIENTE, '
      'SER_DTENTRADA,'
      'SER_DTPREVISAO, '
      'SER_DTSAIDA, '
      'SER_MARCA, '
      'SER_MODELO, '
      'SER_PRODUTO,'
      'SER_SERIE, '
      'SER_STATUS, '
      'SER_VALORTOTAL,'
      'CLI_NOME'
      'from SERVICOS'
      'left join CLIENTES on SER_CLIENTE=CLI_CODIGO'
      'order by CLI_NOME, SER_CLIENTE, SER_CODIGO')
