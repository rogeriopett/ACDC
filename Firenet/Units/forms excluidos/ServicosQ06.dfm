  object IBQuery1: TIBQuery
    Database = DM.IBDatabase1
    Transaction = IBTransaction1
    BufferChunks = 1000
    CachedUpdates = False
    ParamCheck = True
    SQL.Strings = (
      'select '
      'SER_ACESSORIOS,'
      'SER_CODIGO,'
      'SER_CONSERTO,'
      'SER_DEFEITO,'
      'SER_DTENTRADA,'
      'SER_DTNOTAFISCAL,'
      'SER_DTPREVISAO,'
      'SER_DTSAIDA,'
      'SER_MARCA,'
      'SER_MODELO,'
      'SER_NUMERONF,'
      'SER_PRODUTO,'
      'SER_SENHAONLINE,'
      'SER_SERIE,'
      'SER_TECNICO,'
      'SER_VALORTOTAL,'
      'CLI_BAIRRO,'
      'CLI_CEP,'
      'CLI_CIDADE||'#39' - '#39'||CLI_ESTADO as CLI_CIDADE,'
      'CLI_CNPJ,'
      'CLI_CODIGO,'
      'CLI_COMPLEMENTO,'
      'CLI_CONTATO,'
      'CLI_CPF,'
      'CLI_ENDERECO,'
      'CLI_FONE1,'
      'CLI_NOME,'
      'CLI_NUMERO,'
      'VEN_NOME'
      'from SERVICOS'
      'left join CLIENTES on SER_CLIENTE=CLI_CODIGO'
      'left join VENDEDORES on SER_TECNICO=VEN_CODIGO'
      'where SER_CODIGO=:codigo')
    Left = 208
    Top = 352
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'codigo'
        ParamType = ptUnknown
      end>
