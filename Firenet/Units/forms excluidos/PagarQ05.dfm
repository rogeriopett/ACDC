      'read_committed'
      'rec_version'
      'nowait')
    Left = 136
    Top = 392
  end
  object IBQuery1: TIBQuery
    Database = DM.IBDatabase1
    Transaction = IBTransaction1
    BufferChunks = 1000
    CachedUpdates = False
    ParamCheck = True
    SQL.Strings = (
      
        'select '#39'CONTAS A PAGAR'#39' as PAGREC, AGR_CODIGO, AGR_DESCRICAO, PA' +
        'G_DESPESA as CODIGO, DES_DESCRICAO as DESCRICAO, sum(PAG_VALOR) ' +
        'as VALOR from PAGAR'
      'left join DESPESAS on PAG_DESPESA=DES_CODIGO'
      'left join AGRUPADORES on DES_AGRUPADOR=AGR_CODIGO'
      
        'where PAG_STATUS='#39'B'#39' and PAG_DTPAGAMENTO between :datainicial an' +
        'd :datafinal'
      'group by AGR_CODIGO, PAG_DESPESA, DES_DESCRICAO, AGR_DESCRICAO'
      ''
      'union all'
      ''
      
        'select '#39'CONTAS A RECEBER'#39' as PAGREC, AGR_CODIGO, AGR_DESCRICAO, ' +
        'REE_RECEITA as CODIGO, REC_DESCRICAO as DESCRICAO, sum(REE_VALOR' +
        ') as VALOR from RECEBER'
      'left join RECEITAS on REE_RECEITA=REC_CODIGO'
      'left join AGRUPADORES on REC_AGRUPADOR=AGR_CODIGO'
      
        'where REE_STATUS='#39'B'#39' and REE_DTPAGAMENTO between :datainicial an' +
        'd :datafinal'
      'group by AGR_CODIGO, REE_RECEITA, REC_DESCRICAO, AGR_DESCRICAO'
      ''
      'order by 1, 3, 5')
    Left = 200
    Top = 392
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'datainicial'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'datafinal'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'datainicial'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'datafinal'
        ParamType = ptUnknown
      end>
    object IBQuery1PAGREC: TIBStringField
      FieldName = 'PAGREC'
      ProviderFlags = []
      FixedChar = True
      Size = 16
    end
    object IBQuery1AGR_CODIGO: TIntegerField
