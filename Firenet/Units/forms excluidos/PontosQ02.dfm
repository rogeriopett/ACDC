  object IBQuery1: TIBQuery
    Database = DM.IBDatabase1
    Transaction = IBTransaction1
    BufferChunks = 1000
    CachedUpdates = False
    ParamCheck = True
    SQL.Strings = (
      'select '
      'PTS_CLIENTE,'
      'sum(PTS_VALOR) as VALORTOTAL,'
      'sum(PTS_PONTOS) as TOTALPONTOS,'
      'CLI_NOME,'
      'CLI_PONTOS'
      'from PONTOS'
      'left join CLIENTES on PTS_CLIENTE=CLI_CODIGO'
      'where PTS_DTCADASTRO between :datainicial and :datafinal'
      'and PTS_ENTRADASAIDA='#39'E'#39
      'group by PTS_CLIENTE, CLI_NOME, CLI_PONTOS'
      'order by CLI_NOME')
