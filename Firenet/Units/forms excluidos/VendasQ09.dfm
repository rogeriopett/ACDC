    BufferChunks = 1000
    CachedUpdates = False
    ParamCheck = True
    SQL.Strings = (
      'select VEI_VENDA, '
      'VEI_PRODUTO,'
      'PRO_NOME,'
      'PRO_GRUPO,'
      'GRU_DESCRICAO,'
      'VED_CODIGO,'
      'VED_NOME,'
      'VED_DTEMISSAO,'
      'VED_TABELAPRECO,'
      'VEI_QUANTIDADE,'
      'VEI_VALORUNIT,'
