  object FDQuery1: TFDQuery
    Connection = DM.FDConnection1
    Transaction = FDTransaction1
    SQL.Strings = (
      'select '
      'PDI_PRODUTO,'
      'sum(PDI_QUANTIDADE) as QTDE,'
      'PRO_NOME'
      'from PRODUCAOITENS'
