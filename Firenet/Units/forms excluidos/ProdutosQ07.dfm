  object IBQuery1: TIBQuery
    Database = DM.IBDatabase1
    Transaction = IBTransaction1
    BufferChunks = 1000
    CachedUpdates = False
    ParamCheck = True
    SQL.Strings = (
      'select '
      'PRQ_PRODUTO, '
      'sum(PRQ_QUANTIDADE) as TOTALALMOXARIFADOS,'
      'PRO_ESTOQUEATUAL,'
      'PRO_NOME '
      'from PRODUTOSQTDE'
      'left join PRODUTOS on PRQ_PRODUTO=PRO_CODIGO'
      'group by PRQ_PRODUTO, PRO_ESTOQUEATUAL, PRO_NOME'
      'having sum(PRQ_QUANTIDADE)<>PRO_ESTOQUEATUAL'
      'order by PRO_NOME')
    Left = 176
    Top = 184
    object IBQuery1PRQ_PRODUTO: TIntegerField
      FieldName = 'PRQ_PRODUTO'
      Origin = '"PRODUTOSQTDE"."PRQ_PRODUTO"'
      ProviderFlags = [pfInUpdate, pfInWhere, pfInKey]
      Required = True
    end
    object IBQuery1PRO_ESTOQUEATUAL: TFMTBCDField
