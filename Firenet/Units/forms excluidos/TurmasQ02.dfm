  object FDQuery1: TFDQuery
    Connection = DM.FDConnection1
    Transaction = FDTransaction1
    SQL.Strings = (
      'select '
      'MAT_CODIGO,'
      'MAT_CLIENTE,'
      'MAT_TURMA,'
      'CLI_NOME,'
      'TUR_DESCRICAO,'
      'TUR_PROFESSOR,'
      'TUR_SALA,'
      'TUR_DTINICIO,'
      'TUR_DTTERMINO,'
      'TUR_HORARIO,'
      'TUR_DOMINGO,'
      'TUR_SEGUNDA,'
      'TUR_TERCA,'
      'TUR_QUARTA,'
      'TUR_QUINTA,'
      'TUR_SEXTA,'
      'TUR_SABADO,'
      'TUR_PERIODO,'
      'TUR_ANO,'
      'TUR_ENCONTROS,'
      'VEN_NOME'
      'from MATRICULAS '
      'left join CLIENTES on MAT_CLIENTE=CLI_CODIGO'
      'left join TURMAS on MAT_TURMA=TUR_CODIGO'
      'left join VENDEDORES on TUR_PROFESSOR=VEN_CODIGO'
      'where MAT_STATUS='#39'A'#39
      'order by MAT_TURMA, CLI_NOME'
      '')
    Left = 208
    Top = 312
  end
