  object IBQuery1: TIBQuery
    Database = DM.IBDatabase1
    Transaction = IBTransaction1
    BufferChunks = 1000
    CachedUpdates = False
    ParamCheck = True
    SQL.Strings = (
      'select'
      'CHE_CODIGO,'
      'CHE_CLIENTE,'
      'CHE_BANCO,'
      'CHE_AGENCIA,'
      'CHE_CONTA,'
      'CHE_NUMERO,'
      'CHE_PREDATADO,'
      'CHE_BOMPARA,'
      'CHE_VALOR,'
      'CHE_DTCADASTRO,'
      'CHE_STATUS,'
      'CLI_NOME,'
      'BAN_NOME'
      'from CHEQUES'
      'left join CLIENTES on CHE_CLIENTE=CLI_CODIGO'
      'left join BANCOS on CHE_BANCO=BAN_CODIGO'
      'order by CLI_NOME')
    Left = 192
    Top = 224
