  object FDQuery1: TFDQuery
    Connection = DM.FDConnection1
    Transaction = FDTransaction1
    SQL.Strings = (
      'select '
      'PDI_PRODUTO, PRO_NOME, sum(PDI_QUANTIDADE) as TOTAL'
      'from PRODUCAOITENS'
      'left join PRODUCAO on PDI_PRODUCAO=PRD_CODIGO'
      'left join PRODUTOS on PDI_PRODUTO=PRO_CODIGO'
      
        'where PRD_STATUS='#39'A'#39' and PRD_DTCADASTRO between :datainicial and' +
        ' :datafinal'
      'group by PDI_PRODUTO, PRO_NOME'
      '')
    Left = 144
    Top = 304
    ParamData = <
      item
        Name = 'DATAINICIAL'
        DataType = ftDate
        ParamType = ptInput
      end
      item
        Name = 'DATAFINAL'
        DataType = ftDate
        ParamType = ptInput
      end>
    object FDQuery1PDI_PRODUTO: TIntegerField
