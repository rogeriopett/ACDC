  object FDQuery1: TFDQuery
    Connection = DM.FDConnection1
    Transaction = FDTransaction1
    SQL.Strings = (
      'select '
      'MDF_CHAVEACESSO, '
      'MDF_CODIGO, '
      'MDF_DTEMISSAO,'
      'MDF_PESOBRUTO, '
      'MDF_QTDECTE, '
      'MDF_QTDENFE, '
      'MDF_QTDEMDFE,'
      'MDF_STATUS,'
      'case MDF_STATUS'
      '  when '#39'A'#39' then '#39'ABERTO'#39
      '  when '#39'C'#39' then '#39'CANCELADO'#39
      '  when '#39'F'#39' then '#39'FINALIZADO'#39
      '  when '#39'V'#39' then '#39'VIGENCIA'#39
      'end as MDF_STATUSDESC,'
      'MDF_VALORCARGA'
      'from MDFE'
      'where MDF_DTEMISSAO between :datainicial and :datafinal'
      'order by MDF_STATUS, MDF_DTEMISSAO, MDF_CODIGO desc'
      '')
    Left = 192
    Top = 224
    ParamData = <
      item
        Name = 'DATAINICIAL'
        DataType = ftDate
        ParamType = ptInput
