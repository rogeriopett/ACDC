  object IBQuery1: TIBQuery
    Database = DM.IBDatabase1
    Transaction = IBTransaction1
    SQL.Strings = (
      'select TEV_CODIGO, TEV_CLIENTE, TEV_DATA, TEV_DATAPROX,'
      'TEV_BAIXADOPOR, TEV_DATABAIXA,'
      'TEV_VENDEDOR, TEV_HORARIO, CLI_NOME, VEN_NOME from TELEVENDAS'
      'left join CLIENTES on TEV_CLIENTE=CLI_CODIGO'
      'left join VENDEDORES on TEV_VENDEDOR=VEN_CODIGO'
      'where TEV_STATUS='#39'A'#39
      'order by VEN_NOME, TEV_CLIENTE, TEV_DATAPROX')
    Left = 192
    Top = 224
