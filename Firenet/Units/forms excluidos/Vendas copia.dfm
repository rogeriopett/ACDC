  object TRVendas: TIBTransaction
    DefaultDatabase = DM.IBDatabase1
    Params.Strings = (
      'read_committed'
      'rec_version'
      'nowait')
    Left = 460
    Top = 159
  end
  object TRVendasItens: TIBTransaction
    DefaultDatabase = DM.IBDatabase1
    Params.Strings = (
      'read_committed'
      'rec_version'
      'nowait')
    Left = 532
    Top = 159
  end
  object QYVendas: TIBDataSet
    Database = DM.IBDatabase1
    Transaction = TRVendas
    AfterPost = QYVendasAfterPost
    BeforePost = QYVendasBeforePost
    BufferChunks = 1000
    CachedUpdates = False
    DeleteSQL.Strings = (
      'delete from VENDAS'
      'where'
      '  VED_CODIGO = :OLD_VED_CODIGO')
    InsertSQL.Strings = (
      'insert into VENDAS'
      
        '  (VED_CODIGO, VED_CLIENTE, VED_EXPEDIDOPOR, VED_VENDEDOR, VED_A' +
        'LIQICMSCREDSN, '
      
        '   VED_BAIRRO, VED_BAIXADATA, VED_BAIXAPOR, VED_BASECOFINS, VED_' +
        'BASECOFINSST, '
      
        '   VED_BASEICMS, VED_BASEICMSST, VED_BASEII, VED_BASEIPI, VED_BA' +
        'SEISS, '
      
        '   VED_BASEPIS, VED_BASEPISST, VED_CEP, VED_CFOP, VED_CFOPDESC, ' +
        'VED_CIDADE, '
      
        '   VED_CIDADECODIGO, VED_CNPJ, VED_CODIMPORTACAO, VED_COMISSAO, ' +
        'VED_COMISSAOPOR, '
      
        '   VED_COMPLEMENTO, VED_CONDICAO, VED_CONDICAOMEMO, VED_CONFERID' +
        'O, VED_CONFERIDODATA, '
      
        '   VED_CONFERIDOPOR, VED_CONTATO, VED_CPF, VED_CUSTOTOTAL, VED_D' +
        'ESCPORC, '
      
        '   VED_DESCPORCCLIENTE, VED_DESCPORCCONDICAO, VED_DESCVALOR, VED' +
        '_DESTACARIMPOSTOS, '
      
        '   VED_DIAPREFERENCIAL, VED_DTATUALIZACAO, VED_DTCADASTRO, VED_D' +
        'TEMISSAO, '
      
        '   VED_DTPRESTSERVICO, VED_DTSAIDA, VED_ENDERECO, VED_ENTRADASAI' +
        'DA, VED_ENTREGUE, '
      
        '   VED_ESPECIE, VED_ESTADO, VED_ESTADOCODIGO, VED_EXLOCAL, VED_E' +
        'XUFSAIDA, '
      
        '   VED_FONE1, VED_FORMAPAGTO, VED_FRETE, VED_IDESTRANGEIRO, VED_' +
        'IE, VED_INFOADICFISCO, '
      
        '   VED_LACRES, VED_LUCROPORC, VED_LUCROVALOR, VED_MANUAL, VED_MA' +
        'RCA, VED_MOVIMENTAESTOQUE, '
      
        '   VED_MOVIMENTAFINANCEIRO, VED_NFE, VED_NOME, VED_NOTA, VED_NUM' +
        'ERO, VED_OBSERVACOES, '
      
        '   VED_PAIS, VED_PAISCODIGO, VED_PEDIDOCLIENTE, VED_PESOBRUTO, V' +
        'ED_PESOLIQ, '
      
        '   VED_REBOQUEPLACA, VED_REBOQUEPLACAUF, VED_REBOQUERNTC, VED_RG' +
        ', VED_SEQUENCIAITEM, '
      
        '   VED_STATUS, VED_SUFRAMA, VED_TABELAPRECO, VED_TIPOATENDIMENTO' +
        ', VED_TIPOCONSUMIDOR, '
      
        '   VED_TIPOOPERACAO, VED_TOTALADUANA, VED_TOTALBRUTO, VED_TOTALC' +
        'OFINS, '
      
        '   VED_TOTALCOFINSST, VED_TOTALCOMISSAO, VED_TOTALFCP, VED_TOTAL' +
        'FCPST, '
      
        '   VED_TOTALICMS, VED_TOTALICMSCREDSN, VED_TOTALICMSST, VED_TOTA' +
        'LICMSUFDEST, '
      
        '   VED_TOTALICMSUFREMET, VED_TOTALII, VED_TOTALIOF, VED_TOTALIPI' +
        ', VED_TOTALISS, '
      
        '   VED_TOTALISSDEDUCAO, VED_TOTALISSDESCCOND, VED_TOTALISSDESCIN' +
        'COND, VED_TOTALISSOUTROS, '
      
        '   VED_TOTALISSRETENCAO, VED_TOTALITENS, VED_TOTALPIS, VED_TOTAL' +
        'PISST, '
      
        '   VED_TOTALPRODUTOS, VED_TOTALSERVICOS, VED_TOTALTRIBUTOS, VED_' +
        'TOTALTRIBUTOSEST, '
      
        '   VED_TOTALTRIBUTOSFED, VED_TOTALTRIBUTOSIMP, VED_TOTALTRIBUTOS' +
        'MUN, VED_TRANSPCIDADE, '
      
        '   VED_TRANSPCNPJ, VED_TRANSPCPF, VED_TRANSPEMAIL, VED_TRANSPEND' +
        'ERECO, '
      
        '   VED_TRANSPESTADO, VED_TRANSPFONE, VED_TRANSPIE, VED_TRANSPNOM' +
        'E, VED_TRANSPORTADORA, '
      
        '   VED_USUARIO, VED_VALORDESPACES, VED_VALORFRETE, VED_VALORSEGU' +
        'RO, VED_VALORTOTAL, '
      
        '   VED_VEICULOPLACA, VED_VEICULOPLACAUF, VED_VEICULORNTC, VED_VI' +
        'AINTERNET, '
      '   VED_VIAINTERNETSTATUS, VED_VOLUMES, VED_VOLUMESNUM)'
      'values'
      
        '  (:VED_CODIGO, :VED_CLIENTE, :VED_EXPEDIDOPOR, :VED_VENDEDOR, :' +
        'VED_ALIQICMSCREDSN, '
      
        '   :VED_BAIRRO, :VED_BAIXADATA, :VED_BAIXAPOR, :VED_BASECOFINS, ' +
        ':VED_BASECOFINSST, '
      
        '   :VED_BASEICMS, :VED_BASEICMSST, :VED_BASEII, :VED_BASEIPI, :V' +
        'ED_BASEISS, '
      
        '   :VED_BASEPIS, :VED_BASEPISST, :VED_CEP, :VED_CFOP, :VED_CFOPD' +
        'ESC, :VED_CIDADE, '
      
        '   :VED_CIDADECODIGO, :VED_CNPJ, :VED_CODIMPORTACAO, :VED_COMISS' +
        'AO, :VED_COMISSAOPOR, '
      
        '   :VED_COMPLEMENTO, :VED_CONDICAO, :VED_CONDICAOMEMO, :VED_CONF' +
        'ERIDO, '
      
        '   :VED_CONFERIDODATA, :VED_CONFERIDOPOR, :VED_CONTATO, :VED_CPF' +
        ', :VED_CUSTOTOTAL, '
      
        '   :VED_DESCPORC, :VED_DESCPORCCLIENTE, :VED_DESCPORCCONDICAO, :' +
        'VED_DESCVALOR, '
      
        '   :VED_DESTACARIMPOSTOS, :VED_DIAPREFERENCIAL, :VED_DTATUALIZAC' +
        'AO, :VED_DTCADASTRO, '
      
        '   :VED_DTEMISSAO, :VED_DTPRESTSERVICO, :VED_DTSAIDA, :VED_ENDER' +
        'ECO, :VED_ENTRADASAIDA, '
      
        '   :VED_ENTREGUE, :VED_ESPECIE, :VED_ESTADO, :VED_ESTADOCODIGO, ' +
        ':VED_EXLOCAL, '
      
        '   :VED_EXUFSAIDA, :VED_FONE1, :VED_FORMAPAGTO, :VED_FRETE, :VED' +
        '_IDESTRANGEIRO, '
      
        '   :VED_IE, :VED_INFOADICFISCO, :VED_LACRES, :VED_LUCROPORC, :VE' +
        'D_LUCROVALOR, '
      
        '   :VED_MANUAL, :VED_MARCA, :VED_MOVIMENTAESTOQUE, :VED_MOVIMENT' +
