  object IBQuery1: TIBQuery
    Database = DM.IBDatabase1
    Transaction = IBTransaction1
    BufferChunks = 1000
    CachedUpdates = False
    ParamCheck = True
    SQL.Strings = (
      'select '
      'NFE_CODIGO,'
      'NFE_CLIENTE,'
      'NFE_CFOP,'
      'NFE_CFOPDESC,'
      'NFE_CHAVEACESSO,'
      'NFE_DESCVALOR,'
      'NFE_DTEMISSAO,'
      'NFE_VALORTOTAL,'
      'NFE_STATUS,'
      'NFE_NOME,'
      'NFE_CONDICAO,'
      'CLI_NOME,'
      'CPG_DESCRICAO'
      'from NFE'
      'left join CLIENTES on NFE_CLIENTE=CLI_CODIGO'
      'left join CONDICOES on NFE_CONDICAO=CPG_CODIGO'
      'where NFE_DTEMISSAO between :datainicial and :datafinal'
      'order by NFE_CFOP, CLI_NOME')
    Left = 200
    Top = 296
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'datainicial'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'datafinal'
        ParamType = ptUnknown
      end>
