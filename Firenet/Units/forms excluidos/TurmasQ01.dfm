  object FDQuery1: TFDQuery
    Connection = DM.FDConnection1
    Transaction = FDTransaction1
    SQL.Strings = (
      'select '
      'TUR_CODIGO,'
      'TUR_DESCRICAO,'
      'TUR_PROFESSOR,'
      'TUR_DTINICIO,'
      'TUR_DTTERMINO,'
      'TUR_DTCADASTRO,'
      'TUR_PERIODO,'
      'TUR_STATUS,'
      'TUR_ENCONTROS,'
      'TUR_SEGUNDA,'
      'TUR_TERCA,'
      'TUR_QUARTA,'
      'TUR_QUINTA,'
      'TUR_SEXTA,'
      'TUR_SABADO,'
      'TUR_DOMINGO,'
      'TUR_ANO,'
      'VEN_NOME from TURMAS'
      'left join VENDEDORES on TUR_PROFESSOR=VEN_CODIGO'
      'order by VEN_NOME, TUR_DESCRICAO'
      '')
    Left = 184
    Top = 240
  end
  object FDTransaction1: TFDTransaction
    Options.Isolation = xiReadCommitted
    Connection = DM.FDConnection1
    Left = 256
    Top = 240
  end
