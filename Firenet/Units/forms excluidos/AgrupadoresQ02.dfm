  object IBQuery1: TIBQuery
    Database = DM.IBDatabase1
    Transaction = IBTransaction1
    SQL.Strings = (
      
        'select DES_CODIGO, DES_DESCRICAO, AGR_CODIGO, AGR_DESCRICAO from' +
        ' DESPESAS'
      'left join AGRUPADORES on DES_AGRUPADOR=AGR_CODIGO'
      'order by AGR_DESCRICAO, DES_DESCRICAO')
    Left = 192
    Top = 224
  end
