  object IBQuery1: TIBQuery
    Database = DM.IBDatabase1
    Transaction = IBTransaction1
    SQL.Strings = (
      'select '
      'PCS_CODIGO,'
      'PCS_ACAO,'
      'PCS_ADVOGADO,'
      'PCS_DESCRICAO,'
      'PCS_DTCADASTRO,'
      'PCS_FORO,'
      'PCS_STATUS,'
      'PCS_TOTALLANCAMENTOS,'
      'ACO_DESCRICAO,'
      'FRS_NOME,'
      'VEN_NOME from PROCESSOS'
      'left join ACOES on PCS_ACAO=ACO_CODIGO'
      'left join FOROS on PCS_FORO=FRS_CODIGO'
      'left join VENDEDORES on PCS_ADVOGADO=VEN_CODIGO'
      'where PCS_DTCADASTRO between :datainicial and :datafinal'
      'order by VEN_NOME, PCS_CODIGO')
    Left = 192
    Top = 224
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'datainicial'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'datafinal'
        ParamType = ptUnknown
      end>
  end
