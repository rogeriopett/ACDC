  object IBQuery1: TIBQuery
    Database = DM.IBDatabase1
    Transaction = IBTransaction1
    BufferChunks = 1000
    CachedUpdates = False
    DataSource = DM.DSAcessos
    ParamCheck = True
    SQL.Strings = (
      'select'
      'HOR_CODIGO,'
      'HOR_DESCRICAO,'
      'HOR_DTCADASTRO,'
      'HOR_QUANTIDADE,'
      'HOR_SALDOANTERIOR,'
      'HOR_SALDOPOSTERIOR,'
      'HOR_TRANSACAO,'
      'HOR_VENDEDOR,'
      'VEN_NOME,'
      'VEN_SALDOHORAS'
      'from HORAS'
      'left join VENDEDORES on HOR_VENDEDOR=VEN_CODIGO'
      'where HOR_DTCADASTRO between :datainicial and :datafinal'
      'order by VEN_NOME, HOR_CODIGO desc')
    Left = 96
    Top = 256
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'datainicial'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'datafinal'
        ParamType = ptUnknown
      end>
