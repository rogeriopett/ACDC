  object IBQuery1: TIBQuery
    Database = DM.IBDatabase1
    Transaction = IBTransaction1
    SQL.Strings = (
      'select SER_CODIGO, SER_CLIENTE, SER_TECNICO, SER_DTENTRADA,'
      'SER_PRODUTO, SER_MARCA, SER_MODELO, SER_LOCALIZACAO,'
      
        'SER_DTPREVISAO, SER_DTTECNICO, SER_DTSAIDA, SER_STATUS, CLI_CODI' +
        'GO,'
      'CLI_NOME, VEN_CODIGO, VEN_NOME from SERVICOS'
      'left join CLIENTES on SER_CLIENTE=CLI_CODIGO'
      'left join VENDEDORES on SER_TECNICO=VEN_CODIGO'
      'order by SER_TECNICO, SER_CODIGO')
    Left = 232
    Top = 240
