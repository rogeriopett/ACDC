  object FDQuery1: TFDQuery
    Connection = DM.FDConnection1
    Transaction = FDTransaction1
    SQL.Strings = (
      'select '
      'MAT_CODIGO,'
      'MAT_CLIENTE,'
      'MAT_TURMA,'
      'TUR_DESCRICAO,'
      'TUR_PROFESSOR,'
      'VEN_NOME,'
      'CLI_NOME,'
      'CLI_DTNASC'
      'from MATRICULAS'
      'left join CLIENTES on MAT_CLIENTE=CLI_CODIGO'
      'left join TURMAS on MAT_TURMA=TUR_CODIGO'
      'left join VENDEDORES on TUR_PROFESSOR=VEN_CODIGO'
      'where extract(MONTH from CLI_DTNASC)=:mes'
      'and MAT_STATUS='#39'A'#39
      'order by VEN_NOME, TUR_DESCRICAO, CLI_DTNASC'
      '')
    Left = 184
    Top = 240
    ParamData = <
      item
        Name = 'MES'
        ParamType = ptInput
      end>
  end
  object FDTransaction1: TFDTransaction
    Options.Isolation = xiReadCommitted
    Connection = DM.FDConnection1
    Left = 248
    Top = 240
  end
end
