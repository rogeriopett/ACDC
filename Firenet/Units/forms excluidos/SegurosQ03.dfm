  object IBQuery1: TIBQuery
    Database = DM.IBDatabase1
    Transaction = IBTransaction1
    BufferChunks = 1000
    CachedUpdates = False
    ParamCheck = True
    SQL.Strings = (
      'select'
      'SGP_CODIGO,'
      'SGP_COMISSAOVENDEDOR,'
      'SGP_DTPAGAMENTO,'
      'SGP_DTRECEBIMENTO,'
      'SGP_DTVENCIMENTO,'
      'SGP_PARCELA,'
      'SGP_STATUS,'
      'SGP_VALOR,'
      'SGP_SEGURO,'
      'SEG_CLIENTE,'
      'SEG_CODIGO,'
      'SEG_VENDEDOR,'
      'CLI_NOME,'
      'VEN_NOME'
      'from SEGUROSPARCELAS'
      'left join SEGUROS on SGP_SEGURO=SEG_CODIGO'
      'left join CLIENTES on SEG_CLIENTE=CLI_CODIGO'
      'left join VENDEDORES on SEG_VENDEDOR=VEN_CODIGO'
      'where SGP_DTVENCIMENTO between :datainicial and :datafinal'
      'order by SEG_VENDEDOR, VEN_NOME')
    Left = 200
    Top = 224
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'datainicial'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'datafinal'
        ParamType = ptUnknown
      end>
