  object IBTransaction1: TIBTransaction
    Active = True
    DefaultDatabase = DM.IBDatabase1
    Left = 96
    Top = 304
  end
  object IBQuery1: TIBQuery
    Database = DM.IBDatabase1
    Transaction = IBTransaction1
    BufferChunks = 1000
    CachedUpdates = False
    DataSource = DM.DSAcessos
    ParamCheck = True
    SQL.Strings = (
      'select'
      'CAI_VENDEDOR, VEN_NOME, VEN_SALDOATUAL, CAI_TIPODOCTO,'
      '  sum('
      '    case CAI_ENTRADASAIDA'
      '      when '#39'E'#39' then CAI_VALOR'
      '      when '#39'S'#39' then 0'
      '    end'
      '  ) as ENTRADAS,'
      '  sum('
      '    case CAI_ENTRADASAIDA'
      '      when '#39'E'#39' then 0'
      '      when '#39'S'#39' then CAI_VALOR'
      '    end'
      '  ) as SAIDAS'
      'from CAIXAMOV'
      'left join VENDEDORES on CAI_VENDEDOR=VEN_CODIGO'
      'where CAI_DATA between :datainicial and :datafinal'
      'group by CAI_VENDEDOR, VEN_NOME, VEN_SALDOATUAL, CAI_TIPODOCTO')
    Left = 96
    Top = 256
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'datainicial'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'datafinal'
        ParamType = ptUnknown
      end>
    object IBQuery1CAI_VENDEDOR: TIntegerField
      FieldName = 'CAI_VENDEDOR'
      Origin = '"CAIXAMOV"."CAI_VENDEDOR"'
      Required = True
    end
    object IBQuery1VEN_NOME: TIBStringField
      FieldName = 'VEN_NOME'
      Origin = '"VENDEDORES"."VEN_NOME"'
      Size = 50
    end
    object IBQuery1CAI_TIPODOCTO: TIBStringField
