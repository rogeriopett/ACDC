  object FDQuery1: TFDQuery
    Connection = DM.FDConnection1
    Transaction = FDTransaction1
    SQL.Strings = (
      'select '
      'VEV_TIPO,'
      'VEV_ANOFAB,'
      'VEV_ANOMOD,'
      'VEV_PLACA,'
      'VEV_DESPESAS,'
      'VEV_VALORCOMPRA,'
      'VEV_VALORCOMPRA + VEV_DESPESAS as CUSTO,'
      'VEV_VALORVENDA,'
      'VEV_VALORVENDA - (VEV_VALORCOMPRA + VEV_DESPESAS) as LUCRO,'
      'VEL_DESCRICAO from VEICULOSVENDA '
      'left join VEICULOS on VEV_VEICULO=VEL_CODIGO'
      'where VEV_STATUS='#39'A'#39
      'order by VEV_TIPO, VEL_DESCRICAO'
      '')
