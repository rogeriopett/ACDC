  object IBQuery1: TIBQuery
    Database = DM.IBDatabase1
    Transaction = IBTransaction1
    BufferChunks = 1000
    CachedUpdates = False
    ParamCheck = True
    SQL.Strings = (
      'select '
      'VEI_PRODUTO,'
      'VEI_QUANTIDADE,'
      'VEI_VALORUNIT,'
      'VEI_VALORTOTAL,'
      'VEI_VENDA,'
      'VEI_DESCRICAO,'
      'VED_NOME,'
      'VED_CLIENTE,'
      'VED_VENDEDOR,'
      'VED_DTEMISSAO,'
      'PRO_MARCA,'
      'MAR_CODIGO,'
      'MAR_DESCRICAO'
      'from VENDASITENS'
      'left join VENDAS on VEI_VENDA=VED_CODIGO'
      'left join PRODUTOS on VEI_PRODUTO=PRO_CODIGO'
      'left join MARCAS on PRO_MARCA=MAR_CODIGO'
      'where VED_DTEMISSAO between :datainicial and :datafinal'
      'order by MAR_DESCRICAO, VEI_DESCRICAO, VED_DTEMISSAO desc')
    Left = 184
    Top = 328
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'datainicial'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'datafinal'
        ParamType = ptUnknown
      end>
