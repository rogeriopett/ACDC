  object QYBoletos: TFDQuery
    Connection = DM.FDConnection1
    Transaction = TRBoletos
    SQL.Strings = (
      'select * from BOLETOS'
      'left join CONTAS on BOL_CONTA=CON_CODIGO'
      'left join BANCOS on CON_BANCO=BAN_CODIGO'
      'where BOL_CONTA=:conta and BOL_GEROUREMESSA='#39'N'#39
      '')
    Left = 312
    Top = 168
    ParamData = <
      item
        Name = 'CONTA'
        DataType = ftInteger
        ParamType = ptInput
      end>
