  object UPProducao: TFDUpdateSQL
    Connection = DM.FDConnection1
    InsertSQL.Strings = (
      'INSERT INTO PRODUCAO'
      '(PRD_CLIENTE, PRD_CODIGO, PRD_DATABAIXA, PRD_DTATUALIZACAO, '
      '  PRD_DTCADASTRO, PRD_DTPREVISAO, PRD_HRATUALIZACAO, '
      '  PRD_HRCADASTRO, PRD_LOTECRIADO, PRD_MPBAIXADA, '
      '  PRD_NOTACLIENTE, PRD_OBSERVACOES, PRD_STATUS, '
      '  PRD_USUARIO)'
      
        'VALUES (:NEW_PRD_CLIENTE, gen_id(GEN_PRODUCAO,1), :NEW_PRD_DATAB' +
        'AIXA, :NEW_PRD_DTATUALIZACAO, '
      
        '  :NEW_PRD_DTCADASTRO, :NEW_PRD_DTPREVISAO, :NEW_PRD_HRATUALIZAC' +
        'AO, '
      '  :NEW_PRD_HRCADASTRO, :NEW_PRD_LOTECRIADO, :NEW_PRD_MPBAIXADA, '
      '  :NEW_PRD_NOTACLIENTE, :NEW_PRD_OBSERVACOES, :NEW_PRD_STATUS, '
      '  :NEW_PRD_USUARIO)'
      
        'RETURNING PRD_CLIENTE, PRD_CODIGO, PRD_DATABAIXA, PRD_DTATUALIZA' +
        'CAO, PRD_DTCADASTRO, PRD_DTPREVISAO, PRD_HRATUALIZACAO, PRD_HRCA' +
        'DASTRO, PRD_LOTECRIADO, PRD_MPBAIXADA, PRD_NOTACLIENTE, PRD_OBSE' +
        'RVACOES, PRD_STATUS, PRD_USUARIO')
    ModifySQL.Strings = (
      'UPDATE PRODUCAO'
      
        'SET PRD_CLIENTE = :NEW_PRD_CLIENTE, PRD_CODIGO = :NEW_PRD_CODIGO' +
        ', '
      
        '  PRD_DATABAIXA = :NEW_PRD_DATABAIXA, PRD_DTATUALIZACAO = :NEW_P' +
        'RD_DTATUALIZACAO, '
      
        '  PRD_DTCADASTRO = :NEW_PRD_DTCADASTRO, PRD_DTPREVISAO = :NEW_PR' +
        'D_DTPREVISAO, '
      
        '  PRD_HRATUALIZACAO = :NEW_PRD_HRATUALIZACAO, PRD_HRCADASTRO = :' +
        'NEW_PRD_HRCADASTRO, '
      
        '  PRD_LOTECRIADO = :NEW_PRD_LOTECRIADO, PRD_MPBAIXADA = :NEW_PRD' +
        '_MPBAIXADA, '
      
        '  PRD_NOTACLIENTE = :NEW_PRD_NOTACLIENTE, PRD_OBSERVACOES = :NEW' +
        '_PRD_OBSERVACOES, '
      '  PRD_STATUS = :NEW_PRD_STATUS, PRD_USUARIO = :NEW_PRD_USUARIO'
      'WHERE PRD_CODIGO = :OLD_PRD_CODIGO'
      
        'RETURNING PRD_CLIENTE, PRD_CODIGO, PRD_DATABAIXA, PRD_DTATUALIZA' +
        'CAO, PRD_DTCADASTRO, PRD_DTPREVISAO, PRD_HRATUALIZACAO, PRD_HRCA' +
        'DASTRO, PRD_LOTECRIADO, PRD_MPBAIXADA, PRD_NOTACLIENTE, PRD_OBSE' +
        'RVACOES, PRD_STATUS, PRD_USUARIO')
    DeleteSQL.Strings = (
      'DELETE FROM PRODUCAO'
      'WHERE PRD_CODIGO = :OLD_PRD_CODIGO')
    FetchRowSQL.Strings = (
      
        'SELECT PRD_CLIENTE, PRD_CODIGO, PRD_DATABAIXA, PRD_DTATUALIZACAO' +
        ', PRD_DTCADASTRO, '
      
        '  PRD_DTPREVISAO, PRD_HRATUALIZACAO, PRD_HRCADASTRO, PRD_LOTECRI' +
        'ADO, '
      '  PRD_MPBAIXADA, PRD_NOTACLIENTE, PRD_OBSERVACOES, PRD_STATUS, '
      '  PRD_USUARIO'
      'FROM PRODUCAO'
      'WHERE PRD_CODIGO = :OLD_PRD_CODIGO')
    Left = 208
    Top = 328
  end
  object UPProducaoItens: TFDUpdateSQL
    Connection = DM.FDConnection1
    InsertSQL.Strings = (
      'INSERT INTO PRODUCAOITENS'
      '(PDI_ALMOXARIFADO, PDI_CODIGO, PDI_PRODUCAO, PDI_PRODUTO, '
      '  PDI_QUANTIDADE)'
      
        'VALUES (:NEW_PDI_ALMOXARIFADO, gen_id(GEN_PRODUCAOITENS,1), :NEW' +
        '_PDI_PRODUCAO, :NEW_PDI_PRODUTO, '
      '  :NEW_PDI_QUANTIDADE)'
      
        'RETURNING PDI_ALMOXARIFADO, PDI_CODIGO, PDI_PRODUCAO, PDI_PRODUT' +
        'O, PDI_QUANTIDADE')
    ModifySQL.Strings = (
      'UPDATE PRODUCAOITENS'
      
        'SET PDI_ALMOXARIFADO = :NEW_PDI_ALMOXARIFADO, PDI_CODIGO = :NEW_' +
        'PDI_CODIGO, '
      
        '  PDI_PRODUCAO = :NEW_PDI_PRODUCAO, PDI_PRODUTO = :NEW_PDI_PRODU' +
        'TO, '
      '  PDI_QUANTIDADE = :NEW_PDI_QUANTIDADE'
      'WHERE PDI_CODIGO = :OLD_PDI_CODIGO'
      
        'RETURNING PDI_ALMOXARIFADO, PDI_CODIGO, PDI_PRODUCAO, PDI_PRODUT' +
        'O, PDI_QUANTIDADE')
    DeleteSQL.Strings = (
      'DELETE FROM PRODUCAOITENS'
      'WHERE PDI_CODIGO = :OLD_PDI_CODIGO')
    FetchRowSQL.Strings = (
      
        'SELECT PDI_ALMOXARIFADO, PDI_CODIGO, PDI_PRODUCAO, PDI_PRODUTO, ' +
        'PDI_QUANTIDADE'
      'FROM PRODUCAOITENS'
      'WHERE PDI_CODIGO = :OLD_PDI_CODIGO')
    Left = 296
    Top = 328
  end
