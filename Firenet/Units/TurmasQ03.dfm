  object FDQuery1: TFDQuery
    Connection = DM.FDConnection1
    Transaction = FDTransaction1
    SQL.Strings = (
      'select '
      'MAT_CODIGO,'
      'MAT_CLIENTE,'
      'MAT_TURMA,'
      'MAT_STATUS,'
      'TUR_DESCRICAO,'
      'TUR_ENCONTROS,'
      'TUR_DTINICIO,'
      'TUR_DTTERMINO,'
      'TUR_PERIODO,'
      'TUR_ANO,'
      'TUR_STATUS,'
      'TUR_PROFESSOR,'
      'TUR_SABADO,'
      'TUR_DOMINGO,'
      'TUR_SEGUNDA,'
      'TUR_TERCA,'
      'TUR_QUARTA,'
      'TUR_QUINTA,'
      'TUR_SEXTA,'
      'VEN_NOME,'
      'CLI_NOME'
      'from MATRICULAS'
      'left join TURMAS on MAT_TURMA=TUR_CODIGO'
      'left join CLIENTES on MAT_CLIENTE=CLI_CODIGO'
      'left join VENDEDORES ON TUR_PROFESSOR=VEN_CODIGO'
      'order by MAT_TURMA, CLI_NOME'
      '')
    Left = 48
    Top = 344
  end
  object FDTransaction1: TFDTransaction
    Options.Isolation = xiReadCommitted
    Connection = DM.FDConnection1
    Left = 48
    Top = 392
  end
  object FDQuery2: TFDQuery
    MasterSource = DataSource1
    MasterFields = 'MAT_CODIGO'
    Connection = DM.FDConnection1
    Transaction = FDTransaction2
    SQL.Strings = (
      'select '
      'count(CHA_CODIGO) as PRESENCAS'
      'from CHAMADAS'
      'left join CALENDARIOS on CHA_CALENDARIO=CAL_CODIGO'
      'where CHA_MATRICULA=:MAT_CODIGO '
      'and (CAL_TIPO='#39'NORMAL'#39' or CAL_TIPO='#39'EXTRA'#39')'
      'and CAL_STATUSCHAMADA='#39'F'#39
      'and CHA_PRESENCA='#39'P'#39
      '')
    Left = 120
    Top = 344
    ParamData = <
      item
        Name = 'MAT_CODIGO'
        ParamType = ptInput
      end>
  end
  object FDTransaction2: TFDTransaction
    Options.Isolation = xiReadCommitted
    Connection = DM.FDConnection1
    Left = 120
    Top = 392
  end
  object FDQuery3: TFDQuery
    MasterSource = DataSource1
    MasterFields = 'MAT_CODIGO'
    Connection = DM.FDConnection1
    Transaction = FDTransaction3
    SQL.Strings = (
      'select '
      'count(CHA_CODIGO) as FALTAS'
      'from CHAMADAS'
      'left join CALENDARIOS on CHA_CALENDARIO=CAL_CODIGO'
      'where CHA_MATRICULA=:MAT_CODIGO'
      'and (CAL_TIPO='#39'NORMAL'#39' or CAL_TIPO='#39'EXTRA'#39')'
      'and CAL_STATUSCHAMADA='#39'F'#39
      'and CHA_PRESENCA='#39'X'#39
      '')
    Left = 192
    Top = 344
    ParamData = <
      item
        Name = 'MAT_CODIGO'
        ParamType = ptInput
      end>
  end
