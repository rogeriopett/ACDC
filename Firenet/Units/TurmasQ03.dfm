  object FDQuery4: TFDQuery
    MasterSource = DataSource1
    MasterFields = 'MAT_CODIGO'
    Connection = DM.FDConnection1
    Transaction = FDTransaction4
    SQL.Strings = (
      'select '
      'count(CAL_CODIGO) as AULASDADAS'
      'from CALENDARIOS'
      'where CAL_STATUSCHAMADA='#39'F'#39' '
      'and (CAL_TIPO='#39'NORMAL'#39' or CAL_TIPO='#39'EXTRA'#39')'
      'and CAL_TURMA=:MAT_TURMA'
      '')
    Left = 264
    Top = 344
    ParamData = <
      item
        Name = 'MAT_TURMA'
        ParamType = ptInput
      end>
  end
