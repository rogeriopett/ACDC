  object QYSegurosParcelas: TFDQuery
    Connection = DM.FDConnection1
    Transaction = TRSegurosParcelas
    SQL.Strings = (
      'select'
      'SGP_CODIGO,'
      'SGP_COMISSAO,'
      'SGP_COMISSAOVENDEDOR,'
      'SGP_DTPAGAMENTO,'
      'SGP_DTRECEBIMENTO,'
      'SGP_DTVENCIMENTO,'
      'SGP_PARCELA,'
      'SGP_SEGURO,'
      'SGP_STATUS,'
      'SGP_VALOR,'
      'SEG_APOLICE,'
      'SEG_STATUS,'
      'SEG_VENDEDOR,'
      'CLI_NOME'
      'from SEGUROSPARCELAS'
      'left join SEGUROS on SGP_SEGURO=SEG_CODIGO'
      'left join CLIENTES on SEG_CLIENTE=CLI_CODIGO'
      '')
