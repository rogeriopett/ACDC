  object Query1: TQuery
    DatabaseName = 'c:\runtime\dentalflex\tabelas\'
    SQL.Strings = (
      'select TEV_CODIGO, TEV_CLIENTE, TEV_DATAPROX, TEV_HORARIO, NOME'
      'from televendas '
      'left join clientes on tev_cliente=clientes.codigo'
      'where tev_dataprox between :datainicial and :datafinal'
      'and TEV_CODVENDEDOR=:codvendedor'
      'and TEV_STATUS=:status'
      '')
    Left = 208
    Top = 280
    ParamData = <
      item
        DataType = ftDate
        Name = 'datainicial'
        ParamType = ptUnknown
      end
      item
        DataType = ftDate
        Name = 'datafinal'
        ParamType = ptUnknown
      end
      item
        DataType = ftInteger
        Name = 'codvendedor'
        ParamType = ptUnknown
      end
      item
        DataType = ftString
        Name = 'status'
        ParamType = ptUnknown
      end>
