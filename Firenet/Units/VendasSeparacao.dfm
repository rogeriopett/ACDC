    Connection = DM.FDConnection1
    Transaction = TRVendas
    SQL.Strings = (
      'select '
      'VED_CLIENTE,'
      'VED_CODIGO,'
      'VED_DTEMISSAO,'
      'VED_STATUS,'
      'VED_USUARIO,'
      'VED_VALORTOTAL,'
      'VED_VENDEDOR,'
      'VED_VIAINTERNET, '
      'VED_VIAINTERNETSTATUS, '
      'CLI_NOME,'
      'NFE_CODIGO,'
      'NFE_DTEMISSAO'
      'from VENDAS'
      'left join CLIENTES on VED_CLIENTE=CLI_CODIGO'
      'left join NFE on VED_NFE=NFE_CODIGO'
      '')
