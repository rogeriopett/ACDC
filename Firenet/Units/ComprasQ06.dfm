    Database = DM.IBDatabase1
    Transaction = IBTransaction1
    BufferChunks = 1000
    CachedUpdates = False
    ParamCheck = True
    SQL.Strings = (
      'select '
      'COM_CODIGO,'
      'COM_FORNECEDOR,'
      'COM_NOTADATA,'
      'COM_NOTANUMERO,'
      'COM_VALORTOTAL,'
      'COM_STATUS,'
      'COM_CHAVEACESSO,'
      'COM_NOME'
      'from COMPRAS'
      'left join FORNECEDORES on COM_FORNECEDOR=FOR_CODIGO'
      
        'where COM_STATUS='#39'F'#39' and COM_NOTADATA between :datainicial and :' +
