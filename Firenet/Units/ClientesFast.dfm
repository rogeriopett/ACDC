  object QY13: TFDQuery
    Connection = DM.FDConnection1
    Transaction = TR13
    SQL.Strings = (
      'select  '
      'CLI_CODIGO, '
      'CLI_FONE1, '
      'CLI_FONE2, '
      'CLI_FONE3,'
      'CLI_NOME, '
      'CLI_REPOSICOES,'
      'CLI_VENDEDOR,'
      'VEN_NOME from CLIENTES'
      'left join VENDEDORES on CLI_VENDEDOR=VEN_CODIGO'
      'where CLI_REPOSICOES>0'
      'order by VEN_NOME, CLI_NOME'
      '')
    Left = 624
    Top = 368
  end
