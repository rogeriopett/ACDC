  object QY04: TFDQuery
    Connection = DM.FDConnection1
    Transaction = TR04
    SQL.Strings = (
      'select '
      'A.VED_CLIENTE, '
      'C.CLI_FONE1, '
      'C.CLI_NOME, '
      'C.CLI_VENDEDOR, '
      'V.VEN_NOME, '
      'max(A.VED_DTEMISSAO) as ULTIMA, '
      '(current_date - max(A.VED_DTEMISSAO)) as DIAS,'
      
        '(select first(1) B.VED_VALORTOTAL from VENDAS B where B.VED_CLIE' +
        'NTE=A.VED_CLIENTE order by B.VED_CODIGO desc) as VALOR'
      'from VENDAS A'
      'left join CLIENTES C on A.VED_CLIENTE=C.CLI_CODIGO'
      'left join VENDEDORES V on C.CLI_VENDEDOR=V.VEN_CODIGO'
      
        'group by A.VED_CLIENTE, C.CLI_FONE1, C.CLI_NOME, C.CLI_VENDEDOR,' +
        ' V.VEN_NOME'
      'having max(A.VED_DTEMISSAO) < :datainicial'
      'order by V.VEN_NOME, C.CLI_NOME'
      '')
    Left = 264
    Top = 160
    ParamData = <
      item
        Name = 'DATAINICIAL'
        ParamType = ptInput
      end>
  end
  object QY05: TFDQuery
    Connection = DM.FDConnection1
    Transaction = TR05
    SQL.Strings = (
      'select '
      'CLI_CODIGO, '
      'CLI_NOME, '
      'CLI_FONE1, '
      'CLI_FONE2, '
      'CLI_DTCADASTRO,'
      'CLI_MAILING, '
      'MAI_DESCRICAO,'
      'A.VEN_NOME as VENDEDOR,'
      'B.VEN_NOME as TELEVENDA'
      'from CLIENTES'
      'left join MAILINGS on CLI_MAILING=MAI_CODIGO'
      'left join VENDEDORES A on CLI_VENDEDOR=A.VEN_CODIGO'
      'left join VENDEDORES B on CLI_TELEVENDA=B.VEN_CODIGO'
      'where CLI_DTCADASTRO between :datainicial and :datafinal'
      'order by MAI_DESCRICAO, CLI_NOME')
    Left = 48
    Top = 368
    ParamData = <
      item
        Name = 'DATAINICIAL'
        ParamType = ptInput
      end
      item
        Name = 'DATAFINAL'
        ParamType = ptInput
      end>
  end
