  object QY09: TFDQuery
    Connection = DM.FDConnection1
    Transaction = TR09
    SQL.Strings = (
      'select '
      'REE_CLIENTE, '
      'CLI_FONE1,'
      'CLI_LIMITECREDITO, '
      'CLI_NOME, '
      'CLI_VENDEDOR, '
      'VEN_NOME,'
      'sum(REE_VALOR+REE_VALORACESSORIAS) as TOTAL '
      'from RECEBER'
      'left join CLIENTES on REE_CLIENTE=CLI_CODIGO'
      'left join VENDEDORES on CLI_VENDEDOR=VEN_CODIGO'
      'where REE_STATUS='#39'A'#39
      
        'group by CLI_VENDEDOR, VEN_NOME, REE_CLIENTE, CLI_FONE1, CLI_NOM' +
        'E, CLI_LIMITECREDITO'
      'having sum(REE_VALOR+REE_VALORACESSORIAS) > CLI_LIMITECREDITO'
      'order by VEN_NOME, CLI_NOME'
      '')
    Left = 336
    Top = 368
  end
  object TR09: TFDTransaction
    Options.Isolation = xiReadCommitted
    Connection = DM.FDConnection1
    Left = 336
    Top = 416
  end
  object QY10: TFDQuery
    Connection = DM.FDConnection1
    Transaction = TR10
    SQL.Strings = (
      'select '
      'A.REE_CLIENTE,'
      'C.CLI_BLOQUEARVENDA,'
      'C.CLI_DIACOBRANCA,'
      'C.CLI_LIMITECREDITO,'
      'C.CLI_MENSALISTA,'
      'C.CLI_NOME,'
      'C.CLI_VENDEDOR,'
      'V.VEN_NOME,'
      
        '(select first(1) B.REE_DTVENCIMENTO from RECEBER B where B.REE_C' +
        'LIENTE=A.REE_CLIENTE and B.REE_STATUS='#39'A'#39' order by B.REE_DTVENCI' +
        'MENTO) as VECTOMAISANTIGO,'
      
        '(select sum(iif(D.REE_DTVENCIMENTO < :data, D.REE_VALOR, 0)) as ' +
        'VEN from RECEBER D where D.REE_CLIENTE=A.REE_CLIENTE and D.REE_S' +
        'TATUS='#39'A'#39') as VENCIDOS,'
      
        '(select sum(iif(E.REE_DTVENCIMENTO >= current_date, E.REE_VALOR,' +
        ' 0)) as VEN from RECEBER E where E.REE_CLIENTE=A.REE_CLIENTE and' +
        ' E.REE_STATUS='#39'A'#39') as AVENCER'
      'from RECEBER A'
      'left join CLIENTES C on A.REE_CLIENTE=C.CLI_CODIGO'
      'left join VENDEDORES V on C.CLI_VENDEDOR=V.VEN_CODIGO'
      'where A.REE_DTVENCIMENTO < :data and A.REE_STATUS='#39'A'#39' '
      'group by A.REE_CLIENTE, C.CLI_NOME, C.CLI_BLOQUEARVENDA,'
      'C.CLI_MENSALISTA, C.CLI_DIACOBRANCA, C.CLI_LIMITECREDITO,'
      'C.CLI_VENDEDOR, V.VEN_NOME'
      'order by V.VEN_NOME, C.CLI_NOME'
      '')
    Left = 408
    Top = 368
    ParamData = <
      item
        Name = 'DATA'
        ParamType = ptInput
      end>
  end
