  object QY03: TFDQuery
    Connection = DM.FDConnection1
    Transaction = TR03
    SQL.Strings = (
      'select CLI_NOME, '
      'CLI_CODIGO, '
      'CLI_EMAIL,'
      'CLI_FONE1, '
      'CLI_FONE2, '
      'CLI_FONE3, '
      'CLI_VENDEDOR,'
      'VEN_NOME from CLIENTES'
      'left join VENDEDORES on CLI_VENDEDOR=VEN_CODIGO'
      
        'where not exists (select first(1) VED_CLIENTE from VENDAS where ' +
        'VED_CLIENTE=CLI_CODIGO)'
      'order by VEN_NOME, CLI_NOME'
      '')
    Left = 192
    Top = 160
  end
