  object QY12: TFDQuery
    Connection = DM.FDConnection1
    Transaction = TR12
    SQL.Strings = (
      
        'select CLI_CODIGO, CLI_EMAIL, CLI_FONE1, CLI_FONE2, CLI_NOME, CL' +
        'I_VENDEDOR, VEN_NOME, ULTIMAVENDA, datediff(day, x.ULTIMAVENDA, ' +
        'current_date) as DIAS,'
      'case'
      
        '  when datediff(day, x.ULTIMAVENDA, current_date) between 1   an' +
        'd 60  then '#39'01 - ATIVOS'#39
      
        '  when datediff(day, x.ULTIMAVENDA, current_date) between 61  an' +
        'd 120 then '#39'02 - QUASE INATIVOS'#39
      
        '  when datediff(day, x.ULTIMAVENDA, current_date) between 121 an' +
        'd 180 then '#39'03 - INATIVOS RECENTE'#39
      
        '  when datediff(day, x.ULTIMAVENDA, current_date) between 181 an' +
        'd 360 THEN '#39'04 - INATIVOS'#39
      
        '  when datediff(day, x.ULTIMAVENDA, current_date) > 360 then '#39'05' +
        ' - EX-CLIENTES'#39
      '  when x.ULTIMAVENDA is null then '#39'06 - NUNCA COMPRARAM'#39
      'end as CLASSIFICACAO'
      'from'
      
        '  (select CLI_CODIGO, CLI_EMAIL, CLI_FONE1, CLI_FONE2, CLI_NOME,' +
        ' CLI_VENDEDOR, VEN_NOME,'
      
        '    (select first(1) VED_DTEMISSAO from VENDAS where VED_CLIENTE' +
        '=CLI_CODIGO and VED_STATUS='#39'F'#39' and VED_ENTRADASAIDA='#39'S'#39
      '     order by VED_CODIGO desc) as ULTIMAVENDA'
      '   from CLIENTES'
      '   left join VENDEDORES on CLI_VENDEDOR=VEN_CODIGO) x '
      'order by 6,10,5'
      '')
    Left = 552
    Top = 368
  end
  object QY01: TFDQuery
    Connection = DM.FDConnection1
    Transaction = TR01
    SQL.Strings = (
      'select '
      'CLI_ATIVIDADE, '
      'CLI_CIDADE, '
      'CLI_CODIGO, '
      'CLI_ESTADO,'
      'CLI_FONE1, '
      'CLI_FONE2, '
      'CLI_FONE3, '
      'CLI_NOME, '
      'CLI_STATUS,'
      'CLI_VENDEDOR, '
      'VEN_NOME, '
      'ATI_DESCRICAO '
      'from CLIENTES'
      'left join ATIVIDADES on CLI_ATIVIDADE=ATI_CODIGO'
      'left join VENDEDORES on CLI_VENDEDOR=VEN_CODIGO'
      'order by ATI_DESCRICAO, CLI_NOME'
      '')
    Left = 48
    Top = 160
  end
