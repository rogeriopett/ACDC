    UserName = 'frxDBDataset2'
    CloseDataSource = False
    FieldAliases.Strings = (
      'DLV_CARTAO=DLV_CARTAO'
      'DLV_CLIENTE=DLV_CLIENTE'
      'DLV_CODIGO=DLV_CODIGO'
      'DLV_DINHEIRO=DLV_DINHEIRO'
      'DLV_DTCADASTRO=DLV_DTCADASTRO'
      'DLV_ENTREGADOR=DLV_ENTREGADOR'
      'DLV_STATUS=DLV_STATUS'
      'DLV_TAXAVALOR=DLV_TAXAVALOR'
      'DLV_TROCO=DLV_TROCO'
      'DLV_VALORTOTAL=DLV_VALORTOTAL'
      'CLI_NOME=CLI_NOME'
      'VEN_NOME=VEN_NOME')
    DataSet = QY02
