    Top = 112
  end
  object QY01: TFDQuery
    Connection = DM.FDConnection1
    Transaction = TR01
    SQL.Strings = (
      'select'
      'DLV_CARTAO,'
      'DLV_CLIENTE,'
      'DLV_CODIGO,'
      'DLV_DINHEIRO, '
      'DLV_DTCADASTRO,'
      'DLV_STATUS,'
      'DLV_TAXAVALOR,'
      'DLV_TROCO,'
      'DLV_VALORTOTAL,'
      'DLV_VENDEDOR, '
      'CLI_NOME,'
      'VEN_NOME'
      'from DELIVERYS'
      'left join CLIENTES on DLV_CLIENTE=CLI_CODIGO'
      'left join VENDEDORES on DLV_VENDEDOR=VEN_CODIGO'
      'order by VEN_NOME, DLV_DTCADASTRO desc, CLI_NOME'
      '')
    Left = 48
    Top = 160
  end
  object TR01: TFDTransaction
    Options.Isolation = xiReadCommitted
    Connection = DM.FDConnection1
    Left = 48
    Top = 208
  end
  object QY02: TFDQuery
    Connection = DM.FDConnection1
    Transaction = TR02
    SQL.Strings = (
      'select'
      'DLV_CARTAO,'
      'DLV_CLIENTE,'
      'DLV_CODIGO,'
      'DLV_DINHEIRO, '
      'DLV_DTCADASTRO,'
      'DLV_ENTREGADOR,'
      'DLV_STATUS,'
      'DLV_TAXAVALOR,'
      'DLV_TROCO,'
      'DLV_VALORTOTAL,'
      'CLI_NOME,'
      'VEN_NOME'
      'from DELIVERYS'
      'left join CLIENTES on DLV_CLIENTE=CLI_CODIGO'
      'left join VENDEDORES on DLV_ENTREGADOR=VEN_CODIGO'
      'order by VEN_NOME, DLV_DTCADASTRO desc, CLI_NOME'
      '')
    Left = 120
    Top = 160
  end
  object TR02: TFDTransaction
    Options.Isolation = xiReadCommitted
    Connection = DM.FDConnection1
    Left = 120
    Top = 208
  end
end
