  object UPClassTrib: TFDUpdateSQL
    Connection = FDConnection1
    InsertSQL.Strings = (
      'INSERT INTO CLASSTRIB'
      
        '(CLT_ALIQCBSRED, CLT_ALIQIBSRED, CLT_CODIGO, CLT_CREDITOPRESUMID' +
        'O, '
      '  CLT_DESCRICAO, CLT_DOCBPE, CLT_DOCBPETA, '
      '  CLT_DOCBPETM, CLT_DOCCTE, CLT_DOCCTEOS, CLT_DOCDERE, '
      '  CLT_DOCDIR, CLT_DOCDUIMP, CLT_DOCNFAG, CLT_DOCNFCE, '
      '  CLT_DOCNFCOM, CLT_DOCNFEABI, CLT_DOCNFE, '
      '  CLT_DOCNFGAS, CLT_DOCNFSE, CLT_DOCNFSEVIA, '
      '  CLT_DOCNF3E, CLT_DTATUALIZACAO, CLT_DTCADASTRO, '
      '  CLT_DTPUBLICACAO, CLT_DTVIGENCIAINICIO, CLT_DTVIGENCIAFIM, '
      '  CLT_ESTORNOCREDITO, CLT_HRATUALIZACAO, CLT_HRCADASTRO, '
      '  CLT_LINK, CLT_MONODIFERIMENTO, CLT_MONOFASICO, '
      '  CLT_MONORETENCAO, CLT_MONORETIDO, CLT_REDBASE, '
      '  CLT_TIPOALIQUOTA, CLT_TIPORECEITA, CLT_TRIBUTACAOREGULAR, '
      '  CLT_USUARIO)'
      
        'VALUES (:NEW_CLT_ALIQCBSRED, :NEW_CLT_ALIQIBSRED, :NEW_CLT_CODIG' +
        'O, :NEW_CLT_CREDITOPRESUMIDO, '
      '  :NEW_CLT_DESCRICAO, :NEW_CLT_DOCBPE, :NEW_CLT_DOCBPETA, '
      
        '  :NEW_CLT_DOCBPETM, :NEW_CLT_DOCCTE, :NEW_CLT_DOCCTEOS, :NEW_CL' +
        'T_DOCDERE, '
      
        '  :NEW_CLT_DOCDIR, :NEW_CLT_DOCDUIMP, :NEW_CLT_DOCNFAG, :NEW_CLT' +
        '_DOCNFCE, '
      '  :NEW_CLT_DOCNFCOM, :NEW_CLT_DOCNFEABI, :NEW_CLT_DOCNFE, '
      '  :NEW_CLT_DOCNFGAS, :NEW_CLT_DOCNFSE, :NEW_CLT_DOCNFSEVIA, '
      
        '  :NEW_CLT_DOCNF3E, :NEW_CLT_DTATUALIZACAO, :NEW_CLT_DTCADASTRO,' +
        ' '
      
        '  :NEW_CLT_DTPUBLICACAO, :NEW_CLT_DTVIGENCIAINICIO, :NEW_CLT_DTV' +
        'IGENCIAFIM, '
      
        '  :NEW_CLT_ESTORNOCREDITO, :NEW_CLT_HRATUALIZACAO, :NEW_CLT_HRCA' +
        'DASTRO, '
      '  :NEW_CLT_LINK, :NEW_CLT_MONODIFERIMENTO, :NEW_CLT_MONOFASICO, '
      '  :NEW_CLT_MONORETENCAO, :NEW_CLT_MONORETIDO, :NEW_CLT_REDBASE, '
      
        '  :NEW_CLT_TIPOALIQUOTA, :NEW_CLT_TIPORECEITA, :NEW_CLT_TRIBUTAC' +
        'AOREGULAR, '
      '  :NEW_CLT_USUARIO)'
      
        'RETURNING CLT_ALIQCBSRED, CLT_ALIQIBSRED, CLT_CODIGO, CLT_CREDIT' +
        'OPRESUMIDO, CLT_DESCRICAO, CLT_DOCBPE, CLT_DOCBPETA, CLT_DOCBPET' +
        'M, CLT_DOCCTE, CLT_DOCCTEOS, CLT_DOCDERE, CLT_DOCDIR, CLT_DOCDUI' +
        'MP, CLT_DOCNFAG, CLT_DOCNFCE, CLT_DOCNFCOM, CLT_DOCNFEABI, CLT_D' +
        'OCNFE, CLT_DOCNFGAS, CLT_DOCNFSE, CLT_DOCNFSEVIA, CLT_DOCNF3E, C' +
        'LT_DTATUALIZACAO, CLT_DTCADASTRO, CLT_DTPUBLICACAO, CLT_DTVIGENC' +
        'IAINICIO, CLT_DTVIGENCIAFIM, CLT_ESTORNOCREDITO, CLT_HRATUALIZAC' +
        'AO, CLT_HRCADASTRO, CLT_LINK, CLT_MONODIFERIMENTO, CLT_MONOFASIC' +
        'O, CLT_MONORETENCAO, CLT_MONORETIDO, CLT_REDBASE, CLT_TIPOALIQUO' +
        'TA, CLT_TIPORECEITA, CLT_TRIBUTACAOREGULAR, CLT_USUARIO')
    ModifySQL.Strings = (
      'UPDATE CLASSTRIB'
      
        'SET CLT_ALIQCBSRED = :NEW_CLT_ALIQCBSRED, CLT_ALIQIBSRED = :NEW_' +
        'CLT_ALIQIBSRED, '
      
        '  CLT_CODIGO = :NEW_CLT_CODIGO, CLT_CREDITOPRESUMIDO = :NEW_CLT_' +
        'CREDITOPRESUMIDO, '
      
        '  CLT_DESCRICAO = :NEW_CLT_DESCRICAO, CLT_DOCBPE = :NEW_CLT_DOCB' +
        'PE, '
      
