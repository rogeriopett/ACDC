        '  :NEW_NOI_ALIQIPI, :NEW_NOI_ALIQISS, :NEW_NOI_ALIQPIS, :NEW_NOI' +
        '_ALIQPISST, '
      
        '  :NEW_NOI_ALMOXARIFADO, :NEW_NOI_BASECOFINS, :NEW_NOI_BASECOFIN' +
        'SST, '
