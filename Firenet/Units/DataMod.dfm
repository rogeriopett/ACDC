  object UPCreditoPres: TFDUpdateSQL
    Connection = FDConnection1
    InsertSQL.Strings = (
      'INSERT INTO CREDITOPRES'
      '(CPR_APROPRIADFE, CPR_APROPRIAEVENTO, CPR_CBS, '
      '  CPR_CODIGO, CPR_DEDUZTOTAL, CPR_DESCRICAO, '
      '  CPR_DTATUALIZACAO, CPR_DTCADASTRO, CPR_HRATUALIZACAO, '
      '  CPR_HRCADASTRO, CPR_IBS, CPR_USUARIO)'
      
