        'S_NOMEFORM = :NEW_LOS_NOMEFORM, '
      '  LOS_PICKLIST = :NEW_LOS_PICKLIST, LOS_TELA = :NEW_LOS_TELA'
      'WHERE LOS_CODIGO = :OLD_LOS_CODIGO'
      
        'RETURNING LOS_CAMPO, LOS_CODIGO, LOS_NOMEFORM, LOS_PICKLIST, LOS' +
        '_TELA')
    DeleteSQL.Strings = (
