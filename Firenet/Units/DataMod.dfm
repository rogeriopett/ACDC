        'ODIGOBARRAS, '
      '  :NEW_FII_CODIGOFCI, :NEW_FII_COEFICIENTE, :NEW_FII_FCI, '
      '  :NEW_FII_NOME, :NEW_FII_PRODUTO, :NEW_FII_VALORPARCELA, '
      '  :NEW_FII_VALORSAIDA, :NEW_FII_UNIDADE, :NEW_FII_UNIDADEFCI)')
    ModifySQL.Strings = (
      'UPDATE FCIITENS'
      
        'SET FII_CLASSFISCAL = :NEW_FII_CLASSFISCAL, FII_CODIGO = :NEW_FI' +
        'I_CODIGO, '
      
        '  FII_CODIGOBARRAS = :NEW_FII_CODIGOBARRAS, FII_CODIGOFCI = :NEW' +
        '_FII_CODIGOFCI, '
      
        '  FII_COEFICIENTE = :NEW_FII_COEFICIENTE, FII_FCI = :NEW_FII_FCI' +
        ', '
      '  FII_NOME = :NEW_FII_NOME, FII_PRODUTO = :NEW_FII_PRODUTO, '
      
        '  FII_VALORPARCELA = :NEW_FII_VALORPARCELA, FII_VALORSAIDA = :NE' +
        'W_FII_VALORSAIDA, '
      
        '  FII_UNIDADE = :NEW_FII_UNIDADE, FII_UNIDADEFCI = :NEW_FII_UNID' +
        'ADEFCI'
      'WHERE FII_CODIGO = :OLD_FII_CODIGO')
    DeleteSQL.Strings = (
      'DELETE FROM FCIITENS'
      'WHERE FII_CODIGO = :OLD_FII_CODIGO')
