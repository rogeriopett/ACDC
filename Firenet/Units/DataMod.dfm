  object UPComprasItens: TFDUpdateSQL
    Connection = FDConnection1
    InsertSQL.Strings = (
      'INSERT INTO COMPRASITENS'
      '(COI_ALIQCOFINS, COI_ALIQCOFINSST, COI_ALIQFCP, '
      '  COI_ALIQICMS, COI_ALIQICMSADICST, COI_ALIQICMSINTER, '
      '  COI_ALIQICMSINTERPART, COI_ALIQICMSRED, COI_ALIQICMSST, '
      '  COI_ALIQIPI, COI_ALIQISS, COI_ALIQPIS, COI_ALIQPISST, '
      '  COI_ALMOXARIFADO, COI_BASECOFINS, COI_BASECOFINSST, '
      '  COI_BASEICMS, COI_BASEICMSRED, COI_BASEICMSST, '
      '  COI_BASEIPI, COI_BASEISS, COI_BASEPIS, COI_BASEPISST, '
      '  COI_CEST, COI_CFOP, COI_CIDADEISS, COI_CLASSFISCAL, '
      '  COI_CODIGO, COI_CODIGOBARRAS, COI_COMPLEMENTO, '
      '  COI_COMPOEBASEICMS, COI_COMPOEBASEICMSST, COI_COMPRA, '
      '  COI_CONVERSAO, COI_CSTCOFINS, COI_CSTICMS, '
      '  COI_CSTIPI, COI_CSTPIS, COI_DESCPORC, COI_DESCRICAO, '
      '  COI_DESCVALOR, COI_DTENTREGA, COI_ENQUADRAMENTOIPI, '
      '  COI_EXCECAO, COI_FCI, COI_INCENTIVOISS, COI_INDICADORISS, '
      '  COI_INFOADICIONAL, COI_MODICMS, COI_MODICMSST, '
      '  COI_ORIGEM, COI_PAISISS, COI_PESO, COI_PESOTOTAL, '
      '  COI_PROCESSOISS, COI_PRODUTO, COI_PRODUTOREAL, '
      '  COI_QUANTIDADE, COI_SERVICOISS, COI_TIPO, '
      '  COI_TIPOISS, COI_UNIDADE, COI_VALORACESSORIAS, '
      '  COI_VALORCOFINS, COI_VALORCOFINSST, COI_VALORFCP, '
      '  COI_VALORFRETE, COI_VALORICMS, COI_VALORICMSCREDSN, '
      '  COI_VALORICMSST, COI_VALORICMSUFDEST, COI_VALORICMSUFREMET, '
      '  COI_VALORIPI, COI_VALORISS, COI_VALORISSDEDUCAO, '
      '  COI_VALORISSDESCCOND, COI_VALORISSDESCINCOND, '
      '  COI_VALORISSOUTROS, COI_VALORISSRETENCAO, COI_VALORPIS, '
      '  COI_VALORPISST, COI_VALORSEGURO, COI_VALORTOTAL, '
      '  COI_VALORTOTALBRUTO, COI_VALORTRIBUTOS, COI_VALORTRIBUTOSEST, '
      
        '  COI_VALORTRIBUTOSFED, COI_VALORTRIBUTOSIMP, COI_VALORTRIBUTOSM' +
        'UN, '
      '  COI_VALORUNIT)'
      
        'VALUES (:NEW_COI_ALIQCOFINS, :NEW_COI_ALIQCOFINSST, :NEW_COI_ALI' +
        'QFCP, '
      
        '  :NEW_COI_ALIQICMS, :NEW_COI_ALIQICMSADICST, :NEW_COI_ALIQICMSI' +
        'NTER, '
      
        '  :NEW_COI_ALIQICMSINTERPART, :NEW_COI_ALIQICMSRED, :NEW_COI_ALI' +
        'QICMSST, '
      
        '  :NEW_COI_ALIQIPI, :NEW_COI_ALIQISS, :NEW_COI_ALIQPIS, :NEW_COI' +
        '_ALIQPISST, '
      
        '  :NEW_COI_ALMOXARIFADO, :NEW_COI_BASECOFINS, :NEW_COI_BASECOFIN' +
        'SST, '
      '  :NEW_COI_BASEICMS, :NEW_COI_BASEICMSRED, :NEW_COI_BASEICMSST, '
      
        '  :NEW_COI_BASEIPI, :NEW_COI_BASEISS, :NEW_COI_BASEPIS, :NEW_COI' +
        '_BASEPISST, '
      
        '  :NEW_COI_CEST, :NEW_COI_CFOP, :NEW_COI_CIDADEISS, :NEW_COI_CLA' +
        'SSFISCAL, '
      
        '  gen_id(GEN_COMPRASITENS,1), :NEW_COI_CODIGOBARRAS, :NEW_COI_CO' +
        'MPLEMENTO, '
      
        '  :NEW_COI_COMPOEBASEICMS, :NEW_COI_COMPOEBASEICMSST, :NEW_COI_C' +
        'OMPRA, '
      '  :NEW_COI_CONVERSAO, :NEW_COI_CSTCOFINS, :NEW_COI_CSTICMS, '
      
        '  :NEW_COI_CSTIPI, :NEW_COI_CSTPIS, :NEW_COI_DESCPORC, :NEW_COI_' +
        'DESCRICAO, '
      
        '  :NEW_COI_DESCVALOR, :NEW_COI_DTENTREGA, :NEW_COI_ENQUADRAMENTO' +
        'IPI, '
      
        '  :NEW_COI_EXCECAO, :NEW_COI_FCI, :NEW_COI_INCENTIVOISS, :NEW_CO' +
        'I_INDICADORISS, '
      '  :NEW_COI_INFOADICIONAL, :NEW_COI_MODICMS, :NEW_COI_MODICMSST, '
      
        '  :NEW_COI_ORIGEM, :NEW_COI_PAISISS, :NEW_COI_PESO, :NEW_COI_PES' +
        'OTOTAL, '
      '  :NEW_COI_PROCESSOISS, :NEW_COI_PRODUTO, :NEW_COI_PRODUTOREAL, '
      '  :NEW_COI_QUANTIDADE, :NEW_COI_SERVICOISS, :NEW_COI_TIPO, '
      '  :NEW_COI_TIPOISS, :NEW_COI_UNIDADE, :NEW_COI_VALORACESSORIAS, '
      
        '  :NEW_COI_VALORCOFINS, :NEW_COI_VALORCOFINSST, :NEW_COI_VALORFC' +
        'P, '
      
        '  :NEW_COI_VALORFRETE, :NEW_COI_VALORICMS, :NEW_COI_VALORICMSCRE' +
        'DSN, '
      
        '  :NEW_COI_VALORICMSST, :NEW_COI_VALORICMSUFDEST, :NEW_COI_VALOR' +
        'ICMSUFREMET, '
      
        '  :NEW_COI_VALORIPI, :NEW_COI_VALORISS, :NEW_COI_VALORISSDEDUCAO' +
        ', '
      '  :NEW_COI_VALORISSDESCCOND, :NEW_COI_VALORISSDESCINCOND, '
      
        '  :NEW_COI_VALORISSOUTROS, :NEW_COI_VALORISSRETENCAO, :NEW_COI_V' +
        'ALORPIS, '
      
        '  :NEW_COI_VALORPISST, :NEW_COI_VALORSEGURO, :NEW_COI_VALORTOTAL' +
        ', '
      
        '  :NEW_COI_VALORTOTALBRUTO, :NEW_COI_VALORTRIBUTOS, :NEW_COI_VAL' +
        'ORTRIBUTOSEST, '
      
        '  :NEW_COI_VALORTRIBUTOSFED, :NEW_COI_VALORTRIBUTOSIMP, :NEW_COI' +
        '_VALORTRIBUTOSMUN, '
      '  :NEW_COI_VALORUNIT)'
      
        'RETURNING COI_ALIQCOFINS, COI_ALIQCOFINSST, COI_ALIQFCP, COI_ALI' +
        'QICMS, COI_ALIQICMSADICST, COI_ALIQICMSINTER, COI_ALIQICMSINTERP' +
        'ART, COI_ALIQICMSRED, COI_ALIQICMSST, COI_ALIQIPI, COI_ALIQISS, ' +
        'COI_ALIQPIS, COI_ALIQPISST, COI_ALMOXARIFADO, COI_BASECOFINS, CO' +
        'I_BASECOFINSST, COI_BASEICMS, COI_BASEICMSRED, COI_BASEICMSST, C' +
        'OI_BASEIPI, COI_BASEISS, COI_BASEPIS, COI_BASEPISST, COI_CEST, C' +
        'OI_CFOP, COI_CIDADEISS, COI_CLASSFISCAL, COI_CODIGO, COI_CODIGOB' +
        'ARRAS, COI_COMPLEMENTO, COI_COMPOEBASEICMS, COI_COMPOEBASEICMSST' +
        ', COI_COMPRA, COI_CONVERSAO, COI_CSTCOFINS, COI_CSTICMS, COI_CST' +
        'IPI, COI_CSTPIS, COI_DESCPORC, COI_DESCRICAO, COI_DESCVALOR, COI' +
        '_DTENTREGA, COI_ENQUADRAMENTOIPI, COI_EXCECAO, COI_FCI, COI_INCE' +
        'NTIVOISS, COI_INDICADORISS, COI_INFOADICIONAL, COI_MODICMS, COI_' +
        'MODICMSST, COI_ORIGEM, COI_PAISISS, COI_PESO, COI_PESOTOTAL, COI' +
        '_PROCESSOISS, COI_PRODUTO, COI_PRODUTOREAL, COI_QUANTIDADE, COI_' +
        'SERVICOISS, COI_TIPO, COI_TIPOISS, COI_UNIDADE, COI_VALORACESSOR' +
        'IAS, COI_VALORCOFINS, COI_VALORCOFINSST, COI_VALORFCP, COI_VALOR' +
        'FRETE, COI_VALORICMS, COI_VALORICMSCREDSN, COI_VALORICMSST, COI_' +
        'VALORICMSUFDEST, COI_VALORICMSUFREMET, COI_VALORIPI, COI_VALORIS' +
        'S, COI_VALORISSDEDUCAO, COI_VALORISSDESCCOND, COI_VALORISSDESCIN' +
        'COND, COI_VALORISSOUTROS, COI_VALORISSRETENCAO, COI_VALORPIS, CO' +
        'I_VALORPISST, COI_VALORSEGURO, COI_VALORTOTAL, COI_VALORTOTALBRU' +
        'TO, COI_VALORTRIBUTOS, COI_VALORTRIBUTOSEST, COI_VALORTRIBUTOSFE' +
        'D, COI_VALORTRIBUTOSIMP, COI_VALORTRIBUTOSMUN, COI_VALORUNIT')
    ModifySQL.Strings = (
      'UPDATE COMPRASITENS'
      
        'SET COI_ALIQCOFINS = :NEW_COI_ALIQCOFINS, COI_ALIQCOFINSST = :NE' +
        'W_COI_ALIQCOFINSST, '
      
        '  COI_ALIQFCP = :NEW_COI_ALIQFCP, COI_ALIQICMS = :NEW_COI_ALIQIC' +
        'MS, '
      
        '  COI_ALIQICMSADICST = :NEW_COI_ALIQICMSADICST, COI_ALIQICMSINTE' +
        'R = :NEW_COI_ALIQICMSINTER, '
      
        '  COI_ALIQICMSINTERPART = :NEW_COI_ALIQICMSINTERPART, COI_ALIQIC' +
        'MSRED = :NEW_COI_ALIQICMSRED, '
      
        '  COI_ALIQICMSST = :NEW_COI_ALIQICMSST, COI_ALIQIPI = :NEW_COI_A' +
        'LIQIPI, '
      
