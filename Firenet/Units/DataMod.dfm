      '  NOI_DICNPJ, NOI_DIDATA, NOI_DIDESEMBARACODATA, '
      
        '  NOI_DIDESEMBARACOLOCAL, NOI_DIDESEMBARACOUF, NOI_DIEXPORTADORC' +
        'OD, '
      '  NOI_DIINTERMEDIO, NOI_DINUMERO, NOI_DITERCEIROUF, '
      '  NOI_DITRANSPORTE, NOI_DIVALORAFRMM, NOI_ENQUADRAMENTOIPI, '
      '  NOI_EXCECAO, NOI_EXCHAVEACESSO, NOI_EXDRAWBACK, '
      '  NOI_EXQUANTIDADE, NOI_EXREGISTRO, NOI_FCI, '
      '  NOI_INCENTIVOISS, NOI_INDICADORISS, NOI_INFOADICIONAL, '
      '  NOI_LOCALIZACAO, NOI_LOTE, NOI_LUCROPORC, '
      '  NOI_LUCROVALOR, NOI_MODICMS, NOI_MODICMSST, '
      '  NOI_NOTA, NOI_ORIGEM, NOI_PAISISS, NOI_PEDIDOCLIENTE, '
