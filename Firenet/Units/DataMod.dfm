  object UPServicosHoras: TFDUpdateSQL
    Connection = FDConnection1
    InsertSQL.Strings = (
      'INSERT INTO SERVICOSHORAS'
      '(SEH_CODIGO, SEH_DATA, SEH_DTATUALIZACAO, SEH_DTCADASTRO, '
      '  SEH_FUNCIONARIO, SEH_HORAFIM, SEH_HORAFIMMIN, '
      '  SEH_HORAINICIO, SEH_HORAINICIOMIN, SEH_HRATUALIZACAO, '
      '  SEH_HRCADASTRO, SEH_SERVICO, SEH_TOTALHORAS, '
      '  SEH_TOTALHORASDEC, SEH_TOTALHORASMIN, SEH_USUARIO)'
      
        'VALUES (gen_id(GEN_SERVICOSHORAS,1), :NEW_SEH_DATA, :NEW_SEH_DTA' +
        'TUALIZACAO, :NEW_SEH_DTCADASTRO, '
      '  :NEW_SEH_FUNCIONARIO, :NEW_SEH_HORAFIM, :NEW_SEH_HORAFIMMIN, '
      
        '  :NEW_SEH_HORAINICIO, :NEW_SEH_HORAINICIOMIN, :NEW_SEH_HRATUALI' +
        'ZACAO, '
      '  :NEW_SEH_HRCADASTRO, :NEW_SEH_SERVICO, :NEW_SEH_TOTALHORAS, '
      
        '  :NEW_SEH_TOTALHORASDEC, :NEW_SEH_TOTALHORASMIN, :NEW_SEH_USUAR' +
        'IO)'
      
        'RETURNING SEH_CODIGO, SEH_DATA, SEH_DTATUALIZACAO, SEH_DTCADASTR' +
        'O, SEH_FUNCIONARIO, SEH_HORAFIM, SEH_HORAFIMMIN, SEH_HORAINICIO,' +
        ' SEH_HORAINICIOMIN, SEH_HRATUALIZACAO, SEH_HRCADASTRO, SEH_SERVI' +
        'CO, SEH_TOTALHORAS, SEH_TOTALHORASDEC, SEH_TOTALHORASMIN, SEH_US' +
        'UARIO')
    ModifySQL.Strings = (
      'UPDATE SERVICOSHORAS'
      
        'SET SEH_CODIGO = :NEW_SEH_CODIGO, SEH_DATA = :NEW_SEH_DATA, SEH_' +
        'DTATUALIZACAO = :NEW_SEH_DTATUALIZACAO, '
      
        '  SEH_DTCADASTRO = :NEW_SEH_DTCADASTRO, SEH_FUNCIONARIO = :NEW_S' +
        'EH_FUNCIONARIO, '
      
        '  SEH_HORAFIM = :NEW_SEH_HORAFIM, SEH_HORAFIMMIN = :NEW_SEH_HORA' +
        'FIMMIN, '
      
        '  SEH_HORAINICIO = :NEW_SEH_HORAINICIO, SEH_HORAINICIOMIN = :NEW' +
        '_SEH_HORAINICIOMIN, '
      
        '  SEH_HRATUALIZACAO = :NEW_SEH_HRATUALIZACAO, SEH_HRCADASTRO = :' +
        'NEW_SEH_HRCADASTRO, '
      
        '  SEH_SERVICO = :NEW_SEH_SERVICO, SEH_TOTALHORAS = :NEW_SEH_TOTA' +
        'LHORAS, '
      
        '  SEH_TOTALHORASDEC = :NEW_SEH_TOTALHORASDEC, SEH_TOTALHORASMIN ' +
        '= :NEW_SEH_TOTALHORASMIN, '
      '  SEH_USUARIO = :NEW_SEH_USUARIO'
      'WHERE SEH_CODIGO = :OLD_SEH_CODIGO'
      
        'RETURNING SEH_CODIGO, SEH_DATA, SEH_DTATUALIZACAO, SEH_DTCADASTR' +
        'O, SEH_FUNCIONARIO, SEH_HORAFIM, SEH_HORAFIMMIN, SEH_HORAINICIO,' +
        ' SEH_HORAINICIOMIN, SEH_HRATUALIZACAO, SEH_HRCADASTRO, SEH_SERVI' +
        'CO, SEH_TOTALHORAS, SEH_TOTALHORASDEC, SEH_TOTALHORASMIN, SEH_US' +
        'UARIO')
    DeleteSQL.Strings = (
      'DELETE FROM SERVICOSHORAS'
      'WHERE SEH_CODIGO = :OLD_SEH_CODIGO')
    FetchRowSQL.Strings = (
      
        'SELECT SEH_CODIGO, SEH_DATA, SEH_DTATUALIZACAO, SEH_DTCADASTRO, ' +
        'SEH_FUNCIONARIO, '
      
        '  SEH_HORAFIM, SEH_HORAFIMMIN, SEH_HORAINICIO, SEH_HORAINICIOMIN' +
        ', '
      
        '  SEH_HRATUALIZACAO, SEH_HRCADASTRO, SEH_SERVICO, SEH_TOTALHORAS' +
        ', '
      '  SEH_TOTALHORASDEC, SEH_TOTALHORASMIN, SEH_USUARIO'
      'FROM SERVICOSHORAS'
      'WHERE SEH_CODIGO = :OLD_SEH_CODIGO')
    Left = 712
    Top = 424
  end
