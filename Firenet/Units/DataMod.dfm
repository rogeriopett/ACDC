        'F, '
      
        '  :NEW_NOI_DITRANSPORTE, :NEW_NOI_DIVALORAFRMM, :NEW_NOI_ENQUADR' +
        'AMENTOIPI, '
      
        '  :NEW_NOI_EXCECAO, :NEW_NOI_EXCHAVEACESSO, :NEW_NOI_EXDRAWBACK,' +
        ' '
