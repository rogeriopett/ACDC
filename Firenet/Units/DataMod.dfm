  object UPVendedoresHist: TFDUpdateSQL
    Connection = FDConnection1
    InsertSQL.Strings = (
      'INSERT INTO VENDEDORESHIST'
      '(VEH_CODIGO, VEH_DATA, VEH_DESCRICAO, VEH_DTATUALIZACAO, '
      '  VEH_DTCADASTRO, VEH_HRATUALIZACAO, VEH_HRCADASTRO, '
      '  VEH_OBSERVACOES, VEH_TIPO, VEH_USUARIO, VEH_VENDEDOR)'
      
        'VALUES (gen_id(GEN_VENDEDORESHIST,1), :NEW_VEH_DATA, :NEW_VEH_DE' +
        'SCRICAO, :NEW_VEH_DTATUALIZACAO, '
      
        '  :NEW_VEH_DTCADASTRO, :NEW_VEH_HRATUALIZACAO, :NEW_VEH_HRCADAST' +
        'RO, '
      
        '  :NEW_VEH_OBSERVACOES, :NEW_VEH_TIPO, :NEW_VEH_USUARIO, :NEW_VE' +
        'H_VENDEDOR)'
      
        'RETURNING VEH_CODIGO, VEH_DATA, VEH_DESCRICAO, VEH_DTATUALIZACAO' +
        ', VEH_DTCADASTRO, VEH_HRATUALIZACAO, VEH_HRCADASTRO, VEH_OBSERVA' +
        'COES, VEH_TIPO, VEH_USUARIO, VEH_VENDEDOR')
    ModifySQL.Strings = (
      'UPDATE VENDEDORESHIST'
      
        'SET VEH_CODIGO = :NEW_VEH_CODIGO, VEH_DATA = :NEW_VEH_DATA, VEH_' +
        'DESCRICAO = :NEW_VEH_DESCRICAO, '
      
        '  VEH_DTATUALIZACAO = :NEW_VEH_DTATUALIZACAO, VEH_DTCADASTRO = :' +
        'NEW_VEH_DTCADASTRO, '
      
        '  VEH_HRATUALIZACAO = :NEW_VEH_HRATUALIZACAO, VEH_HRCADASTRO = :' +
        'NEW_VEH_HRCADASTRO, '
      
        '  VEH_OBSERVACOES = :NEW_VEH_OBSERVACOES, VEH_TIPO = :NEW_VEH_TI' +
        'PO, '
      
        '  VEH_USUARIO = :NEW_VEH_USUARIO, VEH_VENDEDOR = :NEW_VEH_VENDED' +
        'OR'
      'WHERE VEH_CODIGO = :OLD_VEH_CODIGO'
      
        'RETURNING VEH_CODIGO, VEH_DATA, VEH_DESCRICAO, VEH_DTATUALIZACAO' +
        ', VEH_DTCADASTRO, VEH_HRATUALIZACAO, VEH_HRCADASTRO, VEH_OBSERVA' +
        'COES, VEH_TIPO, VEH_USUARIO, VEH_VENDEDOR')
    DeleteSQL.Strings = (
      'DELETE FROM VENDEDORESHIST'
      'WHERE VEH_CODIGO = :OLD_VEH_CODIGO')
    FetchRowSQL.Strings = (
      
        'SELECT VEH_CODIGO, VEH_DATA, VEH_DESCRICAO, VEH_DTATUALIZACAO, V' +
        'EH_DTCADASTRO, '
      '  VEH_HRATUALIZACAO, VEH_HRCADASTRO, VEH_OBSERVACOES, VEH_TIPO, '
      '  VEH_USUARIO, VEH_VENDEDOR'
      'FROM VENDEDORESHIST'
      'WHERE VEH_CODIGO = :OLD_VEH_CODIGO')
    Left = 1032
    Top = 424
  end
