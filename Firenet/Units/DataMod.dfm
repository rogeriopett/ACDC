        '  :NEW_NOI_VALORICMSUFREMET, :NEW_NOI_VALORII, :NEW_NOI_VALORIOF' +
        ', '
      
        '  :NEW_NOI_VALORIPI, :NEW_NOI_VALORISS, :NEW_NOI_VALORISSDEDUCAO' +
        ', '
      '  :NEW_NOI_VALORISSDESCCOND, :NEW_NOI_VALORISSDESCINCOND, '
      
        '  :NEW_NOI_VALORISSOUTROS, :NEW_NOI_VALORISSRETENCAO, :NEW_NOI_V' +
        'ALORPIS, '
      
        '  :NEW_NOI_VALORPISST, :NEW_NOI_VALORSEGURO, :NEW_NOI_VALORTOTAL' +
        ', '
      
        '  :NEW_NOI_VALORTOTALBRUTO, :NEW_NOI_VALORTRIBUTOS, :NEW_NOI_VAL' +
        'ORTRIBUTOSEST, '
      
        '  :NEW_NOI_VALORTRIBUTOSFED, :NEW_NOI_VALORTRIBUTOSIMP, :NEW_NOI' +
        '_VALORTRIBUTOSMUN, '
      '  :NEW_NOI_VALORUNIT)'
      
        'RETURNING NOI_ALIQCOFINS, NOI_ALIQCOFINSST, NOI_ALIQFCP, NOI_ALI' +
        'QFCPST, NOI_ALIQICMS, NOI_ALIQICMSADICST, NOI_ALIQICMSINTER, NOI' +
        '_ALIQICMSINTERPART, NOI_ALIQICMSRED, NOI_ALIQICMSST, NOI_ALIQICM' +
        'SSTRET, NOI_ALIQII, NOI_ALIQIPI, NOI_ALIQISS, NOI_ALIQPIS, NOI_A' +
        'LIQPISST, NOI_ALMOXARIFADO, NOI_BASECOFINS, NOI_BASECOFINSST, NO' +
        'I_BASEICMS, NOI_BASEICMSRED, NOI_BASEICMSST, NOI_BASEICMSSTRET, ' +
        'NOI_BASEII, NOI_BASEIPI, NOI_BASEISS, NOI_BASEPIS, NOI_BASEPISST' +
        ', NOI_BENEFICIO, NOI_CEST, NOI_CFOP, NOI_CIDADEISS, NOI_CLASSFIS' +
        'CAL, NOI_CODIGO, NOI_CODIGOBARRAS, NOI_CODIGOFAB, NOI_COMISSAO, ' +
        'NOI_COMPLEMENTO, NOI_COMPOEBASEICMS, NOI_COMPOEBASEICMSST, NOI_C' +
        'OMPOETOTAL, NOI_CONVERSAO, NOI_CSTCOFINS, NOI_CSTICMS, NOI_CSTIP' +
        'I, NOI_CSTPIS, NOI_DESCMAX, NOI_DESCPORC, NOI_DESCRICAO, NOI_DES' +
        'CVALOR, NOI_DESONERACAO, NOI_DICNPJ, NOI_DIDATA, NOI_DIDESEMBARA' +
        'CODATA, NOI_DIDESEMBARACOLOCAL, NOI_DIDESEMBARACOUF, NOI_DIEXPOR' +
        'TADORCOD, NOI_DIINTERMEDIO, NOI_DINUMERO, NOI_DITERCEIROUF, NOI_' +
        'DITRANSPORTE, NOI_DIVALORAFRMM, NOI_ENQUADRAMENTOIPI, NOI_EXCECA' +
