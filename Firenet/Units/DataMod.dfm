      '  MAN_HRCONSULTA, MAN_IE, MAN_JUSTIFICATIVA, '
      '  MAN_NOME, MAN_NSU, MAN_PROTOCOLO, MAN_SCHEMA, '
      '  MAN_SEQUENCIAEVENTO, MAN_STATUSNOTA, MAN_TIPOEVENTO, '
      '  MAN_TIPONOTA, MAN_USUARIO, MAN_VALORNOTA, '
      '  MAN_XML)'
      
        'VALUES (:NEW_MAN_CHAVEACESSO, :NEW_MAN_CIENCIA, :NEW_MAN_CIENCIA' +
        'DH, '
      '  :NEW_MAN_CIENCIAPROTOCOLO, :NEW_MAN_CIENCIAPROTOCOLODH, '
      
        '  gen_id(GEN_MANIFESTACOES,1), :NEW_MAN_CONCLUSAO, :NEW_MAN_CONC' +
        'LUSAODH, '
