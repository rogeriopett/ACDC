        'PETM, '
      
        '  CLT_DOCCTE = :NEW_CLT_DOCCTE, CLT_DOCCTEOS = :NEW_CLT_DOCCTEOS' +
        ', '
      '  CLT_DOCDERE = :NEW_CLT_DOCDERE, CLT_DOCDIR = :NEW_CLT_DOCDIR, '
      
        '  CLT_DOCDUIMP = :NEW_CLT_DOCDUIMP, CLT_DOCNFAG = :NEW_CLT_DOCNF' +
        'AG, '
      
        '  CLT_DOCNFCE = :NEW_CLT_DOCNFCE, CLT_DOCNFCOM = :NEW_CLT_DOCNFC' +
        'OM, '
      
        '  CLT_DOCNFEABI = :NEW_CLT_DOCNFEABI, CLT_DOCNFE = :NEW_CLT_DOCN' +
        'FE, '
      
        '  CLT_DOCNFGAS = :NEW_CLT_DOCNFGAS, CLT_DOCNFSE = :NEW_CLT_DOCNF' +
        'SE, '
      
        '  CLT_DOCNFSEVIA = :NEW_CLT_DOCNFSEVIA, CLT_DOCNF3E = :NEW_CLT_D' +
        'OCNF3E, '
      
        '  CLT_DTATUALIZACAO = :NEW_CLT_DTATUALIZACAO, CLT_DTCADASTRO = :' +
        'NEW_CLT_DTCADASTRO, '
      
        '  CLT_DTPUBLICACAO = :NEW_CLT_DTPUBLICACAO, CLT_DTVIGENCIAINICIO' +
        ' = :NEW_CLT_DTVIGENCIAINICIO, '
      
        '  CLT_DTVIGENCIAFIM = :NEW_CLT_DTVIGENCIAFIM, CLT_ESTORNOCREDITO' +
        ' = :NEW_CLT_ESTORNOCREDITO, '
      
        '  CLT_HRATUALIZACAO = :NEW_CLT_HRATUALIZACAO, CLT_HRCADASTRO = :' +
