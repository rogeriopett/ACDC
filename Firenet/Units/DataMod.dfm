        '  CLT_LINK = :NEW_CLT_LINK, CLT_MONODIFERIMENTO = :NEW_CLT_MONOD' +
        'IFERIMENTO, '
      
        '  CLT_MONOFASICO = :NEW_CLT_MONOFASICO, CLT_MONORETENCAO = :NEW_' +
        'CLT_MONORETENCAO, '
      
        '  CLT_MONORETIDO = :NEW_CLT_MONORETIDO, CLT_REDBASE = :NEW_CLT_R' +
        'EDBASE, '
      
        '  CLT_TIPOALIQUOTA = :NEW_CLT_TIPOALIQUOTA, CLT_TIPORECEITA = :N' +
        'EW_CLT_TIPORECEITA, '
      
        '  CLT_TRIBUTACAOREGULAR = :NEW_CLT_TRIBUTACAOREGULAR, CLT_USUARI' +
        'O = :NEW_CLT_USUARIO'
      'WHERE CLT_CODIGO = :OLD_CLT_CODIGO'
      
        'RETURNING CLT_ALIQCBSRED, CLT_ALIQIBSRED, CLT_CODIGO, CLT_CREDIT' +
        'OPRESUMIDO, CLT_DESCRICAO, CLT_DOCBPE, CLT_DOCBPETA, CLT_DOCBPET' +
        'M, CLT_DOCCTE, CLT_DOCCTEOS, CLT_DOCDERE, CLT_DOCDIR, CLT_DOCDUI' +
