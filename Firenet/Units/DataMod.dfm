        'RO, '
      
        '  :NEW_ECF_MARCA, :NEW_ECF_MODELO, :NEW_ECF_SERIAL, :NEW_ECF_STA' +
        'TUS, '
      '  :NEW_ECF_USUARIO)'
      
        'RETURNING ECF_CODIGO, ECF_DESCRICAO, ECF_DTATUALIZACAO, ECF_DTCA' +
        'DASTRO, ECF_HRATUALIZACAO, ECF_HRCADASTRO, ECF_MARCA, ECF_MODELO' +
        ', ECF_SERIAL, ECF_STATUS, ECF_USUARIO')
    ModifySQL.Strings = (
