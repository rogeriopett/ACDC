        'RO, '
      '  :NEW_PRF_PRINCIPAL, :NEW_PRF_PRODUTO, :NEW_PRF_USUARIO)'
      
        'RETURNING PRF_ARQUIVO, PRF_CODIGO, PRF_DESCRICAO, PRF_DTATUALIZA' +
        'CAO, PRF_DTCADASTRO, PRF_HRATUALIZACAO, PRF_HRCADASTRO, PRF_PRIN' +
        'CIPAL, PRF_PRODUTO, PRF_USUARIO')
    ModifySQL.Strings = (
