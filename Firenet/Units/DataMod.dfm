        'MPOMIN, '
      '  :NEW_ETP_USUARIO)'
      
        'RETURNING ETP_CODIGO, ETP_DESCRICAO, ETP_DTATUALIZACAO, ETP_DTCA' +
        'DASTRO, ETP_HRATUALIZACAO, ETP_HRCADASTRO, ETP_SIGLA, ETP_TEMPO,' +
