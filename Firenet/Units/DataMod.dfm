      'WHERE ESD_CODIGO = :OLD_ESD_CODIGO')
    FetchRowSQL.Strings = (
      'SELECT ESD_CODIGO, ESD_NOME, ESD_PAIS, ESD_SIGLA'
      'FROM ESTADOS'
      'WHERE ESD_CODIGO = :OLD_ESD_CODIGO')
