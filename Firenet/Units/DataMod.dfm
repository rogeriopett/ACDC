  object UPNotasCodigo: TFDUpdateSQL
    Connection = FDConnection1
    InsertSQL.Strings = (
      'INSERT INTO NOTASCODIGO'
      '(NOT_CODIGO)'
      'VALUES (:NEW_NOT_CODIGO)'
      'RETURNING NOT_CODIGO')
    ModifySQL.Strings = (
      'UPDATE NOTASCODIGO'
      'SET NOT_CODIGO = :NEW_NOT_CODIGO'
      'WHERE NOT_CODIGO = :OLD_NOT_CODIGO'
      'RETURNING NOT_CODIGO')
    DeleteSQL.Strings = (
      'DELETE FROM NOTASCODIGO'
      'WHERE NOT_CODIGO = :OLD_NOT_CODIGO')
    FetchRowSQL.Strings = (
      'SELECT NOT_CODIGO'
      'FROM NOTASCODIGO'
      'WHERE NOT_CODIGO = :OLD_NOT_CODIGO')
    Left = 1160
    Top = 264
  end
