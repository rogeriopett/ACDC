  object UPContasMov: TFDUpdateSQL
    Connection = FDConnection1
    InsertSQL.Strings = (
      'INSERT INTO CONTASMOV'
      '(CMO_CODIGO, CMO_CONTA, CMO_DESCRICAO, CMO_DTATUALIZACAO, '
      '  CMO_DTCADASTRO, CMO_DTMOVIMENTO, CMO_ENTRADASAIDA, '
      '  CMO_HRATUALIZACAO, CMO_HRCADASTRO, CMO_NUMDOCTO, '
      '  CMO_OBSERVACOES, CMO_ORIGEM, CMO_SALDOANTERIOR, '
      '  CMO_SALDOPOSTERIOR, CMO_TIPODOCTO, CMO_USUARIO, '
      '  CMO_VALOR)'
      
        'VALUES (gen_id(GEN_CONTASMOV,1), :NEW_CMO_CONTA, :NEW_CMO_DESCRI' +
        'CAO, :NEW_CMO_DTATUALIZACAO, '
      
        '  :NEW_CMO_DTCADASTRO, :NEW_CMO_DTMOVIMENTO, :NEW_CMO_ENTRADASAI' +
        'DA, '
      
        '  :NEW_CMO_HRATUALIZACAO, :NEW_CMO_HRCADASTRO, :NEW_CMO_NUMDOCTO' +
        ', '
      
        '  :NEW_CMO_OBSERVACOES, :NEW_CMO_ORIGEM, :NEW_CMO_SALDOANTERIOR,' +
        ' '
      
        '  :NEW_CMO_SALDOPOSTERIOR, :NEW_CMO_TIPODOCTO, :NEW_CMO_USUARIO,' +
        ' '
      '  :NEW_CMO_VALOR)'
      
        'RETURNING CMO_CODIGO, CMO_CONTA, CMO_DESCRICAO, CMO_DTATUALIZACA' +
        'O, CMO_DTCADASTRO, CMO_DTMOVIMENTO, CMO_ENTRADASAIDA, CMO_HRATUA' +
        'LIZACAO, CMO_HRCADASTRO, CMO_NUMDOCTO, CMO_OBSERVACOES, CMO_ORIG' +
        'EM, CMO_SALDOANTERIOR, CMO_SALDOPOSTERIOR, CMO_TIPODOCTO, CMO_US' +
        'UARIO, CMO_VALOR')
    ModifySQL.Strings = (
      'UPDATE CONTASMOV'
      
        'SET CMO_CODIGO = :NEW_CMO_CODIGO, CMO_CONTA = :NEW_CMO_CONTA, CM' +
        'O_DESCRICAO = :NEW_CMO_DESCRICAO, '
      
        '  CMO_DTATUALIZACAO = :NEW_CMO_DTATUALIZACAO, CMO_DTCADASTRO = :' +
        'NEW_CMO_DTCADASTRO, '
      
        '  CMO_DTMOVIMENTO = :NEW_CMO_DTMOVIMENTO, CMO_ENTRADASAIDA = :NE' +
        'W_CMO_ENTRADASAIDA, '
      
        '  CMO_HRATUALIZACAO = :NEW_CMO_HRATUALIZACAO, CMO_HRCADASTRO = :' +
        'NEW_CMO_HRCADASTRO, '
      
        '  CMO_NUMDOCTO = :NEW_CMO_NUMDOCTO, CMO_OBSERVACOES = :NEW_CMO_O' +
        'BSERVACOES, '
      
        '  CMO_ORIGEM = :NEW_CMO_ORIGEM, CMO_SALDOANTERIOR = :NEW_CMO_SAL' +
        'DOANTERIOR, '
      
        '  CMO_SALDOPOSTERIOR = :NEW_CMO_SALDOPOSTERIOR, CMO_TIPODOCTO = ' +
        ':NEW_CMO_TIPODOCTO, '
      '  CMO_USUARIO = :NEW_CMO_USUARIO, CMO_VALOR = :NEW_CMO_VALOR'
      'WHERE CMO_CODIGO = :OLD_CMO_CODIGO'
      
        'RETURNING CMO_CODIGO, CMO_CONTA, CMO_DESCRICAO, CMO_DTATUALIZACA' +
        'O, CMO_DTCADASTRO, CMO_DTMOVIMENTO, CMO_ENTRADASAIDA, CMO_HRATUA' +
        'LIZACAO, CMO_HRCADASTRO, CMO_NUMDOCTO, CMO_OBSERVACOES, CMO_ORIG' +
        'EM, CMO_SALDOANTERIOR, CMO_SALDOPOSTERIOR, CMO_TIPODOCTO, CMO_US' +
        'UARIO, CMO_VALOR')
    DeleteSQL.Strings = (
      'DELETE FROM CONTASMOV'
      'WHERE CMO_CODIGO = :OLD_CMO_CODIGO')
    FetchRowSQL.Strings = (
      
        'SELECT CMO_CODIGO, CMO_CONTA, CMO_DESCRICAO, CMO_DTATUALIZACAO, ' +
        'CMO_DTCADASTRO, '
      
        '  CMO_DTMOVIMENTO, CMO_ENTRADASAIDA, CMO_HRATUALIZACAO, CMO_HRCA' +
        'DASTRO, '
      '  CMO_NUMDOCTO, CMO_OBSERVACOES, CMO_ORIGEM, CMO_SALDOANTERIOR, '
      '  CMO_SALDOPOSTERIOR, CMO_TIPODOCTO, CMO_USUARIO, CMO_VALOR'
      'FROM CONTASMOV'
      'WHERE CMO_CODIGO = :OLD_CMO_CODIGO')
    Left = 712
    Top = 104
  end
