        'RDEM, '
      '  PET_PRODUTO = :NEW_PET_PRODUTO, PET_USUARIO = :NEW_PET_USUARIO'
      'WHERE PET_CODIGO = :OLD_PET_CODIGO'
      
        'RETURNING PET_CODIGO, PET_DTATUALIZACAO, PET_DTCADASTRO, PET_ETA' +
        'PA, PET_HRATUALIZACAO, PET_HRCADASTRO, PET_OBSERVACOES, PET_ORDE' +
