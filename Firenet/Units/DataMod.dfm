        '_EST_HRATUALIZACAO, '
      
        '  EST_HRCADASTRO = :NEW_EST_HRCADASTRO, EST_NUMDOCTO = :NEW_EST_' +
        'NUMDOCTO, '
      
        '  EST_OBSERVACOES = :NEW_EST_OBSERVACOES, EST_PRODUTO = :NEW_EST' +
