  object UPFci: TFDUpdateSQL
    Connection = FDConnection1
    InsertSQL.Strings = (
      'INSERT INTO FCI'
      '(PFI_CODIGO, PFI_DTATUALIZACAO, PFI_DTCADASTRO, '
      '  PFI_DTENVIO, PFI_HRATUALIZACAO, PFI_HRCADASTRO, '
      '  PFI_HRENVIO, PFI_PROTOCOLO, PFI_QUANTIDADEITENS, '
      '  PFI_STATUS, PFI_USUARIO)'
      
        'VALUES (gen_id(GEN_FCI,1), :NEW_PFI_DTATUALIZACAO, :NEW_PFI_DTCA' +
        'DASTRO, '
      
        '  :NEW_PFI_DTENVIO, :NEW_PFI_HRATUALIZACAO, :NEW_PFI_HRCADASTRO,' +
        ' '
      
        '  :NEW_PFI_HRENVIO, :NEW_PFI_PROTOCOLO, :NEW_PFI_QUANTIDADEITENS' +
        ', '
      '  :NEW_PFI_STATUS, :NEW_PFI_USUARIO)'
      
        'RETURNING PFI_CODIGO, PFI_DTATUALIZACAO, PFI_DTCADASTRO, PFI_DTE' +
        'NVIO, PFI_HRATUALIZACAO, PFI_HRCADASTRO, PFI_HRENVIO, PFI_PROTOC' +
        'OLO, PFI_QUANTIDADEITENS, PFI_STATUS, PFI_USUARIO')
    ModifySQL.Strings = (
      'UPDATE FCI'
      
        'SET PFI_CODIGO = :NEW_PFI_CODIGO, PFI_DTATUALIZACAO = :NEW_PFI_D' +
        'TATUALIZACAO, '
      
        '  PFI_DTCADASTRO = :NEW_PFI_DTCADASTRO, PFI_DTENVIO = :NEW_PFI_D' +
        'TENVIO, '
      
        '  PFI_HRATUALIZACAO = :NEW_PFI_HRATUALIZACAO, PFI_HRCADASTRO = :' +
        'NEW_PFI_HRCADASTRO, '
      
        '  PFI_HRENVIO = :NEW_PFI_HRENVIO, PFI_PROTOCOLO = :NEW_PFI_PROTO' +
        'COLO, '
      
        '  PFI_QUANTIDADEITENS = :NEW_PFI_QUANTIDADEITENS, PFI_STATUS = :' +
        'NEW_PFI_STATUS, '
      '  PFI_USUARIO = :NEW_PFI_USUARIO'
      'WHERE PFI_CODIGO = :OLD_PFI_CODIGO'
      
        'RETURNING PFI_CODIGO, PFI_DTATUALIZACAO, PFI_DTCADASTRO, PFI_DTE' +
        'NVIO, PFI_HRATUALIZACAO, PFI_HRCADASTRO, PFI_HRENVIO, PFI_PROTOC' +
