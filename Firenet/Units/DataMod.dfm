      'from NFE '
      'left join CLIENTES on NFE_CLIENTE=CLI_CODIGO'
      'left join CONDICOES on NFE_CONDICAO=CPG_CODIGO'
      'left join NATUREZAS on NFE_CFOP=NAT_CODIGO'
      
        'left join VENDEDORES as vendedores on NFE_VENDEDOR=vendedores.VE' +
        'N_CODIGO'
      
        'left join VENDEDORES as expedidores on NFE_EXPEDIDOPOR=expedidor' +
        'es.VEN_CODIGO'
      
        'left join VENDEDORES as representantes on NFE_REPRESENTANTE=repr' +
        'esentantes.VEN_CODIGO'
      'where NFE_CODIGO=:codigo'
      '')
    Left = 808
    Top = 232
    ParamData = <
      item
        Name = 'CODIGO'
        DataType = ftInteger
        ParamType = ptInput
      end>
