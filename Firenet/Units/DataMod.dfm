  object UPNfeCce: TFDUpdateSQL
    Connection = FDConnection1
    InsertSQL.Strings = (
      'INSERT INTO NFECCE'
      '(NCC_CODIGO, NCC_DATA, NCC_DTATUALIZACAO, NCC_DTCADASTRO, '
      '  NCC_HORA, NCC_HRATUALIZACAO, NCC_HRCADASTRO, '
      '  NCC_NFE, NCC_PROTOCOLO, NCC_PROTOCOLODH, '
      '  NCC_SEQUENCIAL, NCC_TEXTO, NCC_USUARIO)'
      
        'VALUES (gen_id(GEN_NFECCE,1), :NEW_NCC_DATA, :NEW_NCC_DTATUALIZA' +
        'CAO, :NEW_NCC_DTCADASTRO, '
      '  :NEW_NCC_HORA, :NEW_NCC_HRATUALIZACAO, :NEW_NCC_HRCADASTRO, '
      '  :NEW_NCC_NFE, :NEW_NCC_PROTOCOLO, :NEW_NCC_PROTOCOLODH, '
      '  :NEW_NCC_SEQUENCIAL, :NEW_NCC_TEXTO, :NEW_NCC_USUARIO)'
      
        'RETURNING NCC_CODIGO, NCC_DATA, NCC_DTATUALIZACAO, NCC_DTCADASTR' +
        'O, NCC_HORA, NCC_HRATUALIZACAO, NCC_HRCADASTRO, NCC_NFE, NCC_PRO' +
        'TOCOLO, NCC_PROTOCOLODH, NCC_SEQUENCIAL, NCC_TEXTO, NCC_USUARIO')
    ModifySQL.Strings = (
      'UPDATE NFECCE'
      
        'SET NCC_CODIGO = :NEW_NCC_CODIGO, NCC_DATA = :NEW_NCC_DATA, NCC_' +
        'DTATUALIZACAO = :NEW_NCC_DTATUALIZACAO, '
      
        '  NCC_DTCADASTRO = :NEW_NCC_DTCADASTRO, NCC_HORA = :NEW_NCC_HORA' +
        ', '
      
        '  NCC_HRATUALIZACAO = :NEW_NCC_HRATUALIZACAO, NCC_HRCADASTRO = :' +
        'NEW_NCC_HRCADASTRO, '
      '  NCC_NFE = :NEW_NCC_NFE, NCC_PROTOCOLO = :NEW_NCC_PROTOCOLO, '
      
        '  NCC_PROTOCOLODH = :NEW_NCC_PROTOCOLODH, NCC_SEQUENCIAL = :NEW_' +
        'NCC_SEQUENCIAL, '
      '  NCC_TEXTO = :NEW_NCC_TEXTO, NCC_USUARIO = :NEW_NCC_USUARIO'
      'WHERE NCC_CODIGO = :OLD_NCC_CODIGO'
      
        'RETURNING NCC_CODIGO, NCC_DATA, NCC_DTATUALIZACAO, NCC_DTCADASTR' +
        'O, NCC_HORA, NCC_HRATUALIZACAO, NCC_HRCADASTRO, NCC_NFE, NCC_PRO' +
        'TOCOLO, NCC_PROTOCOLODH, NCC_SEQUENCIAL, NCC_TEXTO, NCC_USUARIO')
    DeleteSQL.Strings = (
      'DELETE FROM NFECCE'
      'WHERE NCC_CODIGO = :OLD_NCC_CODIGO')
    FetchRowSQL.Strings = (
      
        'SELECT NCC_CODIGO, NCC_DATA, NCC_DTATUALIZACAO, NCC_DTCADASTRO, ' +
        'NCC_HORA, '
      '  NCC_HRATUALIZACAO, NCC_HRCADASTRO, NCC_NFE, NCC_PROTOCOLO, '
      '  NCC_PROTOCOLODH, NCC_SEQUENCIAL, NCC_TEXTO, NCC_USUARIO'
      'FROM NFECCE'
      'WHERE NCC_CODIGO = :OLD_NCC_CODIGO')
    Left = 840
    Top = 264
  end
