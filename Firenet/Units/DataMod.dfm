      '  NOI_PRODUTO, NOI_PRODUTOREAL, NOI_QUANTIDADE, '
      '  NOI_QUANTIDADETROCA, NOI_SEQUENCIA, NOI_SERVICOISS, '
      '  NOI_SOMACOFINSST, NOI_SOMAPISST, NOI_TIPO, '
      '  NOI_TIPOISS, NOI_UNIDADE, NOI_VALORACESSORIAS, '
      '  NOI_VALORADUANA, NOI_VALORCOFINS, NOI_VALORCOFINSST, '
      '  NOI_VALORCOMISSAO, NOI_VALORFCP, NOI_VALORFCPST, '
