  object UPNfceInutilizadas: TFDUpdateSQL
    Connection = FDConnection1
    InsertSQL.Strings = (
      'INSERT INTO NFCEINUTILIZADAS'
      '(FCI_ANO, FCI_CODIGO, FCI_DTATUALIZACAO, FCI_DTCADASTRO, '
      '  FCI_HRATUALIZACAO, FCI_HRCADASTRO, FCI_JUSTIFICATIVA, '
      '  FCI_MODELO, FCI_NUMFINAL, FCI_NUMINICIAL, '
      '  FCI_PROTOCOLO, FCI_PROTOCOLODH, FCI_SERIE, '
      '  FCI_USUARIO)'
      
        'VALUES (:NEW_FCI_ANO, gen_id(GEN_NFCEINUTILIZADAS,1), :NEW_FCI_D' +
        'TATUALIZACAO, :NEW_FCI_DTCADASTRO, '
      
        '  :NEW_FCI_HRATUALIZACAO, :NEW_FCI_HRCADASTRO, :NEW_FCI_JUSTIFIC' +
        'ATIVA, '
      '  :NEW_FCI_MODELO, :NEW_FCI_NUMFINAL, :NEW_FCI_NUMINICIAL, '
      '  :NEW_FCI_PROTOCOLO, :NEW_FCI_PROTOCOLODH, :NEW_FCI_SERIE, '
      '  :NEW_FCI_USUARIO)'
      
        'RETURNING FCI_ANO, FCI_CODIGO, FCI_DTATUALIZACAO, FCI_DTCADASTRO' +
        ', FCI_HRATUALIZACAO, FCI_HRCADASTRO, FCI_JUSTIFICATIVA, FCI_MODE' +
        'LO, FCI_NUMFINAL, FCI_NUMINICIAL, FCI_PROTOCOLO, FCI_PROTOCOLODH' +
        ', FCI_SERIE, FCI_USUARIO')
    ModifySQL.Strings = (
      'UPDATE NFCEINUTILIZADAS'
      
        'SET FCI_ANO = :NEW_FCI_ANO, FCI_CODIGO = :NEW_FCI_CODIGO, FCI_DT' +
        'ATUALIZACAO = :NEW_FCI_DTATUALIZACAO, '
      
        '  FCI_DTCADASTRO = :NEW_FCI_DTCADASTRO, FCI_HRATUALIZACAO = :NEW' +
        '_FCI_HRATUALIZACAO, '
      
        '  FCI_HRCADASTRO = :NEW_FCI_HRCADASTRO, FCI_JUSTIFICATIVA = :NEW' +
        '_FCI_JUSTIFICATIVA, '
      
        '  FCI_MODELO = :NEW_FCI_MODELO, FCI_NUMFINAL = :NEW_FCI_NUMFINAL' +
        ', '
      
        '  FCI_NUMINICIAL = :NEW_FCI_NUMINICIAL, FCI_PROTOCOLO = :NEW_FCI' +
        '_PROTOCOLO, '
      
        '  FCI_PROTOCOLODH = :NEW_FCI_PROTOCOLODH, FCI_SERIE = :NEW_FCI_S' +
        'ERIE, '
      '  FCI_USUARIO = :NEW_FCI_USUARIO'
      'WHERE FCI_CODIGO = :OLD_FCI_CODIGO'
      
        'RETURNING FCI_ANO, FCI_CODIGO, FCI_DTATUALIZACAO, FCI_DTCADASTRO' +
        ', FCI_HRATUALIZACAO, FCI_HRCADASTRO, FCI_JUSTIFICATIVA, FCI_MODE' +
        'LO, FCI_NUMFINAL, FCI_NUMINICIAL, FCI_PROTOCOLO, FCI_PROTOCOLODH' +
        ', FCI_SERIE, FCI_USUARIO')
    DeleteSQL.Strings = (
      'DELETE FROM NFCEINUTILIZADAS'
      'WHERE FCI_CODIGO = :OLD_FCI_CODIGO')
    FetchRowSQL.Strings = (
      
        'SELECT FCI_ANO, FCI_CODIGO, FCI_DTATUALIZACAO, FCI_DTCADASTRO, F' +
        'CI_HRATUALIZACAO, '
      '  FCI_HRCADASTRO, FCI_JUSTIFICATIVA, FCI_MODELO, FCI_NUMFINAL, '
      '  FCI_NUMINICIAL, FCI_PROTOCOLO, FCI_PROTOCOLODH, FCI_SERIE, '
      '  FCI_USUARIO'
      'FROM NFCEINUTILIZADAS'
      'WHERE FCI_CODIGO = :OLD_FCI_CODIGO')
    Left = 680
    Top = 264
  end
