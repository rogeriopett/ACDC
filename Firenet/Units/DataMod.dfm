        '  :NEW_NOI_QUANTIDADETROCA, :NEW_NOI_SEQUENCIA, :NEW_NOI_SERVICO' +
        'ISS, '
      '  :NEW_NOI_SOMACOFINSST, :NEW_NOI_SOMAPISST, :NEW_NOI_TIPO, '
      '  :NEW_NOI_TIPOISS, :NEW_NOI_UNIDADE, :NEW_NOI_VALORACESSORIAS, '
      
        '  :NEW_NOI_VALORADUANA, :NEW_NOI_VALORCOFINS, :NEW_NOI_VALORCOFI' +
        'NSST, '
      
        '  :NEW_NOI_VALORCOMISSAO, :NEW_NOI_VALORFCP, :NEW_NOI_VALORFCPST' +
        ', '
      
        '  :NEW_NOI_VALORFRETE, :NEW_NOI_VALORICMS, :NEW_NOI_VALORICMSCRE' +
