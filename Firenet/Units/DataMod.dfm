      '  COM_OBSERVACOES, COM_PESOBRUTO, COM_PESOLIQ, '
      '  COM_REBOQUEPLACA, COM_REBOQUEPLACAUF, COM_REBOQUERNTC, '
      '  COM_RG, COM_SERIE, COM_STATUS, COM_TOTALCOFINS, '
      '  COM_TOTALCOFINSST, COM_TOTALFCP, COM_TOTALICMS, '
      '  COM_TOTALICMSCREDSN, COM_TOTALICMSST, COM_TOTALICMSUFDEST, '
      '  COM_TOTALICMSUFREMET, COM_TOTALIPI, COM_TOTALISS, '
      
        '  COM_TOTALISSDEDUCAO, COM_TOTALISSDESCCOND, COM_TOTALISSDESCINC' +
        'OND, '
      '  COM_TOTALISSOUTROS, COM_TOTALISSRETENCAO, COM_TOTALITENS, '
