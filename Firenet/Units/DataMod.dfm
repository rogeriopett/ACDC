  object UPNfeItensAdicoes: TFDUpdateSQL
    Connection = FDConnection1
    InsertSQL.Strings = (
      'INSERT INTO NFEITENSADICOES'
      '(NFA_CODIGO, NFA_DESCONTODI, NFA_DRAWBACK, NFA_FABRICANTE, '
      '  NFA_NFEITEM, NFA_NUMERO, NFA_SEQUENCIA)'
      
        'VALUES (gen_id(GEN_NFEITENSADICOES,1), :NEW_NFA_DESCONTODI, :NEW' +
        '_NFA_DRAWBACK, :NEW_NFA_FABRICANTE, '
      '  :NEW_NFA_NFEITEM, :NEW_NFA_NUMERO, :NEW_NFA_SEQUENCIA)'
      
        'RETURNING NFA_CODIGO, NFA_DESCONTODI, NFA_DRAWBACK, NFA_FABRICAN' +
        'TE, NFA_NFEITEM, NFA_NUMERO, NFA_SEQUENCIA')
    ModifySQL.Strings = (
      'UPDATE NFEITENSADICOES'
      
        'SET NFA_CODIGO = :NEW_NFA_CODIGO, NFA_DESCONTODI = :NEW_NFA_DESC' +
        'ONTODI, '
      
        '  NFA_DRAWBACK = :NEW_NFA_DRAWBACK, NFA_FABRICANTE = :NEW_NFA_FA' +
        'BRICANTE, '
      '  NFA_NFEITEM = :NEW_NFA_NFEITEM, NFA_NUMERO = :NEW_NFA_NUMERO, '
      '  NFA_SEQUENCIA = :NEW_NFA_SEQUENCIA'
      'WHERE NFA_CODIGO = :OLD_NFA_CODIGO'
      
        'RETURNING NFA_CODIGO, NFA_DESCONTODI, NFA_DRAWBACK, NFA_FABRICAN' +
        'TE, NFA_NFEITEM, NFA_NUMERO, NFA_SEQUENCIA')
    DeleteSQL.Strings = (
      'DELETE FROM NFEITENSADICOES'
      'WHERE NFA_CODIGO = :OLD_NFA_CODIGO')
    FetchRowSQL.Strings = (
      
        'SELECT NFA_CODIGO, NFA_DESCONTODI, NFA_DRAWBACK, NFA_FABRICANTE,' +
        ' NFA_NFEITEM, '
      '  NFA_NUMERO, NFA_SEQUENCIA'
      'FROM NFEITENSADICOES'
      'WHERE NFA_CODIGO = :OLD_NFA_CODIGO')
    Left = 968
    Top = 264
  end
