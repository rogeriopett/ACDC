        '  FOR_ESTADOCIVIL = :NEW_FOR_ESTADOCIVIL, FOR_ESTADOCODIGO = :NE' +
        'W_FOR_ESTADOCODIGO, '
      
        '  FOR_FANTASIA = :NEW_FOR_FANTASIA, FOR_FONE0800 = :NEW_FOR_FONE' +
        '0800, '
      '  FOR_FONE1 = :NEW_FOR_FONE1, FOR_FONE2 = :NEW_FOR_FONE2, '
      
