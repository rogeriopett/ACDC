  object TRProdutosCodigos: TFDTransaction
    Options.Isolation = xiReadCommitted
    Connection = FDConnection1
    Left = 328
    Top = 456
  end
  object UPProdutosCodigos: TFDUpdateSQL
    Connection = FDConnection1
    InsertSQL.Strings = (
      'INSERT INTO PRODUTOSCODIGOS'
      '(PCO_CODIGO, PCO_CODIGOFORNECEDOR, PCO_DTATUALIZACAO, '
      '  PCO_DTCADASTRO, PCO_FORNECEDOR, PCO_HRATUALIZACAO, '
      '  PCO_HRCADASTRO, PCO_PRODUTO, PCO_USUARIO)'
      
        'VALUES (gen_id(GEN_PRODUTOSCODIGOS,1), :NEW_PCO_CODIGOFORNECEDOR' +
        ', :NEW_PCO_DTATUALIZACAO, '
      
        '  :NEW_PCO_DTCADASTRO, :NEW_PCO_FORNECEDOR, :NEW_PCO_HRATUALIZAC' +
        'AO, '
      '  :NEW_PCO_HRCADASTRO, :NEW_PCO_PRODUTO, :NEW_PCO_USUARIO)'
      
        'RETURNING PCO_CODIGO, PCO_CODIGOFORNECEDOR, PCO_DTATUALIZACAO, P' +
        'CO_DTCADASTRO, PCO_FORNECEDOR, PCO_HRATUALIZACAO, PCO_HRCADASTRO' +
        ', PCO_PRODUTO, PCO_USUARIO')
    ModifySQL.Strings = (
      'UPDATE PRODUTOSCODIGOS'
      
        'SET PCO_CODIGO = :NEW_PCO_CODIGO, PCO_CODIGOFORNECEDOR = :NEW_PC' +
        'O_CODIGOFORNECEDOR, '
      
        '  PCO_DTATUALIZACAO = :NEW_PCO_DTATUALIZACAO, PCO_DTCADASTRO = :' +
        'NEW_PCO_DTCADASTRO, '
      
        '  PCO_FORNECEDOR = :NEW_PCO_FORNECEDOR, PCO_HRATUALIZACAO = :NEW' +
        '_PCO_HRATUALIZACAO, '
      
        '  PCO_HRCADASTRO = :NEW_PCO_HRCADASTRO, PCO_PRODUTO = :NEW_PCO_P' +
        'RODUTO, '
      '  PCO_USUARIO = :NEW_PCO_USUARIO'
      'WHERE PCO_CODIGO = :OLD_PCO_CODIGO'
      
        'RETURNING PCO_CODIGO, PCO_CODIGOFORNECEDOR, PCO_DTATUALIZACAO, P' +
        'CO_DTCADASTRO, PCO_FORNECEDOR, PCO_HRATUALIZACAO, PCO_HRCADASTRO' +
        ', PCO_PRODUTO, PCO_USUARIO')
    DeleteSQL.Strings = (
      'DELETE FROM PRODUTOSCODIGOS'
      'WHERE PCO_CODIGO = :OLD_PCO_CODIGO')
    FetchRowSQL.Strings = (
      
        'SELECT PCO_CODIGO, PCO_CODIGOFORNECEDOR, PCO_DTATUALIZACAO, PCO_' +
        'DTCADASTRO, '
      
        '  PCO_FORNECEDOR, PCO_HRATUALIZACAO, PCO_HRCADASTRO, PCO_PRODUTO' +
        ', '
      '  PCO_USUARIO'
      'FROM PRODUTOSCODIGOS'
      'WHERE PCO_CODIGO = :OLD_PCO_CODIGO')
    Left = 328
    Top = 424
  end
  object TBProdutosCodigos: TFDQuery
    BeforeInsert = TBProdutosCodigosBeforeInsert
    AfterInsert = TBProdutosCodigosAfterInsert
    BeforeEdit = TBProdutosCodigosBeforeEdit
    BeforePost = TBProdutosCodigosBeforePost
    MasterSource = DSProdutos
    MasterFields = 'PRO_CODIGO'
    Connection = FDConnection1
    Transaction = TRProdutosCodigos
    UpdateObject = UPProdutosCodigos
    SQL.Strings = (
      'select '
      'PCO_CODIGO,'
      'PCO_CODIGOFORNECEDOR,'
      'PCO_DTATUALIZACAO,'
      'PCO_DTCADASTRO,'
      'PCO_FORNECEDOR,'
      'PCO_HRATUALIZACAO,'
      'PCO_HRCADASTRO,'
      'PCO_PRODUTO,'
      'PCO_USUARIO,'
      'FOR_NOME'
      'from PRODUTOSCODIGOS'
      'left join FORNECEDORES on PCO_FORNECEDOR=FOR_CODIGO'
      'where PCO_PRODUTO=:PRO_CODIGO'
      'order by FOR_NOME'
      '')
    Left = 328
    Top = 392
    ParamData = <
      item
        Name = 'PRO_CODIGO'
        DataType = ftInteger
        ParamType = ptInput
      end>
