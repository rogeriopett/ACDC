      '  :NEW_COM_FONE1, :NEW_COM_FORMAPAGTO, :NEW_COM_FORNECEDOR, '
      '  :NEW_COM_FRETE, :NEW_COM_HRATUALIZACAO, :NEW_COM_HRCADASTRO, '
      
