  object UPRegrasFiscais: TFDUpdateSQL
    Connection = FDConnection1
    InsertSQL.Strings = (
      'INSERT INTO REGRASFISCAIS'
      '(RGF_ALIQCBS, RGF_ALIQIBSMUN, RGF_ALIQIBSUF, RGF_ALIQIS, '
      '  RGF_CLASSTRIBIBSCBS, RGF_CLASSTRIBIS, RGF_CODIGO, '
      '  RGF_CREDITOPRES, RGF_CSTIBSCBS, RGF_CSTIS, '
      '  RGF_DESCRICAO, RGF_DTATUALIZACAO, RGF_DTCADASTRO, '
      '  RGF_HRATUALIZACAO, RGF_HRCADASTRO, RGF_OBSERVACOES, '
      '  RGF_USUARIO)'
      
        'VALUES (:NEW_RGF_ALIQCBS, :NEW_RGF_ALIQIBSMUN, :NEW_RGF_ALIQIBSU' +
        'F, :NEW_RGF_ALIQIS, '
      
        '  :NEW_RGF_CLASSTRIBIBSCBS, :NEW_RGF_CLASSTRIBIS, gen_id(GEN_REG' +
        'RASFISCAIS,1), '
      '  :NEW_RGF_CREDITOPRES, :NEW_RGF_CSTIBSCBS, :NEW_RGF_CSTIS, '
      
        '  :NEW_RGF_DESCRICAO, :NEW_RGF_DTATUALIZACAO, :NEW_RGF_DTCADASTR' +
        'O, '
      
        '  :NEW_RGF_HRATUALIZACAO, :NEW_RGF_HRCADASTRO, :NEW_RGF_OBSERVAC' +
        'OES, '
      '  :NEW_RGF_USUARIO)'
      
        'RETURNING RGF_ALIQCBS, RGF_ALIQIBSMUN, RGF_ALIQIBSUF, RGF_ALIQIS' +
        ', RGF_CLASSTRIBIBSCBS, RGF_CLASSTRIBIS, RGF_CODIGO, RGF_CREDITOP' +
        'RES, RGF_CSTIBSCBS, RGF_CSTIS, RGF_DESCRICAO, RGF_DTATUALIZACAO,' +
        ' RGF_DTCADASTRO, RGF_HRATUALIZACAO, RGF_HRCADASTRO, RGF_OBSERVAC' +
        'OES, RGF_USUARIO')
    ModifySQL.Strings = (
      'UPDATE REGRASFISCAIS'
      
        'SET RGF_ALIQCBS = :NEW_RGF_ALIQCBS, RGF_ALIQIBSMUN = :NEW_RGF_AL' +
        'IQIBSMUN, '
      
        '  RGF_ALIQIBSUF = :NEW_RGF_ALIQIBSUF, RGF_ALIQIS = :NEW_RGF_ALIQ' +
        'IS, '
      
        '  RGF_CLASSTRIBIBSCBS = :NEW_RGF_CLASSTRIBIBSCBS, RGF_CLASSTRIBI' +
        'S = :NEW_RGF_CLASSTRIBIS, '
      
        '  RGF_CODIGO = :NEW_RGF_CODIGO, RGF_CREDITOPRES = :NEW_RGF_CREDI' +
        'TOPRES, '
      
        '  RGF_CSTIBSCBS = :NEW_RGF_CSTIBSCBS, RGF_CSTIS = :NEW_RGF_CSTIS' +
        ', '
      
        '  RGF_DESCRICAO = :NEW_RGF_DESCRICAO, RGF_DTATUALIZACAO = :NEW_R' +
        'GF_DTATUALIZACAO, '
      
        '  RGF_DTCADASTRO = :NEW_RGF_DTCADASTRO, RGF_HRATUALIZACAO = :NEW' +
        '_RGF_HRATUALIZACAO, '
      
        '  RGF_HRCADASTRO = :NEW_RGF_HRCADASTRO, RGF_OBSERVACOES = :NEW_R' +
        'GF_OBSERVACOES, '
      '  RGF_USUARIO = :NEW_RGF_USUARIO'
      'WHERE RGF_CODIGO = :OLD_RGF_CODIGO'
      
        'RETURNING RGF_ALIQCBS, RGF_ALIQIBSMUN, RGF_ALIQIBSUF, RGF_ALIQIS' +
        ', RGF_CLASSTRIBIBSCBS, RGF_CLASSTRIBIS, RGF_CODIGO, RGF_CREDITOP' +
        'RES, RGF_CSTIBSCBS, RGF_CSTIS, RGF_DESCRICAO, RGF_DTATUALIZACAO,' +
        ' RGF_DTCADASTRO, RGF_HRATUALIZACAO, RGF_HRCADASTRO, RGF_OBSERVAC' +
        'OES, RGF_USUARIO')
    DeleteSQL.Strings = (
      'DELETE FROM REGRASFISCAIS'
      'WHERE RGF_CODIGO = :OLD_RGF_CODIGO')
    FetchRowSQL.Strings = (
      
        'SELECT RGF_ALIQCBS, RGF_ALIQIBSMUN, RGF_ALIQIBSUF, RGF_ALIQIS, R' +
        'GF_CLASSTRIBIBSCBS, '
      '  RGF_CLASSTRIBIS, RGF_CODIGO, RGF_CREDITOPRES, RGF_CSTIBSCBS, '
      '  RGF_CSTIS, RGF_DESCRICAO, RGF_DTATUALIZACAO, RGF_DTCADASTRO, '
      
        '  RGF_HRATUALIZACAO, RGF_HRCADASTRO, RGF_OBSERVACOES, RGF_USUARI' +
        'O'
      'FROM REGRASFISCAIS'
      'WHERE RGF_CODIGO = :OLD_RGF_CODIGO')
    Left = 584
    Top = 424
  end
  object TBRegrasFiscais: TFDQuery
    BeforeInsert = TBRegrasFiscaisBeforeInsert
    AfterInsert = TBRegrasFiscaisAfterInsert
    BeforeEdit = TBRegrasFiscaisBeforeEdit
    BeforePost = TBRegrasFiscaisBeforePost
    Connection = FDConnection1
    Transaction = TRRegrasFiscais
    UpdateObject = UPRegrasFiscais
    SQL.Strings = (
      'select'
      'RGF_ALIQCBS, '
      'RGF_ALIQIBSMUN, '
      'RGF_ALIQIBSUF,'
      'RGF_ALIQIS, '
      'RGF_CLASSTRIBIBSCBS, '
      'RGF_CLASSTRIBIS, '
      'RGF_CODIGO, '
      'RGF_CREDITOPRES, '
      'RGF_CSTIBSCBS, '
      'RGF_CSTIS, '
      'RGF_DESCRICAO, '
      'RGF_DTATUALIZACAO, '
      'RGF_DTCADASTRO, '
      'RGF_HRATUALIZACAO, '
      'RGF_HRCADASTRO, '
      'RGF_OBSERVACOES, '
      'RGF_USUARIO,'
      'CPR_APROPRIADFE,'
      'CPR_APROPRIAEVENTO,'
      'CPR_CBS,'
      'CPR_DEDUZTOTAL,'
      'CPR_DESCRICAO,'
      'CPR_IBS,'
      'IBSCBS.CLT_DESCRICAO as CLT_DESCRICAO_IC,'
      'IBSCBS.CLT_ALIQCBSRED as CLT_ALIQCBSRED_IC,'
      'IBSCBS.CLT_ALIQIBSRED as CLT_ALIQIBSRED_IC,'
      'IBSCBS.CLT_CREDITOPRESUMIDO as CLT_CREDITOPRESUMIDO_IC,'
      'IBSCBS.CLT_MONODIFERIMENTO as CLT_MONODIFERIMENTO_IC,'
      'IBSCBS.CLT_MONOFASICO as CLT_MONOFASICO_IC,'
      'IBSCBS.CLT_MONORETENCAO as CLT_MONORETENCAO_IC,'
      'IBSCBS.CLT_MONORETIDO as CLT_MONORETIDO_IC,'
      'IBSCBS.CLT_REDBASE as CLT_REDBASE_IC,'
      'IBSCBS.CLT_TIPOALIQUOTA as CLT_TIPOALIQUOTA_IC,'
      'IBSCBS.CLT_TRIBUTACAOREGULAR as CLT_TRIBUTACAOREGULAR_IC,'
      'IS_.CLT_DESCRICAO as CLT_DESCRICAO_IS,'
      'IS_.CLT_ALIQCBSRED as CLT_ALIQCBSRED_IS,'
      'IS_.CLT_ALIQIBSRED as CLT_ALIQIBSRED_IS,'
      'IS_.CLT_CREDITOPRESUMIDO as CLT_CREDITOPRESUMIDO_IS,'
      'IS_.CLT_MONODIFERIMENTO as CLT_MONODIFERIMENTO_IS,'
      'IS_.CLT_MONOFASICO as CLT_MONOFASICO_IS,'
      'IS_.CLT_MONORETENCAO as CLT_MONORETENCAO_IS,'
      'IS_.CLT_MONORETIDO as CLT_MONORETIDO_IS,'
      'IS_.CLT_REDBASE as CLT_REDBASE_IS,'
      'IS_.CLT_TIPOALIQUOTA as CLT_TIPOALIQUOTA_IS,'
      'IS_.CLT_TRIBUTACAOREGULAR as CLT_TRIBUTACAOREGULAR_IS'
      'from REGRASFISCAIS'
      
        'left join CLASSTRIB IBSCBS on RGF_CLASSTRIBIBSCBS=IBSCBS.CLT_COD' +
        'IGO'
      'left join CLASSTRIB IS_ on RGF_CLASSTRIBIS=IS_.CLT_CODIGO'
      'left join CREDITOPRES on RGF_CREDITOPRES=CPR_CODIGO'
      'where RGF_CODIGO=:codigo'
      '')
    Left = 584
    Top = 392
