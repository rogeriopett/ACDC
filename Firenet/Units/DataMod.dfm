      '  :NEW_PET_ETAPA, :NEW_PET_HRATUALIZACAO, :NEW_PET_HRCADASTRO, '
      '  :NEW_PET_OBSERVACOES, :NEW_PET_ORDEM, :NEW_PET_PRODUTO, '
