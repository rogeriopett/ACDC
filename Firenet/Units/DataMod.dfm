  object UPNfeRef: TFDUpdateSQL
    Connection = FDConnection1
    InsertSQL.Strings = (
      'INSERT INTO NFEREF'
      '(NFR_ANOMES, NFR_CHAVEACESSO, NFR_CNPJEMITENTE, '
      '  NFR_CODIGO, NFR_COO, NFR_CPFEMITENTE, NFR_ESTADOCODIGO, '
      '  NFR_IEEMITENTE, NFR_MODELO, NFR_NFE, NFR_NUMERO, '
      '  NFR_SERIE, NFR_TIPO)'
      
        'VALUES (:NEW_NFR_ANOMES, :NEW_NFR_CHAVEACESSO, :NEW_NFR_CNPJEMIT' +
        'ENTE, '
      
        '  gen_id(GEN_NFEREF,1), :NEW_NFR_COO, :NEW_NFR_CPFEMITENTE, :NEW' +
        '_NFR_ESTADOCODIGO, '
      
        '  :NEW_NFR_IEEMITENTE, :NEW_NFR_MODELO, :NEW_NFR_NFE, :NEW_NFR_N' +
        'UMERO, '
      '  :NEW_NFR_SERIE, :NEW_NFR_TIPO)'
      
        'RETURNING NFR_ANOMES, NFR_CHAVEACESSO, NFR_CNPJEMITENTE, NFR_COD' +
        'IGO, NFR_COO, NFR_CPFEMITENTE, NFR_ESTADOCODIGO, NFR_IEEMITENTE,' +
        ' NFR_MODELO, NFR_NFE, NFR_NUMERO, NFR_SERIE, NFR_TIPO')
    ModifySQL.Strings = (
      'UPDATE NFEREF'
      
        'SET NFR_ANOMES = :NEW_NFR_ANOMES, NFR_CHAVEACESSO = :NEW_NFR_CHA' +
        'VEACESSO, '
      
        '  NFR_CNPJEMITENTE = :NEW_NFR_CNPJEMITENTE, NFR_CODIGO = :NEW_NF' +
        'R_CODIGO, '
      
        '  NFR_COO = :NEW_NFR_COO, NFR_CPFEMITENTE = :NEW_NFR_CPFEMITENTE' +
        ', '
      
        '  NFR_ESTADOCODIGO = :NEW_NFR_ESTADOCODIGO, NFR_IEEMITENTE = :NE' +
        'W_NFR_IEEMITENTE, '
      
        '  NFR_MODELO = :NEW_NFR_MODELO, NFR_NFE = :NEW_NFR_NFE, NFR_NUME' +
        'RO = :NEW_NFR_NUMERO, '
      '  NFR_SERIE = :NEW_NFR_SERIE, NFR_TIPO = :NEW_NFR_TIPO'
      'WHERE NFR_CODIGO = :OLD_NFR_CODIGO'
      
        'RETURNING NFR_ANOMES, NFR_CHAVEACESSO, NFR_CNPJEMITENTE, NFR_COD' +
        'IGO, NFR_COO, NFR_CPFEMITENTE, NFR_ESTADOCODIGO, NFR_IEEMITENTE,' +
        ' NFR_MODELO, NFR_NFE, NFR_NUMERO, NFR_SERIE, NFR_TIPO')
    DeleteSQL.Strings = (
      'DELETE FROM NFEREF'
      'WHERE NFR_CODIGO = :OLD_NFR_CODIGO')
    FetchRowSQL.Strings = (
      
        'SELECT NFR_ANOMES, NFR_CHAVEACESSO, NFR_CNPJEMITENTE, NFR_CODIGO' +
        ', NFR_COO, '
      
        '  NFR_CPFEMITENTE, NFR_ESTADOCODIGO, NFR_IEEMITENTE, NFR_MODELO,' +
        ' '
      '  NFR_NFE, NFR_NUMERO, NFR_SERIE, NFR_TIPO'
      'FROM NFEREF'
      'WHERE NFR_CODIGO = :OLD_NFR_CODIGO')
    Left = 1000
    Top = 264
  end
