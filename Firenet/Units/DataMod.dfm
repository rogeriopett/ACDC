      '  NOI_VALORPISST, NOI_VALORSEGURO, NOI_VALORTOTAL, '
      '  NOI_VALORTOTALBRUTO, NOI_VALORTRIBUTOS, NOI_VALORTRIBUTOSEST, '
      
        '  NOI_VALORTRIBUTOSFED, NOI_VALORTRIBUTOSIMP, NOI_VALORTRIBUTOSM' +
        'UN, '
      '  NOI_VALORUNIT)'
      
        'VALUES (:NEW_NOI_ALIQCOFINS, :NEW_NOI_ALIQCOFINSST, :NEW_NOI_ALI' +
        'QFCP, '
      
        '  :NEW_NOI_ALIQFCPST, :NEW_NOI_ALIQICMS, :NEW_NOI_ALIQICMSADICST' +
        ', '
      
        '  :NEW_NOI_ALIQICMSINTER, :NEW_NOI_ALIQICMSINTERPART, :NEW_NOI_A' +
        'LIQICMSRED, '
