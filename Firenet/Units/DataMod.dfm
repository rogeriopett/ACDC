        'SUARIO, '
      '  VEN_ZAPINSTANCIA = :NEW_VEN_ZAPINSTANCIA'
      'WHERE VEN_CODIGO = :OLD_VEN_CODIGO'
      
        'RETURNING VEN_ATUALIZAR, VEN_BAIRRO, VEN_CEP, VEN_CIDADE, VEN_CI' +
        'DADECODIGO, VEN_CNPJ, VEN_CODIGO, VEN_COMISSAO, VEN_COMISSAOTIPO' +
