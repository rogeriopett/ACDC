      'NOI_VALORTRIBUTOSEST,'
      'NOI_VALORTRIBUTOSFED,'
      'NOI_VALORTRIBUTOSIMP,'
      'NOI_VALORTRIBUTOSMUN,'
      'NOI_VALORUNIT,'
      'CLF_DESCRICAO,'
      'ICM_CALCULACREDITOSN,'
      'ICM_DESCRICAO,'
      'IPI_DESCRICAO,'
      'ISS_DESCRICAO,'
      'NAT_CALCULACOMISSAO,'
      'NAT_CALCULACREDITOSN,'
      'NAT_DESCRICAO,'
      'PIS.PIS_DESCRICAO as PIS_DESCRICAO,'
      'COFINS.PIS_DESCRICAO as PIS_DESCRICAO1,'
      'PRO_CLASSFISCAL,'
      'PRO_CODIGO,'
      'PRO_CSTICMS,'
      'PRO_NOME,'
      'PRO_PRECOVENDA,'
      'PRO_TIPO,'
      'PRO_UNIDADE'
      'from NOTASITENS '
      'left join PRODUTOS on NOI_PRODUTO=PRO_CODIGO'
      'left join NATUREZAS on NOI_CFOP=NAT_CODIGO'
      
        'left join CLASSFISCAL on NOI_CLASSFISCAL=CLF_CODIGO and NOI_EXCE' +
        'CAO=CLF_EXCECAO'
      'left join ICMS on NOI_CSTICMS=ICM_CODIGO'
      'left join IPI on NOI_CSTIPI=IPI_CODIGO'
      'left join ISS on NOI_TIPOISS=ISS_CODIGO'
      'left join PISCOFINS as PIS on NOI_CSTPIS=PIS.PIS_CODIGO'
      
        'left join PISCOFINS as COFINS on NOI_CSTCOFINS=COFINS.PIS_CODIGO' +
        ' '
      'where NOI_NOTA=:NOT_CODIGO'
      '')
    Left = 40
    Top = 392
    ParamData = <
      item
        Name = 'NOT_CODIGO'
        DataType = ftInteger
        ParamType = ptInput
