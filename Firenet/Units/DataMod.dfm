  object TRServicosCheck: TFDTransaction
    Options.Isolation = xiReadCommitted
    Connection = FDConnection1
    Left = 680
    Top = 456
  end
  object UPServicosCheck: TFDUpdateSQL
    Connection = FDConnection1
    InsertSQL.Strings = (
      'INSERT INTO SERVICOSCHECK'
      '(SCK_CHECKLIST, SCK_CHECKLISTITEM, SCK_CODIGO, '
      '  SCK_OBSERVACOES, SCK_SERVICO, SCK_STATUS)'
      
        'VALUES (:NEW_SCK_CHECKLIST, :NEW_SCK_CHECKLISTITEM, gen_id(GEN_S' +
        'ERVICOSCHECK,1), '
      '  :NEW_SCK_OBSERVACOES, :NEW_SCK_SERVICO, :NEW_SCK_STATUS)'
      
        'RETURNING SCK_CHECKLIST, SCK_CHECKLISTITEM, SCK_CODIGO, SCK_OBSE' +
        'RVACOES, SCK_SERVICO, SCK_STATUS')
    ModifySQL.Strings = (
      'UPDATE SERVICOSCHECK'
      
        'SET SCK_CHECKLIST = :NEW_SCK_CHECKLIST, SCK_CHECKLISTITEM = :NEW' +
        '_SCK_CHECKLISTITEM, '
      
        '  SCK_CODIGO = :NEW_SCK_CODIGO, SCK_OBSERVACOES = :NEW_SCK_OBSER' +
        'VACOES, '
      '  SCK_SERVICO = :NEW_SCK_SERVICO, SCK_STATUS = :NEW_SCK_STATUS'
      'WHERE SCK_CODIGO = :OLD_SCK_CODIGO'
      
        'RETURNING SCK_CHECKLIST, SCK_CHECKLISTITEM, SCK_CODIGO, SCK_OBSE' +
        'RVACOES, SCK_SERVICO, SCK_STATUS')
    DeleteSQL.Strings = (
      'DELETE FROM SERVICOSCHECK'
      'WHERE SCK_CODIGO = :OLD_SCK_CODIGO')
    FetchRowSQL.Strings = (
      
        'SELECT SCK_CHECKLIST, SCK_CHECKLISTITEM, SCK_CODIGO, SCK_OBSERVA' +
        'COES, '
      '  SCK_SERVICO, SCK_STATUS'
      'FROM SERVICOSCHECK'
      'WHERE SCK_CODIGO = :OLD_SCK_CODIGO')
    Left = 680
