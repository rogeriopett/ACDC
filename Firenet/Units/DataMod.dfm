        'CIONAL, '
      '  :NEW_NOI_LOCALIZACAO, :NEW_NOI_LOTE, :NEW_NOI_LUCROPORC, '
      '  :NEW_NOI_LUCROVALOR, :NEW_NOI_MODICMS, :NEW_NOI_MODICMSST, '
      
