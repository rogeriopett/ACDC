        ', '
      '  :NEW_CST_REDBASE, :NEW_CST_TRANSFCREDITO, :NEW_CST_USUARIO)'
      
        'RETURNING CST_AJUSTECREDITO, CST_CODIGO, CST_CREDPRESIBSZFM, CST' +
