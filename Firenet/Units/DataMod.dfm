  object UPReceberItens: TFDUpdateSQL
    Connection = FDConnection1
    InsertSQL.Strings = (
      'INSERT INTO RECEBERITENS'
      '(REI_CODIGO, REI_DESCRICAO, REI_RECEBER, REI_VALOR)'
      
        'VALUES (gen_id(GEN_RECEBERITENS,1), :NEW_REI_DESCRICAO, :NEW_REI' +
