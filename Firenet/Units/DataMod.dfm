      '  FOR_NUMERO, FOR_OBSERVACOES, FOR_PAIS, FOR_PAISCODIGO, '
      '  FOR_REGPROFISSIONAL, FOR_RG, FOR_SITE, FOR_STATUS, '
      '  FOR_TIPOPESSOA, FOR_USUARIO)'
      
        'VALUES (:NEW_FOR_AFE, :NEW_FOR_ALVARA, :NEW_FOR_ALVARASANITARIO,' +
        ' :NEW_FOR_ATIVIDADE, '
      
