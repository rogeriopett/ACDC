      '  NOT_VEICULOPLACAUF, NOT_VEICULORNTC, NOT_VENDA, NOT_VENDEDOR, '
      '  NOT_VOLUMES, NOT_VOLUMESNUM'
      'FROM NOTAS'
      'WHERE NOT_CODIGO = :OLD_NOT_CODIGO')
    Left = 1128
    Top = 264
  end
