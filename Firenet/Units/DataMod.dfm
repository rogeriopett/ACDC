      'CPG_SOMENTEDIASUTEIS,'
      'CPG_STATUS,'
      'CPG_TIPOINTEGRACAO,'
      'CPG_TIPOPAGAMENTO,'
      'CPG_TOTALPARCELAS,'
      'CPG_TOTALPORCENTAGEM,'
      'CPG_USUARIO,'
      'CON_NOME'
      'from CONDICOES'
      'left join CONTAS on CPG_CONTA=CON_CODIGO'
      'where CPG_CODIGO=:codigo'
      '')
    Left = 616
    Top = 72
