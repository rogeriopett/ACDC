      'INSERT INTO AGRUPADORES'
      '(AGR_CODIGO, AGR_DESCRICAO, AGR_DTATUALIZACAO, '
      '  AGR_DTCADASTRO, AGR_HRATUALIZACAO, AGR_HRCADASTRO, '
