        'ICO, COM_ENDERECO, COM_ENTRADASAIDA, COM_ESPECIE, COM_ESTADO, CO' +
        'M_ESTADOCODIGO, COM_FONE1, COM_FORMAPAGTO, COM_FORNECEDOR, COM_F' +
        'RETE, COM_HRATUALIZACAO, COM_HRCADASTRO, COM_IE, COM_LACRES, COM' +
        '_MARCA, COM_MODELO, COM_MOVIMENTAESTOQUE, COM_MOVIMENTAFINANCEIR' +
        'O, COM_NOME, COM_NOTADATA, COM_NOTANUMERO, COM_NUMERO, COM_OBSER' +
        'VACOES, COM_PESOBRUTO, COM_PESOLIQ, COM_REBOQUEPLACA, COM_REBOQU' +
