        'DADE = :NEW_RUA_CIDADE, '
      '  RUA_CODIGO = :NEW_RUA_CODIGO, RUA_ESTADO = :NEW_RUA_ESTADO, '
      '  RUA_NOME = :NEW_RUA_NOME, RUA_PAIS = :NEW_RUA_PAIS'
      'WHERE RUA_CODIGO = :OLD_RUA_CODIGO'
      
        'RETURNING RUA_BAIRRO, RUA_CEP, RUA_CIDADE, RUA_CODIGO, RUA_ESTAD' +
        'O, RUA_NOME, RUA_PAIS')
    DeleteSQL.Strings = (
