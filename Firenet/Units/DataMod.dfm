      '(ESD_CODIGO, ESD_NOME, ESD_PAIS, ESD_SIGLA)'
      
        'VALUES (:NEW_ESD_CODIGO, :NEW_ESD_NOME, :NEW_ESD_PAIS, :NEW_ESD_' +
        'SIGLA)'
      'RETURNING ESD_CODIGO, ESD_NOME, ESD_PAIS, ESD_SIGLA')
    ModifySQL.Strings = (
      'UPDATE ESTADOS'
      
        'SET ESD_CODIGO = :NEW_ESD_CODIGO, ESD_NOME = :NEW_ESD_NOME, ESD_' +
        'PAIS = :NEW_ESD_PAIS, '
      '  ESD_SIGLA = :NEW_ESD_SIGLA'
      'WHERE ESD_CODIGO = :OLD_ESD_CODIGO'
      'RETURNING ESD_CODIGO, ESD_NOME, ESD_PAIS, ESD_SIGLA')
    DeleteSQL.Strings = (
