  object UPProdutosComp: TFDUpdateSQL
    Connection = FDConnection1
    InsertSQL.Strings = (
      'INSERT INTO PRODUTOSCOMP'
      '(PRC_BAIXAR, PRC_CODIGO, PRC_DTATUALIZACAO, PRC_DTCADASTRO, '
      '  PRC_HRATUALIZACAO, PRC_HRCADASTRO, PRC_ORDEM, '
      '  PRC_PRODUTO, PRC_PRODUTOCOMP, PRC_QUANTIDADE, '
      '  PRC_USUARIO)'
      
        'VALUES (:NEW_PRC_BAIXAR, gen_id(GEN_PRODUTOSCOMP,1), :NEW_PRC_DT' +
        'ATUALIZACAO, :NEW_PRC_DTCADASTRO, '
      '  :NEW_PRC_HRATUALIZACAO, :NEW_PRC_HRCADASTRO, :NEW_PRC_ORDEM, '
      '  :NEW_PRC_PRODUTO, :NEW_PRC_PRODUTOCOMP, :NEW_PRC_QUANTIDADE, '
      '  :NEW_PRC_USUARIO)'
      
        'RETURNING PRC_BAIXAR, PRC_CODIGO, PRC_DTATUALIZACAO, PRC_DTCADAS' +
        'TRO, PRC_HRATUALIZACAO, PRC_HRCADASTRO, PRC_ORDEM, PRC_PRODUTO, ' +
        'PRC_PRODUTOCOMP, PRC_QUANTIDADE, PRC_USUARIO')
    ModifySQL.Strings = (
      'UPDATE PRODUTOSCOMP'
      'SET PRC_BAIXAR = :NEW_PRC_BAIXAR, PRC_CODIGO = :NEW_PRC_CODIGO, '
      
        '  PRC_DTATUALIZACAO = :NEW_PRC_DTATUALIZACAO, PRC_DTCADASTRO = :' +
        'NEW_PRC_DTCADASTRO, '
      
        '  PRC_HRATUALIZACAO = :NEW_PRC_HRATUALIZACAO, PRC_HRCADASTRO = :' +
        'NEW_PRC_HRCADASTRO, '
      '  PRC_ORDEM = :NEW_PRC_ORDEM, PRC_PRODUTO = :NEW_PRC_PRODUTO, '
      
        '  PRC_PRODUTOCOMP = :NEW_PRC_PRODUTOCOMP, PRC_QUANTIDADE = :NEW_' +
        'PRC_QUANTIDADE, '
      '  PRC_USUARIO = :NEW_PRC_USUARIO'
      'WHERE PRC_CODIGO = :OLD_PRC_CODIGO'
      
        'RETURNING PRC_BAIXAR, PRC_CODIGO, PRC_DTATUALIZACAO, PRC_DTCADAS' +
        'TRO, PRC_HRATUALIZACAO, PRC_HRCADASTRO, PRC_ORDEM, PRC_PRODUTO, ' +
        'PRC_PRODUTOCOMP, PRC_QUANTIDADE, PRC_USUARIO')
    DeleteSQL.Strings = (
      'DELETE FROM PRODUTOSCOMP'
      'WHERE PRC_CODIGO = :OLD_PRC_CODIGO')
    FetchRowSQL.Strings = (
      
        'SELECT PRC_BAIXAR, PRC_CODIGO, PRC_DTATUALIZACAO, PRC_DTCADASTRO' +
        ', PRC_HRATUALIZACAO, '
      '  PRC_HRCADASTRO, PRC_ORDEM, PRC_PRODUTO, PRC_PRODUTOCOMP, '
      '  PRC_QUANTIDADE, PRC_USUARIO'
      'FROM PRODUTOSCOMP'
      'WHERE PRC_CODIGO = :OLD_PRC_CODIGO')
    Left = 360
    Top = 424
  end
  object TBProdutosComp: TFDQuery
    BeforeInsert = TBProdutosCompBeforeInsert
    AfterInsert = TBProdutosCompAfterInsert
    BeforeEdit = TBProdutosCompBeforeEdit
    AfterEdit = TBProdutosCompAfterEdit
    BeforePost = TBProdutosCompBeforePost
    MasterSource = DSProdutos
    MasterFields = 'PRO_CODIGO'
    Connection = FDConnection1
    Transaction = TRProdutosComp
    UpdateObject = UPProdutosComp
    SQL.Strings = (
      'select '
      'PRC_BAIXAR,'
      'PRC_CODIGO,'
      'PRC_DTATUALIZACAO,'
      'PRC_DTCADASTRO,'
      'PRC_HRATUALIZACAO,'
      'PRC_HRCADASTRO,'
      'PRC_ORDEM,'
      'PRC_PRODUTO,'
      'PRC_PRODUTOCOMP,'
      'PRC_QUANTIDADE,'
      'PRC_USUARIO,'
      'PRO_COMPOSTO,'
      'PRO_NOME, '
      'PRO_PRECOCUSTO,'
      '(PRC_QUANTIDADE * PRO_PRECOCUSTO) as PRO_PRECOCUSTOCOMP,'
      'PRO_UNIDADE'
      'from PRODUTOSCOMP'
      'left join PRODUTOS on PRC_PRODUTOCOMP=PRO_CODIGO'
      'where PRC_PRODUTO=:PRO_CODIGO'
