  object TRComponentes: TFDTransaction
    Options.Isolation = xiReadCommitted
    Connection = FDConnection1
    Left = 520
    Top = 136
  end
  object UPComponentes: TFDUpdateSQL
    Connection = FDConnection1
    InsertSQL.Strings = (
      'INSERT INTO COMPONENTES'
      '(COM_COMPONENTE, COM_DESCRICAO, COM_TELA, COM_TIPO)'
      
        'VALUES (:NEW_COM_COMPONENTE, :NEW_COM_DESCRICAO, :NEW_COM_TELA, ' +
        ':NEW_COM_TIPO)'
      'RETURNING COM_COMPONENTE, COM_DESCRICAO, COM_TELA, COM_TIPO')
    ModifySQL.Strings = (
      'UPDATE COMPONENTES'
      
        'SET COM_COMPONENTE = :NEW_COM_COMPONENTE, COM_DESCRICAO = :NEW_C' +
        'OM_DESCRICAO, '
      '  COM_TELA = :NEW_COM_TELA, COM_TIPO = :NEW_COM_TIPO'
      
        'WHERE COM_COMPONENTE = :OLD_COM_COMPONENTE AND COM_TELA = :OLD_C' +
        'OM_TELA'
      'RETURNING COM_COMPONENTE, COM_DESCRICAO, COM_TELA, COM_TIPO')
    DeleteSQL.Strings = (
      'DELETE FROM COMPONENTES'
      
        'WHERE COM_COMPONENTE = :OLD_COM_COMPONENTE AND COM_TELA = :OLD_C' +
        'OM_TELA')
    FetchRowSQL.Strings = (
      'SELECT COM_COMPONENTE, COM_DESCRICAO, COM_TELA, COM_TIPO'
      'FROM COMPONENTES'
      
        'WHERE COM_COMPONENTE = :OLD_COM_COMPONENTE AND COM_TELA = :OLD_C' +
        'OM_TELA')
    Left = 520
    Top = 104
  end
  object TBComponentes: TFDQuery
    Connection = FDConnection1
    Transaction = TRComponentes
    UpdateObject = UPComponentes
    SQL.Strings = (
      'select * from COMPONENTES'
      'order by COM_TELA, COM_COMPONENTE'
