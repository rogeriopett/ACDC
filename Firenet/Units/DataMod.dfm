        '  :NEW_MAN_CNPJ, :NEW_MAN_DESCRICAO, :NEW_MAN_DHEMISSAO, :NEW_MA' +
        'N_DHRECEBIMENTO, '
      
        '  :NEW_MAN_DTATUALIZACAO, :NEW_MAN_DTCONSULTA, :NEW_MAN_HRATUALI' +
        'ZACAO, '
      '  :NEW_MAN_HRCONSULTA, :NEW_MAN_IE, :NEW_MAN_JUSTIFICATIVA, '
      
        '  :NEW_MAN_NOME, :NEW_MAN_NSU, :NEW_MAN_PROTOCOLO, :NEW_MAN_SCHE' +
        'MA, '
      
        '  :NEW_MAN_SEQUENCIAEVENTO, :NEW_MAN_STATUSNOTA, :NEW_MAN_TIPOEV' +
        'ENTO, '
      '  :NEW_MAN_TIPONOTA, :NEW_MAN_USUARIO, :NEW_MAN_VALORNOTA, '
      '  :NEW_MAN_XML)'
      
        'RETURNING MAN_CHAVEACESSO, MAN_CIENCIA, MAN_CIENCIADH, MAN_CIENC' +
        'IAPROTOCOLO, MAN_CIENCIAPROTOCOLODH, MAN_CODIGO, MAN_CONCLUSAO, ' +
        'MAN_CONCLUSAODH, MAN_CONCLUSAOPROTOCOLO, MAN_CONCLUSAOPROTOCOLOD' +
        'H, MAN_CNPJ, MAN_DESCRICAO, MAN_DHEMISSAO, MAN_DHRECEBIMENTO, MA' +
        'N_DTATUALIZACAO, MAN_DTCONSULTA, MAN_HRATUALIZACAO, MAN_HRCONSUL' +
        'TA, MAN_IE, MAN_JUSTIFICATIVA, MAN_NOME, MAN_NSU, MAN_PROTOCOLO,' +
        ' MAN_SCHEMA, MAN_SEQUENCIAEVENTO, MAN_STATUSNOTA, MAN_TIPOEVENTO' +
        ', MAN_TIPONOTA, MAN_USUARIO, MAN_VALORNOTA, MAN_XML')
    ModifySQL.Strings = (
      'UPDATE MANIFESTACOES'
      
        'SET MAN_CHAVEACESSO = :NEW_MAN_CHAVEACESSO, MAN_CIENCIA = :NEW_M' +
        'AN_CIENCIA, '
      
        '  MAN_CIENCIADH = :NEW_MAN_CIENCIADH, MAN_CIENCIAPROTOCOLO = :NE' +
        'W_MAN_CIENCIAPROTOCOLO, '
      
        '  MAN_CIENCIAPROTOCOLODH = :NEW_MAN_CIENCIAPROTOCOLODH, MAN_CODI' +
        'GO = :NEW_MAN_CODIGO, '
      
        '  MAN_CONCLUSAO = :NEW_MAN_CONCLUSAO, MAN_CONCLUSAODH = :NEW_MAN' +
        '_CONCLUSAODH, '
      
        '  MAN_CONCLUSAOPROTOCOLO = :NEW_MAN_CONCLUSAOPROTOCOLO, MAN_CONC' +
        'LUSAOPROTOCOLODH = :NEW_MAN_CONCLUSAOPROTOCOLODH, '
      '  MAN_CNPJ = :NEW_MAN_CNPJ, MAN_DESCRICAO = :NEW_MAN_DESCRICAO, '
      
        '  MAN_DHEMISSAO = :NEW_MAN_DHEMISSAO, MAN_DHRECEBIMENTO = :NEW_M' +
        'AN_DHRECEBIMENTO, '
      
        '  MAN_DTATUALIZACAO = :NEW_MAN_DTATUALIZACAO, MAN_DTCONSULTA = :' +
        'NEW_MAN_DTCONSULTA, '
      
        '  MAN_HRATUALIZACAO = :NEW_MAN_HRATUALIZACAO, MAN_HRCONSULTA = :' +
        'NEW_MAN_HRCONSULTA, '
      
        '  MAN_IE = :NEW_MAN_IE, MAN_JUSTIFICATIVA = :NEW_MAN_JUSTIFICATI' +
        'VA, '
      
        '  MAN_NOME = :NEW_MAN_NOME, MAN_NSU = :NEW_MAN_NSU, MAN_PROTOCOL' +
        'O = :NEW_MAN_PROTOCOLO, '
      
        '  MAN_SCHEMA = :NEW_MAN_SCHEMA, MAN_SEQUENCIAEVENTO = :NEW_MAN_S' +
        'EQUENCIAEVENTO, '
      
        '  MAN_STATUSNOTA = :NEW_MAN_STATUSNOTA, MAN_TIPOEVENTO = :NEW_MA' +
        'N_TIPOEVENTO, '
      
        '  MAN_TIPONOTA = :NEW_MAN_TIPONOTA, MAN_USUARIO = :NEW_MAN_USUAR' +
        'IO, '
      '  MAN_VALORNOTA = :NEW_MAN_VALORNOTA, MAN_XML = :NEW_MAN_XML'
      'WHERE MAN_CODIGO = :OLD_MAN_CODIGO'
      
        'RETURNING MAN_CHAVEACESSO, MAN_CIENCIA, MAN_CIENCIADH, MAN_CIENC' +
        'IAPROTOCOLO, MAN_CIENCIAPROTOCOLODH, MAN_CODIGO, MAN_CONCLUSAO, ' +
