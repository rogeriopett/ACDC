        '_STATUS, '
      '  :NEW_FOR_TIPOPESSOA, :NEW_FOR_USUARIO)'
      
        'RETURNING FOR_AFE, FOR_ALVARA, FOR_ALVARASANITARIO, FOR_ATIVIDAD' +
        'E, FOR_BAIRRO, FOR_CEP, FOR_CIDADE, FOR_CIDADECODIGO, FOR_CNPJ, ' +
