    InsertSQL.Strings = (
      'INSERT INTO NFEINUTILIZADAS'
      '(NIN_ANO, NIN_CODIGO, NIN_DTATUALIZACAO, NIN_DTCADASTRO, '
      '  NIN_HRATUALIZACAO, NIN_HRCADASTRO, NIN_JUSTIFICATIVA, '
      '  NIN_MODELO, NIN_NUMFINAL, NIN_NUMINICIAL, '
      '  NIN_PROTOCOLO, NIN_PROTOCOLODH, NIN_SERIE, '
      '  NIN_USUARIO)'
      
        'VALUES (:NEW_NIN_ANO, gen_id(GEN_NFEINUTILIZADAS,1), :NEW_NIN_DT' +
        'ATUALIZACAO, :NEW_NIN_DTCADASTRO, '
      
        '  :NEW_NIN_HRATUALIZACAO, :NEW_NIN_HRCADASTRO, :NEW_NIN_JUSTIFIC' +
        'ATIVA, '
      '  :NEW_NIN_MODELO, :NEW_NIN_NUMFINAL, :NEW_NIN_NUMINICIAL, '
      '  :NEW_NIN_PROTOCOLO, :NEW_NIN_PROTOCOLODH, :NEW_NIN_SERIE, '
      '  :NEW_NIN_USUARIO)'
      
        'RETURNING NIN_ANO, NIN_CODIGO, NIN_DTATUALIZACAO, NIN_DTCADASTRO' +
        ', NIN_HRATUALIZACAO, NIN_HRCADASTRO, NIN_JUSTIFICATIVA, NIN_MODE' +
        'LO, NIN_NUMFINAL, NIN_NUMINICIAL, NIN_PROTOCOLO, NIN_PROTOCOLODH' +
        ', NIN_SERIE, NIN_USUARIO')
    ModifySQL.Strings = (
      'UPDATE NFEINUTILIZADAS'
      
        'SET NIN_ANO = :NEW_NIN_ANO, NIN_CODIGO = :NEW_NIN_CODIGO, NIN_DT' +
        'ATUALIZACAO = :NEW_NIN_DTATUALIZACAO, '
      
        '  NIN_DTCADASTRO = :NEW_NIN_DTCADASTRO, NIN_HRATUALIZACAO = :NEW' +
        '_NIN_HRATUALIZACAO, '
      
        '  NIN_HRCADASTRO = :NEW_NIN_HRCADASTRO, NIN_JUSTIFICATIVA = :NEW' +
        '_NIN_JUSTIFICATIVA, '
      
        '  NIN_MODELO = :NEW_NIN_MODELO, NIN_NUMFINAL = :NEW_NIN_NUMFINAL' +
        ', '
      
        '  NIN_NUMINICIAL = :NEW_NIN_NUMINICIAL, NIN_PROTOCOLO = :NEW_NIN' +
        '_PROTOCOLO, '
      
        '  NIN_PROTOCOLODH = :NEW_NIN_PROTOCOLODH, NIN_SERIE = :NEW_NIN_S' +
        'ERIE, '
      '  NIN_USUARIO = :NEW_NIN_USUARIO'
      'WHERE NIN_CODIGO = :OLD_NIN_CODIGO'
      
        'RETURNING NIN_ANO, NIN_CODIGO, NIN_DTATUALIZACAO, NIN_DTCADASTRO' +
        ', NIN_HRATUALIZACAO, NIN_HRCADASTRO, NIN_JUSTIFICATIVA, NIN_MODE' +
        'LO, NIN_NUMFINAL, NIN_NUMINICIAL, NIN_PROTOCOLO, NIN_PROTOCOLODH' +
        ', NIN_SERIE, NIN_USUARIO')
    DeleteSQL.Strings = (
      'DELETE FROM NFEINUTILIZADAS'
      'WHERE NIN_CODIGO = :OLD_NIN_CODIGO')
    FetchRowSQL.Strings = (
      
        'SELECT NIN_ANO, NIN_CODIGO, NIN_DTATUALIZACAO, NIN_DTCADASTRO, N' +
        'IN_HRATUALIZACAO, '
      '  NIN_HRCADASTRO, NIN_JUSTIFICATIVA, NIN_MODELO, NIN_NUMFINAL, '
      '  NIN_NUMINICIAL, NIN_PROTOCOLO, NIN_PROTOCOLODH, NIN_SERIE, '
      '  NIN_USUARIO'
      'FROM NFEINUTILIZADAS'
      'WHERE NIN_CODIGO = :OLD_NIN_CODIGO')
    Left = 904
    Top = 264
  end
