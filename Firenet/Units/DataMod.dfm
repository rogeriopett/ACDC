      '  NOI_VALORICMSSUBSTITUTO, NOI_VALORICMSUFDEST, '
      '  NOI_VALORICMSUFREMET, NOI_VALORII, NOI_VALORIOF, '
      '  NOI_VALORIPI, NOI_VALORISS, NOI_VALORISSDEDUCAO, '
