  object UPProdutos: TFDUpdateSQL
    Connection = DM.FDConnection1
    InsertSQL.Strings = (
      '')
    ModifySQL.Strings = (
      'UPDATE PRODUTOS'
      
        'SET PRO_ATUALIZAR = :NEW_PRO_ATUALIZAR, PRO_CODIGO = :NEW_PRO_CO' +
        'DIGO, '
      '  PRO_MARGEM = :NEW_PRO_MARGEM, PRO_MARGEM1 = :NEW_PRO_MARGEM1, '
      
        '  PRO_MARGEM2 = :NEW_PRO_MARGEM2, PRO_MARGEM3 = :NEW_PRO_MARGEM3' +
        ', '
      
        '  PRO_MARGEM4 = :NEW_PRO_MARGEM4, PRO_MARGEM5 = :NEW_PRO_MARGEM5' +
        ', '
      '  PRO_MARGEM6 = :NEW_PRO_MARGEM6, PRO_NOME = :NEW_PRO_NOME, '
      '  PRO_PRECO1 = :NEW_PRO_PRECO1, PRO_PRECO2 = :NEW_PRO_PRECO2, '
      '  PRO_PRECO3 = :NEW_PRO_PRECO3, PRO_PRECO4 = :NEW_PRO_PRECO4, '
      '  PRO_PRECO5 = :NEW_PRO_PRECO5, PRO_PRECO6 = :NEW_PRO_PRECO6, '
      
        '  PRO_PRECOVENDA = :NEW_PRO_PRECOVENDA, PRO_TABPRECO1 = :NEW_PRO' +
        '_TABPRECO1, '
      
        '  PRO_TABPRECO2 = :NEW_PRO_TABPRECO2, PRO_TABPRECO3 = :NEW_PRO_T' +
        'ABPRECO3, '
      
        '  PRO_TABPRECO4 = :NEW_PRO_TABPRECO4, PRO_TABPRECO5 = :NEW_PRO_T' +
        'ABPRECO5, '
      '  PRO_TABPRECO6 = :NEW_PRO_TABPRECO6'
      'WHERE PRO_CODIGO = :OLD_PRO_CODIGO'
      
        'RETURNING PRO_ATUALIZAR, PRO_CODIGO, PRO_MARGEM, PRO_MARGEM1, PR' +
        'O_MARGEM2, PRO_MARGEM3, PRO_MARGEM4, PRO_MARGEM5, PRO_MARGEM6, P' +
        'RO_NOME, PRO_PRECO1, PRO_PRECO2, PRO_PRECO3, PRO_PRECO4, PRO_PRE' +
        'CO5, PRO_PRECO6, PRO_PRECOVENDA, PRO_TABPRECO1, PRO_TABPRECO2, P' +
        'RO_TABPRECO3, PRO_TABPRECO4, PRO_TABPRECO5, PRO_TABPRECO6')
    DeleteSQL.Strings = (
      '')
    FetchRowSQL.Strings = (
      
        'SELECT PRO_ALIQCOFINS, PRO_ALIQCOFINSST, PRO_ALIQICMS, PRO_ALIQI' +
        'CMSADICST, '
      '  PRO_ALIQICMSRED, PRO_ALIQICMSST, PRO_ALIQIPI, PRO_ALIQISS, '
      '  PRO_ALIQOUTROS, PRO_ALIQPIS, PRO_ALIQPISST, PRO_ALTURA, '
      '  PRO_ATUALIZAR, PRO_ATUALIZATABELA, PRO_BENEFICIO, PRO_CEST, '
      
        '  PRO_CFOP, PRO_CFOPFORA, PRO_CLASSFISCAL, PRO_CODIGO, PRO_CODIG' +
        'OBARRAS, '
      
        '  PRO_CODIGOFAB, PRO_COMISSAO, PRO_COMPOEBASEICMS, PRO_COMPOEBAS' +
        'EICMSST, '
      '  PRO_COMPOSTO, PRO_CONVERSAO, PRO_CORSABOR, PRO_CSTCOFINS, '
      '  PRO_CSTICMS, PRO_CSTIPI, PRO_CSTPIS, PRO_CUBICO, PRO_DESCMAX, '
      
        '  PRO_DESCRICAO, PRO_DTATUALIZACAO, PRO_DTCADASTRO, PRO_DTULTCOM' +
        'PRA, '
      
        '  PRO_DTULTVENDA, PRO_ECFICMS, PRO_ENQUADRAMENTOIPI, PRO_ESTOQUE' +
        'ATUAL, '
      '  PRO_ESTOQUEMAX, PRO_ESTOQUEMIN, PRO_EXCECAO, PRO_FAMILIA, '
      
        '  PRO_FCI, PRO_FORNECEDOR, PRO_GENERO, PRO_GRUPO, PRO_HRATUALIZA' +
        'CAO, '
      
        '  PRO_HRCADASTRO, PRO_ICMSALIQUOTAPOR, PRO_INCENTIVOISS, PRO_IND' +
        'ICADORISS, '
      
        '  PRO_INTERNET, PRO_LARGURA, PRO_LOCALIZACAO, PRO_MARCA, PRO_MAR' +
        'GEM, '
      
        '  PRO_MARGEM1, PRO_MARGEM2, PRO_MARGEM3, PRO_MARGEM4, PRO_MARGEM' +
        '5, '
      '  PRO_MARGEM6, PRO_MARKUP, PRO_MARKUPCODIGO, PRO_MODICMS, '
      
        '  PRO_MODICMSST, PRO_NOME, PRO_OBSERVACOES, PRO_OFERTA, PRO_ORIG' +
        'EM, '
      
        '  PRO_PALAVRASCHAVE, PRO_PESAVEL, PRO_PESO, PRO_PRECO1, PRO_PREC' +
        'O2, '
      
        '  PRO_PRECO3, PRO_PRECO4, PRO_PRECO5, PRO_PRECO6, PRO_PRECOCUSTO' +
        ', '
      '  PRO_PRECOCUSTOCOMP, PRO_PRECOCUSTOMEDIO, PRO_PRECOCUSTOULT, '
      '  PRO_PRECOVENDA, PRO_PRECOVENDAMEDIO, PRO_PRECOVENDAULT, '
      
        '  PRO_PRODUCAO, PRO_PRODUTOREAL, PRO_PROFUNDIDADE, PRO_REGISTROM' +
        'S, '
      
        '  PRO_STATUS, PRO_SUBSTITUICAOTRIB, PRO_TABPRECO1, PRO_TABPRECO2' +
        ', '
      '  PRO_TABPRECO3, PRO_TABPRECO4, PRO_TABPRECO5, PRO_TABPRECO6, '
      
        '  PRO_TAMANHO, PRO_TIPO, PRO_TIPOISS, PRO_TIPOITEM, PRO_TOTALIZA' +
        'DORPARCIAL, '
      '  PRO_TRIBUTO, PRO_TROCA, PRO_UNIDADE, PRO_USUARIO'
      'FROM PRODUTOS'
      'WHERE PRO_CODIGO = :OLD_PRO_CODIGO')
    Left = 152
    Top = 160
  end
